---
import { Picture } from "astro:assets";
import ScrollPhoto from "../../components/ScrollPhoto.astro";
import deepguideGear from "../../assets/images/deepguide_gear.jpg";
import deepguideHero from "../../assets/images/deepguide_hero.jpg";
import deepguideLightsout from "../../assets/images/deepguide_lightsout.jpg";
import { DEEP_RESERVE_LABEL, PROX_DEEP_RESERVE_URL } from "../../config/nav";
import PageLayout from "../../layouts/PageLayout.astro";

// 来る前に知っておくこと。このページの下の節にある事実だけから取った要点（新しい事実は足さない）。
const beforeYouCome = [
	"18歳以上のみ、1グループ3名までのフィールドです。入場時に年齢確認書類を見せてください。",
	"受付はライトフォレストです（チェックイン 12:00〜17:00）。場所は受付で案内します。ライトフォレストから車で約7分です。",
	"灯りのない森です。設営に慣れていない方は日没の2時間前、慣れている方でも1時間前を目安に受付へお越しください。",
	"テントのレンタルはご利用いただけません。",
	"水道はありません。飲み水はライトフォレストで汲んでから向かってください。",
	"ゴミはすべて持ち帰りです。灰は入れ物（火消し壺・灰入れバケツ・袋など）に入れて持ち帰り、ライトフォレストの灰捨て場へ。",
	"日没後は車を動かせません。お風呂や買い物は日没前に済ませてください。",
	"22:00に消灯です。",
];

// 利用規定・基本情報。/deep/ から移設（このページを正本とする）。
// 下の節に詳しい説明がある条件は、ここでは短く書いてその節へリンクする（同じ説明を2回書かない）。
const specs = [
	{ label: "利用制限", value: "18歳以上のみ（入場時に年齢確認書類を提示）" },
	{ label: "定員", value: "1〜3名（4名以上のグループ利用は不可）" },
	{ label: "区画指定", value: "なし。事前の区画指定は行いません。" },
	{
		label: "チェックイン",
		value: "12:00〜17:00（ライトフォレストの受付）",
	},
	{
		label: "チェックアウト",
		value: "6:00〜12:00。空きがあれば無料で延長できます。",
		href: "#checkout",
		linkText: "チェックアウト・延長",
	},
	{
		label: "直火・焚き火",
		value: "可",
		href: "#facility",
		linkText: "設備・スペック",
	},
	{
		label: "灰",
		value: "ご自身で持ち帰り",
		href: "#facility",
		linkText: "設備・スペック",
	},
	{
		label: "ゴミ",
		value: "全て持ち帰り",
		href: "#facility",
		linkText: "設備・スペック",
	},
	{ label: "発電機・スピーカー", value: "禁止" },
	{
		label: "場所",
		value: "非公開。受付にて案内（ライトフォレストから車で約7分の、別の尾根）",
	},
];

const facilities = [
  { label: "トイレ",    value: "仮設トイレのみ（洋式便座設置済み）。紙がない・水が出ないなどお気づきの点があればご一報ください。", avail: true  },
  { label: "水道・洗い場", value: "なし（洗い場不設置）。飲料水はライトフォレストで調達してください。",                  avail: false },
  { label: "直火・焚き火", value: "可。直火をする方は受付で直火の案内を受けてください。落葉・落枝はご自由にお使いください。木についている枯れ枝や積んである丸太は燃やさないでください。こぼした炭は拾ってください。", avail: true  },
  { label: "灰",        value: "灰はご自身で持ち帰ってください（ディープに灰捨て場はありません）。灰を入れて運べる入れ物（火消し壺・灰入れバケツ・袋など）をお持ちください。お持ちでない方は受付でレンタルできます（500円）。", avail: false },
  { label: "ハンモック", value: "可。ディープこそ、ハンモックの似合うフィールドはありません。",                         avail: true  },
  { label: "携帯電波",  value: "広場周辺はauが問題なし、ドコモ・ソフトバンクはやや弱め。山のテン場は3社とも入ります。楽天モバイルは全域で圏外です。", avail: true  },
  { label: "AC電源",   value: "なし。発電機の持ち込み・使用禁止。",                                                    avail: false },
  { label: "駐車場",    value: "1予約につき1台まで広場駐車可（先着計4台）。必ず枠の中に駐車してください。以降は下駐車場を利用。", avail: true  },
  { label: "売店",      value: "なし（受付はライトフォレスト）。薪の持ち込み可。",                               avail: false },
  { label: "ゴミ",      value: "ゴミ・炭・薪の燃え残りなどは全て持ち帰り。灰のみライトフォレストの灰捨て場の黒ペール缶（要蓋閉め）で引き取り可（肥料にしてリサイクルしているため、蚊取線香・アルミ類・ゴミカスは入れないでください）。", avail: false },
  { label: "ペット",    value: "同伴可。リード装着・ふんの後始末・周囲のお客さまとトラブルにならないよう、各自で管理してください。", avail: true  },
  { label: "管理人・連絡先", value: "管理人は常駐しませんが、必要に応じてパトロールし、お声がけしています。なにかあればすぐご連絡ください。おいらの森：050-3647-1047（9:00〜17:30）。夜間にけがや事故、急な病気があった場合は、消防・救急にすぐ連絡し、おいらにもご一報ください。夜間の連絡先は、受付とポータルでお知らせしています。", avail: true  },
];
---

<style is:global>
  /* ディープフォレスト利用案内ページ専用：ダーク基調 */
  body { background-color: #111914; }
</style>

<PageLayout
  title="ディープフォレスト 利用案内 | 里山パークおいらの森"
  description="ディープフォレストの利用案内。18歳以上限定フィールドのチェックイン時間・場内設備・禁止事項・基本4鉄則を、来場前に確認してください。"
  lastUpdated="2026年11月"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": "ディープフォレスト 利用案内 | 里山パークおいらの森",
      "description": "ディープフォレストの利用案内。18歳以上限定フィールドのチェックイン時間・場内設備・禁止事項・基本4鉄則を、来場前に確認してください。",
      "url": "https://oiranomori.jp/deep-guide/",
      "isPartOf": {
        "@type": "WebSite",
        "name": "里山パークおいらの森",
        "url": "https://oiranomori.jp"
      }
    })} />
  </Fragment>

  {/* ヒーロー。写真選定後は Picture（full-bleed / widths 明示）へ置き換える。
      枠の段階から同じ寸法を確保し、差し替え時に CLS を起こさない。 */}
  <Picture
    src={deepguideHero}
    formats={["avif", "webp"]}
    alt="下草の中に踏み跡がのびる、樹齢80年以上のスギ・ヒノキの林"
    loading="eager"
    fetchpriority="high"
    widths={[768, 1280, 1920, 2560]}
    sizes="100vw"
    class="full-bleed mb-10 object-cover aspect-[16/9] sm:aspect-[2.6/1]"
  />

  {/* ページ見出し */}
  <div class="mb-10 border-b border-zinc-700 pb-8">
    <p class="text-xs tracking-[0.26em] text-zinc-500 uppercase">Deep Forest</p>
    <h1 class="mt-3 text-3xl font-semibold text-white md:text-4xl">ディープフォレスト<br class="sm:hidden" /> 利用案内</h1>

    <p class="mt-5 max-w-2xl text-base leading-loose text-zinc-300">
      ここはいわゆるキャンプ場じゃない。おいらが林業をしている森だ。<br />
      その現場を、深い森を味わいたい人のために開放している。
    </p>
    <p class="mt-4 max-w-2xl text-base leading-loose text-zinc-400">
      だから、看板もないし、設備もない。地図にも載っていないし、場所は非公開。<br />
      ときどきおいらがチェーンソーや刈払機を持って作業していることがある。でも、めったにない。
    </p>
    <p class="mt-4 max-w-2xl text-base leading-loose text-zinc-400">
      細かいことは言うつもりはない。ただ、おいらの森だから、傷つけたりゴミを捨てたりはしないでほしい。
    </p>

    <p class="mt-5 max-w-2xl text-base leading-loose text-zinc-400">
      樹齢80年以上のスギ・ヒノキが立ち並ぶ深い針葉樹林。直火、ブッシュクラフト、圧倒的な静寂。<br />
      整備された快適さよりも、自然との真剣な対話を求める方のためのフィールドです。
    </p>

    <nav class="mt-6 flex flex-wrap gap-3 text-sm">
      {[
        { href: "#specs",      label: "利用規定・基本情報" },
        { href: "#checkin",    label: "チェックイン" },
        { href: "#checkout",   label: "チェックアウト" },
        { href: "#facility",   label: "設備・スペック" },
        { href: "#rules",      label: "禁止事項" },
        { href: "#principles", label: "基本4鉄則" },
      ].map((item) => (
        <a
          href={item.href}
          class="rounded-full border border-zinc-700 px-4 py-1.5 text-zinc-500 transition hover:border-zinc-500 hover:text-zinc-200"
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>

  {/* 来る前に知っておくこと。短い要点だけ。詳しい説明は下の各節 */}
  <section id="before" class="mb-14 border-l-2 border-zinc-600 pl-5">
    <h2 class="text-xl font-semibold text-white">来る前に知っておくこと</h2>
    <ul class="mt-4 space-y-2 text-sm leading-loose text-zinc-300">
      {beforeYouCome.map((t) => (
        <li class="flex items-start gap-2">
          <span class="mt-3 h-1 w-1 shrink-0 rounded-full bg-zinc-500"></span>
          <span>{t}</span>
        </li>
      ))}
    </ul>
  </section>

  {/* 利用規定・基本情報。/deep/ から移設し、このページを正本とする。 */}
  <section id="specs" class="mb-14">
    <h2 class="mb-5 text-xl font-semibold text-white">利用規定・基本情報</h2>
    <dl class="divide-y divide-zinc-800 border-y border-zinc-700 text-sm">
      {specs.map((item) => (
        <div class="grid grid-cols-[9rem_1fr] gap-4 py-4 sm:grid-cols-[12rem_1fr]">
          <dt class="text-zinc-500">{item.label}</dt>
          <dd class="text-zinc-300">
            {item.value}
            {item.href && (
              <a href={item.href} class="ml-2 text-xs text-zinc-400 underline underline-offset-2 transition hover:text-zinc-200">
                {item.linkText} →
              </a>
            )}
          </dd>
        </div>
      ))}
    </dl>
    <p class="mt-4 text-sm">
      <a
        href="/stay-deep/"
        class="text-zinc-400 underline underline-offset-2 transition hover:text-zinc-200"
        data-cta="deep-guide-to-stay-deep"
        data-cta-target="/stay-deep/"
      >
        入場から撤収までの流れは「ディープフォレストで過ごす一泊」へ →
      </a>
    </p>
  </section>

  {/* チェックイン */}
  <section id="checkin" class="mb-14">
    <h2 class="mb-5 text-xl font-semibold text-white">チェックイン</h2>
    {/* サイトインの流れは App のポータル（public_app/checkin/index.php）・/app/s/DEEP の文に揃える（App spec_camp §6-6・§6-11、2026-11-21）。
        ディープのサイトインはテントを張った場所の［ここをキャンプ地とする］1つ。QR は読まない。 */}
    <p class="text-sm leading-loose text-zinc-300">
      受付はライトフォレストです。受付のあと、ディープフォレストへ移動し、テントを張った場所でサイトインします。
    </p>
    <ol class="mt-5 divide-y divide-zinc-800 border-y border-zinc-700 text-sm">
      {[
        { title: "受付", body: "現地払いのご予約は、受付でご精算いただきます。事前決済のご予約は、受付でスマートフォンをカードにかざします。ディープフォレストの場所と利用方法、ポータルサイトについてご案内します。受付には、スマートフォンをお持ちください。" },
        { title: "ディープフォレストへ", body: "受付から車で約7分です。" },
        { title: "サイトイン", body: "テントを張った場所で、ポータルサイトの［ここをキャンプ地とする］を押すと、サイトインできます。押すと、サイトインと同時に、張った場所（おおよその位置）と時刻が受付に届きます。" },
      ].map((step, i) => (
        <li class="grid grid-cols-[2rem_1fr] gap-4 py-5">
          <span class="font-semibold tabular-nums text-zinc-500">{i + 1}</span>
          <div>
            <h3 class="font-semibold text-white">{step.title}</h3>
            <p class="mt-2 leading-loose text-zinc-300">{step.body}</p>
          </div>
        </li>
      ))}
    </ol>
    <p class="mt-5 text-sm leading-loose text-zinc-300">
      ポータルサイトは、ご予約のお礼のメールと、ご来場の前日のメールにあるリンクから開きます。メールが見つからないときは、受付でカードにスマートフォンをかざすか、QR コードを読むと開けます。
    </p>
    <p class="mt-3 text-sm leading-loose text-zinc-300">
      年間パスポートのご予約で、現地でのお支払いが無いときは、受付に寄らずにディープフォレストへ直接お越しください。テントを張った場所で［ここをキャンプ地とする］を押すと、サイトインできます。
    </p>
    <div class="mt-6 border-l-2 border-zinc-600 pl-5">
      <h3 class="text-sm font-semibold text-white">到着の目安</h3>
      <p class="mt-2 text-sm leading-loose text-zinc-400">
        ディープフォレストは灯りのない森です。設営を明るいうちに終えられるよう、設営に慣れていない方は日没の2時間前、慣れている方でも1時間前を目安に受付へお越しください。
      </p>
      <p class="mt-2 text-sm leading-loose text-zinc-400">
        初めての方で、目安の時刻を過ぎてからのご到着の場合は、ライトフォレストのオートサイトへご案内することがあります。
      </p>
      <p class="mt-2 text-sm leading-loose text-zinc-400">
        ディープフォレストでは、テントのレンタルはご利用いただけません。
      </p>
    </div>
    <dl class="mt-6 divide-y divide-zinc-800 border-y border-zinc-700 text-sm">
      {[
        { label: "アーリーチェックイン", value: "アーリーチェックインは無料です。サイトの空き状況によりますが、9時からご利用いただけます。アーリーチェックインご希望の方は、ご予約の際に到着予定時刻を12時より前にしてください。前日の夕方に、ポータルとメールでアーリーチェックインの可否をお知らせします。" },
        { label: "チェックインリミット", value: "17:00（厳守）。超過時は入場不可。連絡なき場合は無断キャンセル扱いとし、キャンセル料を請求します。遅れる場合は必ず連絡してください。" },
        { label: "入出場",              value: "日中の入出場は自由です。日没以降は車を動かせません。お風呂や買い物は日没前に済ませてください。", href: "#vehicles", linkText: "車両乗り入れについて" },
      ].map((item) => (
        <div class="grid grid-cols-[10rem_1fr] gap-4 py-5 sm:grid-cols-[14rem_1fr]">
          <dt class="text-zinc-500">{item.label}</dt>
          <dd class="text-zinc-300">
            {item.value}
            {item.href && (
              <a href={item.href} class="ml-2 text-xs text-zinc-400 underline underline-offset-2 transition hover:text-zinc-200">
                {item.linkText} →
              </a>
            )}
          </dd>
        </div>
      ))}
    </dl>
  </section>

  {/* チェックアウト */}
  <section id="checkout" class="mb-14">
    <h2 class="mb-5 text-xl font-semibold text-white">チェックアウト・延長</h2>
    <p class="text-sm leading-loose text-zinc-300">
      チェックアウトは6:00〜12:00です。ポータルサイトから行えるため、受付に寄る必要はありません。
    </p>
    <dl class="mt-5 divide-y divide-zinc-800 border-y border-zinc-700 text-sm">
      {[
        { label: "レンタル品の返却",   value: "薪袋・バケツ等はライトフォレストへ返却してください。" },
        { label: "チェックアウト延長", value: "エリアに余裕がある場合に限り、17:00まで（日没が早い時期は日没まで）無料で滞在可能です。12:00前までにお知らせください。ライトフォレストとルールが異なるため混同しないよう注意してください。" },
      ].map((item) => (
        <div class="grid grid-cols-[10rem_1fr] gap-4 py-5 sm:grid-cols-[14rem_1fr]">
          <dt class="text-zinc-500">{item.label}</dt>
          <dd class="text-zinc-300">{item.value}</dd>
        </div>
      ))}
    </dl>
  </section>

  {/* 消灯 */}
  <section class="mb-14">
    <h2 class="mb-5 text-xl font-semibold text-white">消灯</h2>
    <p class="border-y border-zinc-700 py-5 text-sm text-zinc-300">22:00 消灯。消灯後はテントの外のランタンを消し、おしゃべりせずにお過ごしください。</p>
    <ScrollPhoto class="mt-6" ratio="16/9" src={deepguideLightsout} alt="消灯後、杉の梢の上に月が浮かぶディープフォレストの夜空" />
  </section>

  {/* 設備・スペック */}
  <section id="facility" class="mb-14">
    <h2 class="mb-2 text-xl font-semibold text-white">設備・スペック</h2>
    <p class="mb-5 text-sm text-zinc-500">
      ディープフォレストの設備は意図的に最小限にとどめています。自然の中で完結する準備を整えてお越しください。
    </p>
    <dl class="divide-y divide-zinc-800 border-y border-zinc-700 text-sm">
      {facilities.map((item) => (
        <div class="grid grid-cols-[9rem_1fr] gap-4 py-4 sm:grid-cols-[12rem_1fr]">
          <dt class="flex items-center gap-2 text-zinc-500">
            <span
              class={`h-1.5 w-1.5 rounded-full shrink-0 ${item.avail ? "bg-[color:var(--light-accent)]" : "bg-zinc-700"}`}
            ></span>
            {item.label}
          </dt>
          <dd class="text-zinc-300">{item.value}</dd>
        </div>
      ))}
    </dl>

    {/* 日没後の車の決まりの詳しい説明はここ1か所（チェックインの「入出場」からリンク） */}
    <div id="vehicles" class="mt-6 border-l-2 border-zinc-600 pl-5">
      <p class="text-sm font-semibold text-white">車両乗り入れについて</p>
      <p class="mt-2 text-sm leading-loose text-zinc-400">
        日没以降の広場への車両乗り入れ、車の移動、エンジン始動は禁止です。ドアの開け閉めや音の鳴るドアロックも極力控えてください。
        ヘッドライトは点灯せず、オートライトはOFFに。懐中電灯や明るいランタンで他のサイトや森を照らさないでください。
        場内は徐行でお願いします。広場から先は車両進入禁止。
        車両進入禁止の看板を越えた場所での事故やスタックは、救助費用・現場修繕費用など実費（3〜5万円程度）を請求いたします。
      </p>
    </div>
  </section>

  {/* 禁止事項 */}
  <section id="rules" class="mb-14">
    <h2 class="mb-5 text-xl font-semibold text-white">禁止事項（厳守）</h2>

    <div class="grid gap-5 sm:grid-cols-2">
      {[
        {
          category: "音の制限",
          items: [
            "スピーカー、大きな音の出る行為",
            "大声での宴会、他のサイトに聞こえる談笑",
            "車両のアイドリング",
            "発電機",
            "打ち上げ花火",
          ],
        },
        {
          category: "設営・作業",
          items: [
            "バトニング（薪割り）",
            "焚火のための穴掘り",
          ],
        },
        {
          category: "夜間行動",
          items: [
            "肝試し",
            "日没後の薪拾い",
            "目的のない「お散歩」",
          ],
        },
        {
          category: "環境破壊",
          items: [
            "樹木の損傷",
            "不法投棄",
            "ペール缶へのゴミの投入",
          ],
        },
        {
          category: "違法行為（状況により退場・出入禁止・警察へ通報）",
          items: [
            "木を折ったり傷をつける（器物損壊）",
            "立入禁止区域に入る（不法侵入）",
            "森にあるものを持ち帰る（窃盗）",
            "燃えカスの投棄やゴミの放置（不法投棄）",
          ],
        },
      ].map((section) => (
        <div class="border-t border-zinc-700 pt-5">
          <p class="mb-3 font-semibold text-zinc-300">{section.category}</p>
          <ul class="space-y-2">
            {section.items.map((item) => (
              <li class="flex items-start gap-2 text-sm leading-snug text-zinc-500">
                <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-zinc-600"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  {/* 基本4鉄則 */}
  <section id="principles" class="mb-14">
    <h2 class="mb-5 text-xl font-semibold text-white">この森の基本4鉄則</h2>
    <p class="mb-6 text-sm text-zinc-500">利用者が守るべき、この森の精神的基盤です。</p>

    <div class="divide-y divide-zinc-800 border-y border-zinc-700">
      {[
        "森の静寂と闇夜、自然の音を楽しむこと。",
        "現地で使用可能なものは「落葉・落枝」のみ。",
        "利用後は現状回復し、足跡以外の痕跡を残さないこと。",
        "野グソ禁止。トイレ以外での排泄は厳禁。",
      ].map((rule, i) => (
        <div class="grid grid-cols-[2rem_1fr] gap-4 py-5 text-sm">
          <p class="text-lg font-semibold text-zinc-700">{i + 1}</p>
          <p class="text-zinc-300">{rule}</p>
        </div>
      ))}
    </div>
  </section>

  {/* 装備と過ごし方のヒント */}
  <section class="mb-14">
    <h2 class="mb-5 text-xl font-semibold text-white">装備と過ごし方のヒント</h2>

    <ul class="divide-y divide-zinc-800 border-y border-zinc-700">
      {[
        { title: "装備で完結する準備を",  desc: "ここで揃えられるものは限られます。下見しておくと安心です。" },
        { title: "管理人は常駐しません",  desc: "困ったときの連絡先は、", linkHref: "#facility", linkText: "設備・スペックの「管理人・連絡先」へ" },
        { title: "静かに過ごす場所",      desc: "賑やかに過ごしたい日は、", linkHref: "/", linkText: "ライトフォレストへ", cta: "deep-to-light" },
        { title: "足元の備え",            desc: "雨後はぬかるみやすいので、長靴の携行を推奨します。" },
        { title: "装備の運び方",          desc: "広場から先は傾斜があるため、キャリーカーは使いにくい場所です。大容量のバックパックをお持ちになるか、何度か往復して運んでください。" },
      ].map((item) => (
        <li class="py-4 text-sm">
          <span class="font-semibold text-zinc-300">・{item.title}：</span>
          <span class="text-zinc-500">
            {item.desc}
            {item.linkHref && (
              <a
                href={item.linkHref}
                class="underline underline-offset-2 text-zinc-400 transition hover:text-zinc-200"
                data-cta={item.cta}
              >{item.linkText} →</a>
            )}
          </span>
        </li>
      ))}
    </ul>

    <ScrollPhoto class="mt-6" ratio="16/9" src={deepguideGear} alt="夜のスギ林に、灯りのともったテントが小さく浮かぶ野営地" />

    <p class="mt-4 text-sm">
      <a
        href="/stay-deep/"
        class="text-zinc-400 underline underline-offset-2 transition hover:text-zinc-200"
        data-cta="deep-guide-to-stay-deep"
        data-cta-target="/stay-deep/"
      >
        一泊の過ごし方を時間順に見る（ディープフォレストで過ごす一泊）→
      </a>
    </p>
  </section>

  {/* 場内マップの項はここに置く（動く地図を入れる・spec §10.4）。地図が入るまでは項ごと置かない */}

  {/* 予約CTA */}
  <div class="mt-12 border border-zinc-700 bg-[color:var(--forest-700)] px-8 py-10 text-center">
    <p class="text-sm text-zinc-500">ご予約・詳細料金の確認</p>
    <p class="mt-2 text-xl font-semibold text-white">予約は当方の予約システムから</p>
    <p class="mt-3 text-sm leading-loose text-zinc-400">
      会員登録で複数プラン・複数日程の同時予約が可能です。
    </p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <a
        href={PROX_DEEP_RESERVE_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center rounded-full px-8 py-3 text-sm font-semibold shadow-sm transition hover:opacity-90"
        style="background:var(--light-accent);color:var(--light-accent-text);"
        data-cta="reserve"
        data-cta-field="deep"
      >
        {DEEP_RESERVE_LABEL} ↗
      </a>
      <a
        href="/reservation-guide/"
        class="inline-flex items-center justify-center rounded-full border border-zinc-600 px-8 py-3 text-sm text-zinc-400 transition hover:border-zinc-400 hover:text-zinc-200"
      >
        予約ガイドを見る
      </a>
      <a
        href="/stay-deep/"
        class="inline-flex items-center justify-center rounded-full border border-zinc-600 px-8 py-3 text-sm text-zinc-400 transition hover:border-zinc-400 hover:text-zinc-200"
        data-cta="deep-guide-to-stay-deep"
        data-cta-target="/stay-deep/"
      >
        ディープフォレストで過ごす一泊
      </a>
    </div>
  </div>

</PageLayout>
