---
import PageLayout from "../../layouts/PageLayout.astro";

import {
	PROX_BOOKING_LOOKUP_URL,
	PROX_MEMBER_LOGIN_URL,
	PROX_MEMBER_SIGNUP_URL,
	PROX_SEARCH_URL,
	RAKUTEN_CAMP_URL,
} from "../../config/nav";

// 予約の主導線。補助導線（会員登録・ログイン・予約確認）は別定数。
const proXPlanlist = PROX_SEARCH_URL;

const steps = [
  {
    no: "2",
    title: "プランを選択",
    desc: "プランページから、ご希望のプランと日程を選択します。",
  },
  {
    no: "3",
    title: "買い物カゴに追加",
    desc: "複数のプランや日程を買い物カゴに入れて、まとめて予約手続きができます。グループでの別々予約や長期滞在も1回の手続きで完了します。",
  },
  {
    no: "4",
    title: "現地で支払う",
    desc: "現地決済のみ（事前のオンライン決済はありません）。当日、受付または注文時にお支払いください。クレジットカード・電子マネー・QRコード決済・現金が使えます。",
  },
  {
    no: "5",
    title: "前日リマインドメール",
    desc: "ご来場前日に、チェックイン方法や周辺の買い出し情報をまとめたリマインドメールをお送りします。チェックイン・チェックアウトに必要な予約番号コードが記載されていますので、必ず受信をご確認ください。",
  },
];
---

<PageLayout
  title="予約ガイド | 里山パークおいらの森"
  description="はじめての方向け予約ガイド。オンライン予約の手順・会員登録のメリット・キャンセルポリシーをわかりやすく解説しています。"
  lastUpdated="2026年9月"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebPage",
          "name": "予約ガイド | 里山パークおいらの森",
          "description": "はじめての方向け予約ガイド。オンライン予約の手順・会員登録のメリット・キャンセルポリシーをわかりやすく解説しています。",
          "url": "https://oiranomori.jp/reservation-guide/",
          "isPartOf": {
            "@type": "WebSite",
            "name": "里山パークおいらの森",
            "url": "https://oiranomori.jp"
          }
        },
        {
          "@type": "HowTo",
          "name": "里山パークおいらの森の予約手順",
          "description": "おいらの森公式予約サイトを使ったオンライン予約の手順です。",
          "step": [
            {
              "@type": "HowToStep",
              "position": 1,
              "name": "公式予約サイトへアクセス",
              "text": "「予約する」ボタンを押して、おいらの森公式予約サイトにアクセスしてください。"
            },
            {
              "@type": "HowToStep",
              "position": 2,
              "name": "プランを選択",
              "text": "プランページから、ご希望のプランと日程を選択します。"
            },
            {
              "@type": "HowToStep",
              "position": 3,
              "name": "買い物カゴに追加",
              "text": "複数のプランや日程を買い物カゴに入れて、まとめて予約手続きができます。"
            },
            {
              "@type": "HowToStep",
              "position": 4,
              "name": "現地で支払う",
              "text": "決済は現地決済のみです。事前のオンライン決済はありません。当日、クレジットカード・電子マネー・QRコード決済・現金に対応しています。"
            },
            {
              "@type": "HowToStep",
              "position": 5,
              "name": "前日リマインドメールを受信",
              "text": "ご来場前日に、チェックイン方法や周辺の買い出し情報をまとめたリマインドメールをお送りします。予約番号コードが記載されていますので、必ず受信をご確認ください。"
            }
          ]
        }
      ]
    })} />
  </Fragment>

  <div class="mb-10 border-b border-zinc-200 pb-8">
    <p class="text-xs tracking-[0.26em] text-zinc-400 uppercase">Reservation Guide</p>
    <h1 class="mt-3 text-3xl font-semibold text-zinc-800 md:text-4xl">予約ガイド</h1>
    <p class="mt-4 max-w-2xl text-base leading-loose text-zinc-600">
      おいらの森は公式予約サイトを通じてネット予約を受け付けています。
      会員登録をすると、宿泊実績やポイントを次回以降のご利用にあてられます。
    </p>
    <nav class="mt-6 flex flex-wrap gap-3 text-sm">
      {[
        { href: "#change", label: "キャンセル・変更のやり方", accent: true },
        { href: "#account", label: "ログイン・予約確認" },
        { href: "#steps",  label: "予約の手順" },
        { href: "#price",  label: "料金の決まり方" },
        { href: "#phone",  label: "電話予約について" },
        { href: "#merit",  label: "公式予約のメリット" },
        { href: "#member", label: "会員制度・ポイント" },
        { href: "#online", label: "ネット予約の特徴" },
        { href: "#rakuten", label: "楽天トラベルキャンプ" },
      ].map((item) => (
        <a
          href={item.href}
          class={item.accent
            ? "rounded-full border border-[color:var(--light-accent)] bg-[color:var(--light-accent)] px-4 py-1.5 text-white transition hover:opacity-90"
            : "rounded-full border border-zinc-300 px-4 py-1.5 text-zinc-600 transition hover:border-zinc-500 hover:text-zinc-800"}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>

  {/* 会員の方・予約を確認したい方（会員/予約確認のハブ） */}
  <section id="account" class="mb-16 scroll-mt-24 border-t border-zinc-300 pt-10">
    <p class="text-xs tracking-[0.2em] text-zinc-400">
      <span class="text-[color:var(--light-accent)]">01</span>
      <span class="ml-2">ログイン・予約確認</span>
    </p>
    <h2 class="mt-2 mb-5 text-xl font-semibold text-zinc-800">会員の方・予約を確認したい方</h2>
    <div class="flex flex-wrap gap-3">
      <a
        href={PROX_MEMBER_SIGNUP_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center rounded-full bg-[color:var(--forest-600)] px-6 py-2.5 text-sm text-white shadow-sm transition hover:bg-[color:var(--forest-700)]"
      >
        新規会員登録 ↗
      </a>
      <a
        href={PROX_MEMBER_LOGIN_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center rounded-full border border-zinc-400 px-6 py-2.5 text-sm text-zinc-700 transition hover:border-zinc-600"
      >
        ログイン ↗
      </a>
      <a
        href={PROX_BOOKING_LOOKUP_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center rounded-full border border-zinc-400 px-6 py-2.5 text-sm text-zinc-700 transition hover:border-zinc-600"
      >
        予約確認（マイページ） ↗
      </a>
    </div>
  </section>

  {/* 予約の基本ステップ */}
  <section id="steps" class="mb-16 scroll-mt-24 border-t border-zinc-300 pt-10">
    <p class="text-xs tracking-[0.2em] text-zinc-400">
      <span class="text-[color:var(--light-accent)]">02</span>
      <span class="ml-2">予約の手順</span>
    </p>
    <h2 class="mt-2 mb-5 text-xl font-semibold text-zinc-800">予約の基本ステップ</h2>

    <div class="divide-y divide-zinc-100 border-y border-zinc-200">

      {/* STEP 1 — 特殊レンダリング */}
      <div class="grid grid-cols-[2.5rem_1fr] gap-4 py-6">
        <p class="text-2xl font-semibold text-zinc-200 leading-none">1</p>
        <div>
          <p class="font-semibold text-zinc-800">おいらの森公式予約サイト</p>
          <p class="mt-2 text-sm leading-loose text-zinc-600">
            <a href={proXPlanlist}
              target="_blank"
              rel="noopener noreferrer"
              class="underline underline-offset-2 text-[color:var(--light-accent)] transition hover:opacity-80"
             data-cta="reserve" data-cta-field="light">予約する</a>ボタンを押してください
          </p>
          <div class="mt-3 border-l-2 border-zinc-200 pl-4 text-xs leading-loose text-zinc-500">
            <p class="font-medium text-zinc-600">※会員登録・ログイン</p>
            <p>
              公式予約ページにて会員登録を行い、ログイン状態で予約すると特典があります。
              <a href="#member" class="ml-1 underline underline-offset-2 text-zinc-600 transition hover:text-zinc-900">会員について →</a>
            </p>
          </div>
        </div>
      </div>

      {/* STEPs 2–5 */}
      {steps.map((step) => (
        <div class="grid grid-cols-[2.5rem_1fr] gap-4 py-6">
          <p class="text-2xl font-semibold text-zinc-200 leading-none">{step.no}</p>
          <div>
            <p class="font-semibold text-zinc-800">{step.title}</p>
            <p class="mt-2 text-sm leading-loose text-zinc-600">{step.desc}</p>
          </div>
        </div>
      ))}

    </div>

    <div class="mt-6 border-l-4 border-[color:var(--light-accent)] pl-5">
      <p class="text-sm font-semibold text-zinc-700">アーリーチェックインは無料です</p>
      <p class="mt-1 text-sm leading-loose text-zinc-600">
        サイトの空き状況によりますが、9時からご利用いただけます。繁忙期は対応できない場合があるため、<strong>前日夕方</strong>までにご確認ください。
      </p>
    </div>

    <div class="mt-6">
      <a href={proXPlanlist}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center rounded-full bg-[color:var(--forest-600)] px-8 py-3 text-sm text-white shadow-sm transition hover:bg-[color:var(--forest-700)]"
       data-cta="reserve" data-cta-field="light">
        予約ページへ ↗
      </a>
    </div>
  </section>

  {/* 料金の仕組み。/sites/ から詳細を移設し、ここを正本とする。 */}
  <section id="price" class="mb-16 scroll-mt-24 border-t border-zinc-300 pt-10">
    <p class="text-xs tracking-[0.2em] text-zinc-400">
      <span class="text-[color:var(--light-accent)]">03</span>
      <span class="ml-2">料金</span>
    </p>
    <h2 class="mt-2 mb-5 text-xl font-semibold text-zinc-800">料金の決まり方</h2>
    <p class="mb-5 max-w-2xl text-sm leading-loose text-zinc-600">
      宿泊料金は、利用人数に応じた料金と、日付・サイトサイズによって変わるサイト料金を合計して計算します。
      オートサイトのサイト料金には車1台分が含まれ、2台目以降は追加車両料金がかかります。AC電源などを利用する場合は、オプション料金が加わります。
    </p>

    <p class="border-y border-zinc-200 py-5 text-sm leading-loose text-zinc-700">
      人数料金　＋　日付・サイズ別のサイト料金　＋　追加車両・電源等のオプション
    </p>

    <dl class="mt-8 divide-y divide-zinc-100 border-y border-zinc-200 text-sm">
      <div class="grid grid-cols-[10rem_1fr] gap-4 py-5 sm:grid-cols-[14rem_1fr]">
        <dt class="text-zinc-500">追加車両</dt>
        <dd class="text-zinc-700">2台目以降は普通車2,200円／バイク1,320円（現地精算）。オートサイトのサイト料金には車1台分が含まれます。</dd>
      </div>
      <div class="grid grid-cols-[10rem_1fr] gap-4 py-5 sm:grid-cols-[14rem_1fr]">
        <dt class="text-zinc-500">駐車場</dt>
        <dd class="text-zinc-700">オートサイト以外の駐車場は15台分あります（1台2,200円）。</dd>
      </div>
      <div class="grid grid-cols-[10rem_1fr] gap-4 py-5 sm:grid-cols-[14rem_1fr]">
        <dt class="text-zinc-500">支払い</dt>
        <dd class="text-zinc-700">現地決済のみです。クレジットカード・電子マネー・QRコード決済・現金が使えます。</dd>
      </div>
      <div class="grid grid-cols-[10rem_1fr] gap-4 py-5 sm:grid-cols-[14rem_1fr]">
        <dt class="text-zinc-500">正確な総額</dt>
        <dd class="text-zinc-700">
          予約システムで利用日と人数を指定すると確認できます。表示された内容を確認してから手続きへ進めるため、この時点では予約は確定しません。
        </dd>
      </div>
    </dl>

    <div class="mt-6 flex flex-wrap gap-x-8 gap-y-3 text-sm">
      <a
        href={proXPlanlist}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-[color:var(--light-accent)] underline underline-offset-4 transition hover:opacity-80"
        data-cta="reserve" data-cta-field="light"
      >
        利用日と人数から料金を確認する
        <span aria-hidden="true">↗</span>
      </a>
      <a
        href="/sites/"
        class="inline-flex items-center gap-1.5 text-zinc-600 underline underline-offset-4 transition hover:text-zinc-900"
      >
        サイトのサイズと広さを見る
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  {/* 電話予約 */}
  <section id="phone" class="mb-16 scroll-mt-24 border-t border-zinc-300 pt-10">
    <p class="text-xs tracking-[0.2em] text-zinc-400">
      <span class="text-[color:var(--light-accent)]">04</span>
      <span class="ml-2">電話予約</span>
    </p>
    <h2 class="mt-2 mb-5 text-xl font-semibold text-zinc-800">電話予約・当日予約について</h2>

    <div class="grid gap-6 sm:grid-cols-2">
      {[
        {
          title: "電話予約は「当日のみ」",
          desc: "お電話によるご予約受付は、ご来場当日のみ承っております。当日以外のご予約については、聞き間違い等のトラブル防止のため、お電話では一切受け付けておりません。",
        },
        {
          title: "当日予約の料金について",
          desc: "当日予約（お電話または現地受付）はネット予約と料金体系が異なります。ネット予約がお得です。",
        },
      ].map((item) => (
        <div class="border-t border-zinc-200 pt-5">
          <h3 class="font-semibold text-zinc-800">{item.title}</h3>
          <p class="mt-3 text-sm leading-loose text-zinc-600">{item.desc}</p>
        </div>
      ))}
    </div>
  </section>

  {/* 変更・キャンセル */}
  <section id="change" class="mb-16 scroll-mt-24 border-t border-zinc-300 pt-10">
    <p class="text-xs tracking-[0.2em] text-zinc-400">
      <span class="text-[color:var(--light-accent)]">05</span>
      <span class="ml-2">変更・キャンセル</span>
    </p>
    <h2 class="mt-2 mb-5 text-xl font-semibold text-zinc-800">変更・キャンセルのやり方</h2>
    <p class="mb-6 max-w-2xl text-sm leading-loose text-zinc-600">
      キャンセルはご自身のオンライン手続きで完結します。24時間いつでも操作でき、お電話をいただく必要はありません。
      入口は2つあります。どちらからでも同じ手続きができます。
    </p>

    <div class="grid gap-6 sm:grid-cols-2">
      <div class="border-t-2 border-[color:var(--light-accent)] pt-5">
        <p class="text-xs tracking-[0.14em] text-zinc-400">A</p>
        <h3 class="mt-1 font-semibold text-zinc-800">予約完了メールから</h3>
        <p class="mt-3 text-sm leading-loose text-zinc-600">
          ご予約時に届く「予約完了メール」に、予約内容を確認するリンクが記載されています。
          そこから予約を開き、キャンセルへ進みます。会員登録をしていない方はこちらが確実です。
        </p>
      </div>
      <div class="border-t-2 border-[color:var(--light-accent)] pt-5">
        <p class="text-xs tracking-[0.14em] text-zinc-400">B</p>
        <h3 class="mt-1 font-semibold text-zinc-800">マイページから</h3>
        <p class="mt-3 text-sm leading-loose text-zinc-600">
          会員登録済みの方は、マイページにログインすると予約一覧が表示されます。
          対象の予約を開き、キャンセルへ進みます。
        </p>
        <p class="mt-4 text-sm">
          <a
            href={PROX_BOOKING_LOOKUP_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="underline underline-offset-2 text-[color:var(--light-accent)] transition hover:opacity-80"
            data-cta="booking-lookup"
          >マイページを開く ↗</a>
        </p>
      </div>
    </div>

    <div class="mt-8 border-l-4 border-[color:var(--light-accent)] pl-5">
      <p class="text-sm font-semibold text-zinc-700">キャンセル料は、当日以外かかりません</p>
      <p class="mt-2 text-sm leading-loose text-zinc-600">
        前日までのキャンセルは無料です。当日キャンセルと無断キャンセルのみ、ご予約料金の100%を申し受けます。
        天災・悪天候・施設トラブルなど当施設都合で中止する場合は、キャンセル料はかかりません。
      </p>
      <p class="mt-2 text-sm">
        <a href="/policy/#cancel" class="underline underline-offset-2 text-[color:var(--light-accent)] transition hover:opacity-80">
          キャンセルポリシーの全文を見る →
        </a>
      </p>
    </div>

    <dl class="mt-8 divide-y divide-zinc-100 border-y border-zinc-200 text-sm">
      <div class="grid grid-cols-[10rem_1fr] gap-4 py-5 sm:grid-cols-[14rem_1fr]">
        <dt class="text-zinc-500">日程を変えたい</dt>
        <dd class="text-zinc-700">一度キャンセルしてから、正しい日程で取り直してください。当日扱いになる前であればキャンセル料はかかりません。</dd>
      </div>
      <div class="grid grid-cols-[10rem_1fr] gap-4 py-5 sm:grid-cols-[14rem_1fr]">
        <dt class="text-zinc-500">人数・車の台数を変えたい</dt>
        <dd class="text-zinc-700">オンラインでの操作は不要です。当日、現地の受付で清算します。</dd>
      </div>
      <div class="grid grid-cols-[10rem_1fr] gap-4 py-5 sm:grid-cols-[14rem_1fr]">
        <dt class="text-zinc-500">サイトを追加したい</dt>
        <dd class="text-zinc-700">新規のご予約としてお手続きください。</dd>
      </div>
      <div class="grid grid-cols-[10rem_1fr] gap-4 py-5 sm:grid-cols-[14rem_1fr]">
        <dt class="text-zinc-500">オンラインの操作期限を過ぎた</dt>
        <dd class="text-zinc-700">
          直前でオンライン操作ができない場合のみ、お電話またはメールでご連絡ください。
          <a href="/contact/" class="ml-1 underline underline-offset-2 text-[color:var(--light-accent)] transition hover:opacity-80">連絡先を見る →</a>
        </dd>
      </div>
      <div class="grid grid-cols-[10rem_1fr] gap-4 py-5 sm:grid-cols-[14rem_1fr]">
        <dt class="text-zinc-500">楽天トラベルキャンプで予約した</dt>
        <dd class="text-zinc-700">予約した楽天トラベルキャンプ側の画面から手続きしてください。公式のマイページには表示されません。</dd>
      </div>
    </dl>
  </section>

  {/* 公式予約のメリット */}
  <section id="merit" class="mb-16 scroll-mt-24 border-t border-zinc-300 pt-10">
    <p class="text-xs tracking-[0.2em] text-zinc-400">
      <span class="text-[color:var(--light-accent)]">06</span>
      <span class="ml-2">公式予約のメリット</span>
    </p>
    <h2 class="mt-2 mb-5 text-xl font-semibold text-zinc-800">公式予約のメリット</h2>

    <div class="mb-8 border-l-4 border-[color:var(--light-accent)] bg-[color:var(--forest-100)] px-6 py-5">
      <p class="text-lg font-semibold text-zinc-800">公式サイトからの予約が、いちばんおトクです</p>
      <p class="mt-2 text-sm leading-loose text-zinc-600">外部サイト経由より料金が安く、会員登録すればポイントも貯まります。</p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2">
      {[
        {
          title: "宿泊回数で上がる「会員ランク」",
          desc: "会員登録してマイページを作成すると、宿泊回数に応じて会員ランクが上がります。ランクアップに伴い予約時のポイント付与率もアップ。リピーターほど優遇される仕組みです。",
        },
        {
          title: "賢く貯まる「ポイント制度」",
          desc: "ご予約時の利用金額に応じてポイントが貯まります。貯まったポイントは「1ポイント＝1円」として次回予約代金に充当可能です。オイラーズ活動への参加でも貯まります。",
        },
      ].map((item) => (
        <div class="border-t-2 border-[color:var(--light-accent)] pt-5">
          <h3 class="font-semibold text-zinc-800">{item.title}</h3>
          <p class="mt-3 text-sm leading-loose text-zinc-600">{item.desc}</p>
        </div>
      ))}
    </div>
  </section>

  {/* 会員制度 */}
  <section id="member" class="mb-16 scroll-mt-24 border-t border-zinc-300 pt-10">
    <p class="text-xs tracking-[0.2em] text-zinc-400">
      <span class="text-[color:var(--light-accent)]">07</span>
      <span class="ml-2">会員制度</span>
    </p>
    <h2 class="mt-2 mb-5 text-xl font-semibold text-zinc-800">会員制度について</h2>
    <p class="mb-6 text-sm text-zinc-600">泊まるほどにおトクになる仕組みです。まずは会員登録をおすすめします。</p>

    <div class="mb-8 border-l-4 border-[color:var(--light-accent)] pl-5">
      <p class="text-sm font-semibold text-zinc-700">【おすすめ】ご予約前の会員登録でお得に</p>
      <p class="mt-2 text-sm leading-loose text-zinc-600">
        会員登録をしてからご予約いただくと、宿泊実績やポイントが確実に貯まり、次回以降のご利用がお得になります。
      </p>
      <p class="mt-2 text-xs text-zinc-400">
        ※「ゲスト予約」のまま手続きを進めると、システム上後からポイントを紐付けることができません。事前ログインをおすすめします。
      </p>
    </div>

    <div class="flex flex-wrap gap-3">
      <a
        href={PROX_MEMBER_SIGNUP_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center rounded-full bg-[color:var(--forest-600)] px-6 py-2.5 text-sm text-white shadow-sm transition hover:bg-[color:var(--forest-700)]"
      >
        新規会員登録 ↗
      </a>
      <a
        href={PROX_MEMBER_LOGIN_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center rounded-full border border-zinc-400 px-6 py-2.5 text-sm text-zinc-700 transition hover:border-zinc-600"
      >
        ログイン ↗
      </a>
    </div>
  </section>

  {/* ネット予約の特徴 */}
  <section id="online" class="mb-16 scroll-mt-24 border-t border-zinc-300 pt-10">
    <p class="text-xs tracking-[0.2em] text-zinc-400">
      <span class="text-[color:var(--light-accent)]">08</span>
      <span class="ml-2">ネット予約の特徴</span>
    </p>
    <h2 class="mt-2 mb-5 text-xl font-semibold text-zinc-800">ネット予約の便利な機能</h2>

    <div class="grid gap-6 sm:grid-cols-2">
      {[
        {
          title: "「買い物カゴ」機能でまとめて予約",
          desc: "異なる日程や複数エリア（ライトフォレストとディープフォレスト等）を買い物カゴに入れ、一度に予約手続きが可能です。グループでの別々予約や長期滞在も1回の手続きで完了します。",
        },
        {
          title: "「キャンセル待ち」でチャンスを逃さない",
          desc: "希望の日が満室でも、キャンセル待ちに登録しておけば、空きが出た際にメールでお知らせが届きます。人気の週末・連休を狙いたい方に有効な機能です。",
        },
      ].map((item) => (
        <div class="border-t border-zinc-200 pt-5">
          <h3 class="font-semibold text-zinc-800">{item.title}</h3>
          <p class="mt-3 text-sm leading-loose text-zinc-600">{item.desc}</p>
        </div>
      ))}
    </div>
  </section>

  {/* 外部予約 */}
  <section id="rakuten" class="mb-16 scroll-mt-24 border-t border-zinc-300 pt-10">
    <p class="text-xs tracking-[0.2em] text-zinc-400">
      <span class="text-[color:var(--light-accent)]">09</span>
      <span class="ml-2">外部予約サイト</span>
    </p>
    <h2 class="mt-2 mb-5 text-xl font-semibold text-zinc-800">楽天トラベルキャンプから予約する</h2>
    <p class="mb-6 max-w-2xl text-sm leading-loose text-zinc-600">
      楽天ポイントを貯めたい方、ポイントを使って泊まりたい方は、楽天トラベルキャンプからも予約できます。
    </p>

    <dl class="divide-y divide-zinc-100 border-y border-zinc-200 text-sm">
      <div class="grid grid-cols-[10rem_1fr] gap-4 py-5 sm:grid-cols-[14rem_1fr]">
        <dt class="text-zinc-500">貯まるポイント</dt>
        <dd class="text-zinc-700">楽天ポイントが貯まり、ポイントを使った支払いもできます。</dd>
      </div>
      <div class="grid grid-cols-[10rem_1fr] gap-4 py-5 sm:grid-cols-[14rem_1fr]">
        <dt class="text-zinc-500">おいらの森ポイント</dt>
        <dd class="text-zinc-700">楽天経由の予約では貯まりません。会員ランクの宿泊実績にも加算されません。</dd>
      </div>
      <div class="grid grid-cols-[10rem_1fr] gap-4 py-5 sm:grid-cols-[14rem_1fr]">
        <dt class="text-zinc-500">変更・キャンセル</dt>
        <dd class="text-zinc-700">楽天トラベルキャンプ側の画面で手続きします。公式のマイページには表示されません。</dd>
      </div>
    </dl>

    <div class="mt-6">
      <a
        href={RAKUTEN_CAMP_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center rounded-full border border-zinc-400 px-7 py-2.5 text-sm text-zinc-700 transition hover:border-zinc-600"
        data-cta="reserve-rakuten"
      >
        楽天トラベルキャンプで見る ↗
      </a>
    </div>
  </section>

  {/* キャンセルポリシー */}
  {/* CTA */}
  <div class="mt-12 bg-[color:var(--forest-100)] px-8 py-10 text-center">
    <p class="text-sm text-zinc-500">準備が整いましたら</p>
    <p class="mt-2 text-xl font-semibold text-zinc-800">ご予約は公式予約サイトから</p>
    <p class="mt-3 text-sm leading-loose text-zinc-600">
      複数プラン・複数日程をまとめて予約手続きできます。
    </p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <a href={proXPlanlist}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center rounded-full bg-[color:var(--forest-600)] px-8 py-3 text-sm text-white shadow-sm transition hover:bg-[color:var(--forest-700)]"
       data-cta="reserve" data-cta-field="light">
        予約する ↗
      </a>
      <a
        href="/light-guide/"
        class="inline-flex items-center justify-center rounded-full border border-zinc-400 px-8 py-3 text-sm text-zinc-700 transition hover:border-zinc-600"
      >
        利用案内を見る
      </a>
    </div>
  </div>

</PageLayout>
