---
import { Picture } from "astro:assets";
import lgReception from "../../assets/images/lg_reception.jpg";
import lgRuleDog from "../../assets/images/lg_rule_dog.jpg";
import lgRuleFireworks from "../../assets/images/lg_rule_fireworks.jpg";
import lgToilet from "../../assets/images/lg_toilet.jpg";
import kuwagata from "../../assets/images/lightguide_kuwagata.jpg";
import shopStore from "../../assets/images/shop_store.jpg";
import { PROX_SEARCH_URL } from "../../config/nav";
import PageLayout from "../../layouts/PageLayout.astro";

// 本ページは「設備」と「ルール」に絞る。サイズ比較は /sites/、
// 予約手順・料金は /reservation-guide/、体験としての一泊は /stay-light/、
// 個別の疑問は /faq/ を正本とし、ここでは複製しない。

// 設備。並びは タイトル → 写真 → 説明。
//   img: 写真あり / null: 「準備中」枠 / photo:false: 写真枠を出さない（写真が存在しない設備）
//   avail=false（ない設備）も写真枠を出さない。
const facilities = [
	{
		id: "reception",
		label: "受付・売店",
		summary:
			"9:00〜17:30。飲料、薪、炭、着火剤などを販売。レンタル品の受け渡しもここで。",
		img: lgReception,
		alt: "新緑の木立に囲まれた木造の受付・売店",
		links: [
			{ href: "/shop/", text: "売店の品揃え" },
			{ href: "/rental/", text: "レンタル品" },
		],
		avail: true,
	},
	{
		id: "toilet",
		label: "トイレ",
		summary: "水洗・洋式。男女各2室（新築）。",
		img: lgToilet,
		alt: "木立の中に新築された木造の水洗トイレ棟",
		avail: true,
	},
	{
		id: "water",
		label: "水道・流し",
		summary: "2か所（うち1か所は給湯器付き）。すべて飲用可の水道水。",
		note: "洗剤・油・残飯は流さないでください。",
		img: null,
		avail: true,
	},
	{
		id: "wifi",
		label: "Wi-Fi",
		summary: "無料。接続方法は場内に掲示しています。",
		note: "ソロ区画・オートA・オートBはエリア外です。",
		photo: false,
		avail: true,
	},
	{
		id: "ac",
		label: "AC電源",
		summary: "有料オプション・要予約。600Wまで。対応サイトは限られます。",
		photo: false,
		links: [{ href: "#ac-power", text: "対応サイトと使い方" }],
		avail: true,
	},
	{
		id: "parking",
		label: "駐車",
		summary: "オートサイトは区画内に1台込み。それ以外は駐車場15台分。",
		links: [{ href: "/reservation-guide/#price", text: "追加車両の料金" }],
		img: null,
		avail: true,
	},
	{
		id: "shower",
		label: "シャワー",
		summary: "ありません。車で10分ほどの近隣温泉をご利用ください。",
		links: [{ href: "/map/?view=bath", text: "周辺の温泉を見る" }],
		avail: false,
	},
];

// 時間割。ここは「時刻＋ひとこと」だけ。補足は下の #schedule-notes へ。
const schedule = [
	{
		time: "09:00",
		event: "受付オープン／アーリーチェックイン開始",
		noteId: "n-early",
	},
	{ time: "12:00", event: "宿泊チェックアウト／通常チェックイン開始" },
	{ time: "17:00", event: "チェックインリミット", noteId: "n-limit" },
	{ time: "17:30", event: "売店・薪販売終了" },
	{
		time: "18:00",
		event: "外出門限／日帰りチェックアウト",
		noteId: "n-curfew",
	},
	{ time: "21:00", event: "星空タイム", noteId: "n-starry" },
	{ time: "23:00", event: "消灯", noteId: "n-lights" },
	{ time: "06:00", event: "車の移動・バトニング再開" },
];

const scheduleNotes = [
	{
		id: "n-early",
		title: "アーリーチェックイン（9:00〜12:00）",
		body: "無料で、ほとんどの日にご利用いただけます。連休の中日や、ドッグランサイト・区画Cのように場内に1つしかないサイトは、前の利用者の関係でお受けできない日があります。ご予約の際か、前日までにひとこと連絡してください。",
	},
	{
		id: "n-limit",
		title: "17:00 チェックインリミット",
		body: "安全管理上、これを過ぎると入場できません。遅れそうなときは必ず連絡してください。連絡がないまま来場されない場合は、無断キャンセルの扱いになります。",
	},
	{
		id: "n-curfew",
		title: "18:00 外出門限",
		body: "町内放送を合図に、場内での車の移動をやめていただきます。買い出しや温泉は、それまでに済ませてください。日帰りの方はこの時間までにチェックアウトです。",
	},
	{
		id: "n-starry",
		title: "21:00 星空タイム",
		body: "明かりを落として、静かに過ごす時間です。光漏れ、談笑、車のドアの開け閉めは控えてください。大きな音が消えると、風や木々、夜の生き物の気配が近くなります。",
	},
	{
		id: "n-lights",
		title: "23:00 消灯",
		body: "明かりも話し声も落として、森が眠る夜へ。無言で焚き火を味わう時間です。",
	},
];

// ルール。禁止の並べ立てではなく、理由と代替を添えて柔らかく。
//   photo: true で「準備中」の写真枠を出す（写真は別途）
const rules = [
	{
		title: "チェックアウト連絡",
		body: "受付に寄る必要はありません。前日確認メールのいちばん下のリンク、LINE、またはHPのチェックアウトページからオンラインで手続きしてください。",
		links: [{ href: "/checkout/", text: "チェックアウトページ" }],
	},
	{
		title: "ゴミ",
		body: "灰以外は、各自でお持ち帰りください。分別袋をご持参いただくと片付けが楽です。",
	},
	{
		title: "焚き火の灰",
		body: "灰は指定のペール缶へ。蚊取り線香、アルミ、ゴミ、タバコは混ぜないでください。灰は畑の肥料として使っています。蓋は閉めてください。",
		photo: true,
		photoLabel: "灰捨て場",
	},
	{
		title: "ワンちゃんと一緒に",
		body: "どのサイトも犬連れ歓迎です。ドッグランサイト以外ではリードをお願いします。ふんの片付けは飼い主さんで。",
		photo: true,
		photoLabel: "犬",
		img: lgRuleDog,
		alt: "テントのそばで食事をする子どもと、隣に立つ犬",
		links: [{ href: "/sites/dogrun/", text: "貸切ドッグランサイト" }],
	},
	{
		title: "花火",
		body: "手持ち花火はどのサイトでも楽しめます。打ち上げ花火は音と火の粉が周りに届くため、ご遠慮ください。",
		photo: true,
		photoLabel: "花火",
		img: lgRuleFireworks,
		alt: "タープの前で手持ち花火をする子ども",
	},
	{
		title: "音と光",
		body: "スピーカー、発電機、楽器の演奏、車のアイドリングは、周りの方の体験を壊してしまうので控えてください。21時以降の談笑、深夜早朝のバトニングも同様です。",
	},
	{
		title: "森を守るために",
		body: "樹木を傷つける行為、窃盗、不法投棄は警察に通報します。",
	},
	{
		title: "けがや事故",
		body: "場内での事故・けがは基本的に自己責任です。管理人は隣接地に住んでいるので、困ったときは声をかけてください。",
		extra:
			"もし夜間にけがや事故、急な病気があった場合は、自己解決しようとせず、消防・救急にすぐ連絡するとともに、おいらへもご一報ください。",
		links: [{ href: "/map/?view=emergency", text: "近くの救急・医療機関" }],
	},
];
---

<PageLayout
  title="ライトフォレスト 利用案内 | 里山パークおいらの森"
  description="ライトフォレストの設備と利用ルール。受付・売店、水洗トイレ、Wi-Fi、AC電源、利用時間、ゴミやペット、花火、昆虫採集まで。管理人常駐の里山キャンプ場。"
  lastUpdated="2026年9月"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": "ライトフォレスト 利用案内 | 里山パークおいらの森",
      "description": "ライトフォレストの設備と利用ルール。受付・売店、水洗トイレ、Wi-Fi、AC電源、利用時間、ゴミやペット、花火、昆虫採集まで。管理人常駐の里山キャンプ場。",
      "url": "https://oiranomori.jp/light-guide/",
      "isPartOf": {
        "@type": "WebSite",
        "name": "里山パークおいらの森",
        "url": "https://oiranomori.jp"
      }
    })} />
  </Fragment>

  {/* ページ見出し */}
  <div class="mb-10 border-b border-zinc-200 pb-8">
    <p class="text-xs tracking-[0.26em] text-zinc-400 uppercase">Light Forest</p>
    <h1 class="mt-3 text-3xl font-semibold text-zinc-800 md:text-4xl">ライトフォレスト<br class="sm:hidden" /> 利用案内</h1>
    <p class="mt-4 max-w-2xl text-sm leading-loose text-zinc-500">
      管理人常駐・全サイト焚き火可・里山広葉樹林。<a href="/residents/" class="underline underline-offset-4 transition hover:text-zinc-700">おいらが家族と暮らす</a>、安心・安全なキャンプ場です。
      このページは設備と利用ルールの案内です。
    </p>
    <nav class="mt-6 flex flex-wrap gap-2.5 text-sm" aria-label="このページの目次">
      {[
        { href: "#facility", label: "設備" },
        { href: "#ac-power", label: "AC電源について" },
        { href: "#schedule", label: "ご利用の時間割" },
        { href: "#sites",    label: "サイトの種類" },
        { href: "#rules",    label: "利用ルール" },
        { href: "#insects",  label: "昆虫採集" },
        { href: "#map",      label: "場内マップ" },
      ].map((item) => (
        <a
          href={item.href}
          class="rounded-full border border-zinc-300 px-4 py-1.5 text-zinc-600 transition hover:border-[color:var(--light-accent)] hover:text-[color:var(--light-accent)]"
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>

  {/* 設備。タイトル → 写真 → 説明 の順 */}
  <section id="facility" class="mb-16">
    <h2 class="mb-2 text-xl font-semibold text-zinc-800">設備</h2>
    <p class="mb-6 max-w-2xl text-sm leading-loose text-zinc-500">
      あるものと、ないもの。ないものは代わりの手段を書いています。
    </p>
    <ul class="divide-y divide-zinc-200 border-y border-zinc-200 sm:grid sm:grid-cols-2 sm:gap-x-12 sm:divide-y-0">
      {facilities.map((f) => (
        <li id={f.id} class="py-6 sm:border-b sm:border-zinc-200">
          <h3 class="flex items-center gap-2 text-base font-semibold text-zinc-800">
            <span
              class={`h-1.5 w-1.5 shrink-0 rounded-full ${f.avail ? "bg-[color:var(--light-accent)]" : "bg-zinc-300"}`}
            ></span>
            {f.label}
          </h3>
          {f.avail && f.photo !== false && (
            f.img ? (
              <Picture
                src={f.img}
                formats={["avif", "webp"]}
                alt={f.alt}
                loading="lazy"
                sizes="(max-width: 640px) 100vw, 20rem"
                class="mt-3 aspect-[4/3] w-full max-w-xs object-cover"
              />
            ) : (
              <span class="mt-3 flex aspect-[4/3] w-full max-w-xs items-center justify-center border border-dashed border-zinc-300 bg-zinc-50">
                <span class="text-[10px] tracking-[0.16em] text-zinc-400">写真 準備中</span>
              </span>
            )
          )}
          <p class="mt-3 text-sm leading-loose text-zinc-600">{f.summary}</p>
          {f.note && <p class="mt-1 text-xs leading-loose text-zinc-400">{f.note}</p>}
          {f.links && (
            <p class="mt-2 flex flex-wrap gap-x-5 gap-y-1">
              {f.links.map((l) => (
                <a
                  href={l.href}
                  class="inline-flex items-center gap-1.5 text-sm text-[color:var(--light-accent)] underline underline-offset-4 transition hover:opacity-80"
                >
                  {l.text}
                  <span aria-hidden="true">→</span>
                </a>
              ))}
            </p>
          )}
        </li>
      ))}
    </ul>
  </section>

  {/* AC電源について。設備一覧からアンカーで飛ばす */}
  <section id="ac-power" class="mb-16">
    <h2 class="mb-2 text-xl font-semibold text-zinc-800">AC電源について</h2>
    <p class="mb-5 max-w-2xl text-sm leading-loose text-zinc-500">
      有料オプション・要予約です。予約時にオプションとして追加してください。
    </p>
    <dl class="divide-y divide-zinc-100 border-y border-zinc-200 text-sm">
      <div class="grid grid-cols-[8rem_1fr] gap-4 py-4 sm:grid-cols-[12rem_1fr]">
        <dt class="text-zinc-500">容量</dt>
        <dd class="text-zinc-700">600Wまで。ブレーカーが落ちた場合はご自身で復旧してください。</dd>
      </div>
      <div class="grid grid-cols-[8rem_1fr] gap-4 py-4 sm:grid-cols-[12rem_1fr]">
        <dt class="text-zinc-500">対応サイト</dt>
        <dd class="text-zinc-700">オート 1・2・3・4・17・20・32・33・34・35・36番／オートE／ドッグランサイト</dd>
      </div>
      <div class="grid grid-cols-[8rem_1fr] gap-4 py-4 sm:grid-cols-[12rem_1fr]">
        <dt class="text-zinc-500">上記以外のサイト</dt>
        <dd class="text-zinc-700">オートA・Bなども、ご相談いただければ対応できる場合があります。事前にお問い合わせいただくか、当日受付でご相談ください。</dd>
      </div>
    </dl>
    <p class="mt-4 text-sm">
      <a href="#facility" class="inline-flex items-center gap-1.5 text-zinc-600 underline underline-offset-4 transition hover:text-zinc-900">
        <span aria-hidden="true">↑</span>
        設備一覧へ戻る
      </a>
    </p>
  </section>

  {/* 時間割 */}
  <section id="schedule" class="mb-16">
    <h2 class="mb-2 text-xl font-semibold text-zinc-800">ご利用の時間割</h2>
    <p class="mb-5 max-w-2xl text-sm leading-loose text-zinc-500">
      1日の区切りです。詳しい説明は、各行の「詳しく」から下の補足へ飛べます。
    </p>
    <dl class="divide-y divide-zinc-100 border-y border-zinc-200 text-sm">
      {schedule.map((item) => (
        <div class="grid grid-cols-[4.5rem_1fr] gap-4 py-4 sm:grid-cols-[6rem_1fr]">
          <dt class="font-semibold tabular-nums text-zinc-700">{item.time}</dt>
          <dd class="flex flex-wrap items-baseline gap-x-3 text-zinc-600">
            <span>{item.event}</span>
            {item.noteId && (
              <a href={`#${item.noteId}`} class="text-xs text-[color:var(--light-accent)] underline underline-offset-4 transition hover:opacity-80">
                詳しく
              </a>
            )}
          </dd>
        </div>
      ))}
    </dl>

    {/* 補足。時間割からアンカーで飛ぶ。ページに沈まないよう、見出し付きの枠で囲む */}
    <div id="schedule-notes" class="mt-8 border-l-4 border-[color:var(--light-accent)] bg-[color:var(--forest-100)] px-6 py-6">
      <h3 class="text-base font-semibold text-zinc-800">時間割の補足</h3>
      <p class="mt-1 text-xs text-zinc-500">アーリーチェックイン、チェックインリミット、門限、星空タイム、消灯について</p>
      <div class="mt-4 divide-y divide-zinc-300/70">
        {scheduleNotes.map((n) => (
          <div id={n.id} class="py-4">
            <h4 class="text-sm font-semibold text-zinc-800">{n.title}</h4>
            <p class="mt-2 text-sm leading-loose text-zinc-600">{n.body}</p>
          </div>
        ))}
      </div>
    </div>

    {/* 時刻の正本は本ページ。体験としての一泊は /stay-light/ へ送る */}
    <p class="mt-6 text-sm">
      <a
        href="/stay-light/"
        class="inline-flex items-center gap-1.5 text-[color:var(--light-accent)] underline underline-offset-4 transition hover:opacity-80"
        data-cta="light-guide-to-stay-light"
        data-cta-target="/stay-light/"
      >
        この時間割を、一泊の体験として見る
        <span aria-hidden="true">→</span>
      </a>
    </p>
  </section>

  {/* サイトの種類。広さ・比較は /sites/ が正本のため、ここは入口だけ */}
  <section id="sites" class="mb-16">
    <h2 class="mb-2 text-xl font-semibold text-zinc-800">サイトの種類</h2>
    <p class="mb-4 max-w-2xl text-sm leading-loose text-zinc-600">
      オートサイト 37区画／区画サイト 10区画／ドッグランサイト 1区画（計48区画）。
      広さや人数別のおすすめ、車の横付け・電源などの条件は「サイトを選ぶ」で比較できます。
    </p>
    <p class="text-sm">
      <a
        href="/sites/"
        class="inline-flex items-center gap-1.5 text-[color:var(--light-accent)] underline underline-offset-4 transition hover:opacity-80"
        data-cta="light-guide-to-sites"
      >
        ライトのサイト・区画を選ぶ
        <span aria-hidden="true">→</span>
      </a>
    </p>
    <div class="mt-6 border-l-4 border-[color:var(--light-accent)] pl-5">
      <p class="text-sm font-semibold text-zinc-700">大きな車・トレーラーでお越しの方へ</p>
      <p class="mt-1 text-sm leading-loose text-zinc-600">
        全長6mまでは問題なく入れます。2tクラスのキャンピングカーも大丈夫です。
        フルトレーラーや、けん引免許が必要なトレーラーは場所によって難しいことがあります。不安な場合は、事前にご確認ください。
      </p>
      <p class="mt-2 text-xs leading-loose text-zinc-400">
        バリアフリーには対応していません（段差・未舗装路があります）。
      </p>
    </div>
  </section>

  {/* 利用ルール。タイトル → 写真（あれば） → 説明 */}
  <section id="rules" class="mb-16">
    <h2 class="mb-2 text-xl font-semibold text-zinc-800">利用ルール</h2>
    <p class="mb-6 max-w-2xl text-sm leading-loose text-zinc-500">
      同じ森に泊まる人どうしが、気持ちよく過ごすための約束ごとです。
    </p>
    <div class="grid gap-x-10 gap-y-6 sm:grid-cols-2">
      {rules.map((rule) => (
        <div class="border-t border-zinc-200 pt-5">
          <h3 class="font-semibold text-zinc-800">{rule.title}</h3>
          {rule.photo && (
            rule.img ? (
              <Picture
                src={rule.img}
                formats={["avif", "webp"]}
                alt={rule.alt}
                loading="lazy"
                sizes="(max-width: 640px) 100vw, 20rem"
                class="mt-3 aspect-[4/3] w-full max-w-xs object-cover"
              />
            ) : (
              <span class="mt-3 flex aspect-[4/3] w-full max-w-xs items-center justify-center border border-dashed border-zinc-300 bg-zinc-50">
                <span class="text-[10px] tracking-[0.16em] text-zinc-400">写真 準備中（{rule.photoLabel}）</span>
              </span>
            )
          )}
          <p class="mt-3 text-sm leading-loose text-zinc-600">{rule.body}</p>
          {rule.extra && (
            <p class="mt-2 text-sm leading-loose text-zinc-700">{rule.extra}</p>
          )}
          {rule.links && (
            <p class="mt-2 flex flex-wrap gap-x-5 gap-y-1">
              {rule.links.map((l) => (
                <a
                  href={l.href}
                  class="inline-flex items-center gap-1.5 text-sm text-[color:var(--light-accent)] underline underline-offset-4 transition hover:opacity-80"
                >
                  {l.text}
                  <span aria-hidden="true">→</span>
                </a>
              ))}
            </p>
          )}
        </div>
      ))}
    </div>
    <p class="mt-6 text-sm leading-loose text-zinc-500">
      ルール違反が続く場合は、退場をお願いすることがあります。
      詳細は<a href="/policy/#terms" class="underline underline-offset-4 transition hover:text-zinc-800">利用規約</a>をご確認ください。
    </p>
  </section>

  {/* 昆虫採集。売りとして独立させる */}
  <section id="insects" class="mb-16">
    <h2 class="mb-2 text-xl font-semibold text-zinc-800">昆虫採集</h2>
    <p class="mb-6 max-w-2xl text-sm leading-loose text-zinc-600">
      広葉樹の里山なので、夏はカブトムシやクワガタに会えます。夜、灯りの周りや樹液の出る木を探してみてください。
      朝早く起きて森を歩くのも、いい出会いがあります。
    </p>
    <div class="grid grid-cols-2 gap-3 sm:gap-5">
      <Picture
        src={kuwagata}
        formats={["avif", "webp"]}
        alt="落ち葉の上を歩くノコギリクワガタ"
        loading="lazy"
        sizes="(max-width: 640px) 50vw, 24rem"
        class="aspect-[4/3] w-full object-cover"
      />
      <span class="flex aspect-[4/3] w-full items-center justify-center border border-dashed border-zinc-300 bg-zinc-50">
        <span class="text-xs tracking-[0.16em] text-zinc-400">写真 準備中</span>
      </span>
    </div>
    <div class="mt-6 border-l-4 border-[color:var(--light-accent)] pl-5">
      <p class="text-sm font-semibold text-zinc-700">持ち帰りについて</p>
      <p class="mt-1 text-sm leading-loose text-zinc-600">
        ご自身で飼育できる範囲での持ち帰りはどうぞ。森に次の世代を残すため、メスはそのままにしておいてください。
        トラップ（仕掛け）は使わないでください。
      </p>
    </div>
  </section>

  {/* 場内マップ。ページ末尾に置く */}
  <section id="map" class="mb-16">
    <h2 class="mb-5 text-xl font-semibold text-zinc-800">場内マップ</h2>
    <img
      src="/images/light-field-map.png"
      alt="ライトフォレスト 場内マップ"
      width="842"
      height="595"
      class="w-full border border-zinc-200"
      loading="lazy"
      decoding="async"
    />
    <p class="mt-3 text-xs text-zinc-400">場内の詳細マップは受付時にもお渡しします。</p>
    <div class="mt-5 flex flex-wrap gap-x-8 gap-y-3 text-sm">
      <a
        href="/pdf/light-field-map.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-zinc-700 underline underline-offset-4 transition hover:text-zinc-900"
      >
        利用案内PDFをダウンロード
        <span aria-hidden="true">↗</span>
      </a>
      <a
        href="/faq/#nature"
        class="inline-flex items-center gap-1.5 text-zinc-700 underline underline-offset-4 transition hover:text-[color:var(--light-accent)]"
      >
        危険動物・生き物と安全について
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  {/* よくある質問（FAQ）・問い合わせとの相互リンク */}
  <section class="mb-16 border-t border-zinc-200 pt-8">
    <h2 class="mb-2 text-xl font-semibold text-zinc-800">分からないことがあれば</h2>
    <p class="mb-4 max-w-2xl text-sm leading-loose text-zinc-600">
      ここに書いていないことは、よくある質問（FAQ）にまとめています。それでも分からなければ、問い合わせフォームからどうぞ。
      予約やキャンセルの手順は予約ガイドへ。
    </p>
    <div class="flex flex-wrap gap-x-8 gap-y-3 text-sm">
      <a href="/faq/#facility-rules" class="inline-flex items-center gap-1.5 text-[color:var(--light-accent)] underline underline-offset-4 transition hover:opacity-80">
        よくある質問（FAQ）設備・ルール
        <span aria-hidden="true">→</span>
      </a>
      <a href="/contact/" class="inline-flex items-center gap-1.5 text-[color:var(--light-accent)] underline underline-offset-4 transition hover:opacity-80">
        問い合わせフォーム
        <span aria-hidden="true">→</span>
      </a>
      <a href="/reservation-guide/" class="inline-flex items-center gap-1.5 text-zinc-700 underline underline-offset-4 transition hover:text-zinc-900">
        予約ガイド
        <span aria-hidden="true">→</span>
      </a>
      <a href="/#plans" class="inline-flex items-center gap-1.5 text-zinc-700 underline underline-offset-4 transition hover:text-zinc-900">
        プラン一覧
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  {/* 予約CTA */}
  <div class="mt-12 bg-[color:var(--forest-100)] px-8 py-10 text-center">
    <p class="text-sm text-zinc-500">設備とルールを確認したら</p>
    <p class="mt-2 text-xl font-semibold text-zinc-800">日付と人数から、空きと料金を確認する</p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <a href={PROX_SEARCH_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center rounded-full bg-[color:var(--forest-600)] px-8 py-3 text-sm text-white shadow-sm transition hover:bg-[color:var(--forest-700)]"
       data-cta="reserve" data-cta-field="light">
        予約する ↗
      </a>
      <a
        href="/reservation-guide/"
        class="inline-flex items-center justify-center rounded-full border border-zinc-400 px-8 py-3 text-sm text-zinc-700 transition hover:border-zinc-600"
      >
        予約ガイドを見る
      </a>
    </div>
  </div>

</PageLayout>
