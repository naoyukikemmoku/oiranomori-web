---
import PageLayout from "../../../layouts/PageLayout.astro";
import { PROX_SEARCH_URL } from "../../../config/nav";

const TITLE = "デュオ・カップルキャンプ｜里山パークおいらの森";
const DESC =
	"広すぎず狭すぎない、ふたり向けのサイト。焚き火を挟んで向き合う夜を。栃木・那須烏山のキャンプ場。";
const URL = "https://oiranomori.jp/sites/duo/";

const sizeGuide = [
	{ size: "S", area: "20〜39㎡", guide: "1〜2人：小型テント1張り＋タープ。" },
	{
		size: "M",
		area: "40〜59㎡",
		guide: "2〜4人：中型テント1張り＋タープ。ゆったり過ごすふたりに。",
	},
];

const experiences = [
	{
		h: "ふたつの椅子と、ひとつの焚き火",
		body: "大きすぎない区画だから、距離が近い。火を挟んで、話すでもなく、ただ過ごす。",
	},
	{
		h: "設営は軽く、時間は長く",
		body: "小さく張って、あとはのんびり。広さを持て余さない。代わりに、手早く整えて、長く座っていられます。",
	},
];
---

<PageLayout title={TITLE} description={DESC}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": TITLE,
      "description": DESC,
      "url": URL,
      "isPartOf": {
        "@type": "WebSite",
        "name": "里山パークおいらの森",
        "url": "https://oiranomori.jp"
      }
    })} />
  </Fragment>

  {/* ページ見出し */}
  <div class="mb-10 border-b border-zinc-200 pb-8">
    <p class="text-xs tracking-[0.26em] text-zinc-400 uppercase">Duo</p>
    <h1 class="mt-3 text-3xl font-semibold text-zinc-800 md:text-4xl">ふたりに、ちょうどいい</h1>
    <p class="mt-4 max-w-2xl text-sm leading-loose text-zinc-500">
      カップルでも、夫婦でも、気の合う相棒とでも。
      近すぎず遠すぎない区画で、火を挟んで過ごすふたりの夜を。
    </p>
  </div>

  {/* あなたの人数なら、このサイズ */}
  <section class="mb-14">
    <h2 class="mb-2 text-xl font-semibold text-zinc-800">あなたなら、このサイズ</h2>
    <p class="mb-5 text-sm text-zinc-500">2人に合うのは S・M。コンパクトならS、ゆったりならM。</p>
    <div class="overflow-x-auto border-y border-zinc-200">
      <table class="w-full min-w-[480px] text-sm">
        <thead>
          <tr class="border-b border-zinc-200 bg-zinc-50">
            <th class="px-4 py-3 text-left font-medium text-zinc-600">サイズ</th>
            <th class="px-4 py-3 text-left font-medium text-zinc-600">有効面積</th>
            <th class="px-4 py-3 text-left font-medium text-zinc-600">目安</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-zinc-100">
          {sizeGuide.map((s) => (
            <tr class="transition hover:bg-zinc-50">
              <td class="px-4 py-3 font-medium text-zinc-700">{s.size}</td>
              <td class="px-4 py-3 text-zinc-600">{s.area}</td>
              <td class="px-4 py-3 text-zinc-600">{s.guide}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-4 text-sm">
      <a href="/sites/" class="underline underline-offset-2 text-[color:var(--light-accent)] transition hover:opacity-80">
        全サイズの実寸・設営例を見る →
      </a>
    </p>
  </section>

  {/* 将来: サイズ別の空き状況＋個別区画一覧を client-fetch で描画する予定地点。
      実装までは DOM を生成しない（空セクションの余白を残さないため）。 */}

  {/* 体験 */}
  <section class="mb-14">
    <div class="grid gap-8 sm:grid-cols-2">
      {experiences.map((e) => (
        <div class="border-t border-zinc-200 pt-5">
          <h2 class="text-lg font-semibold text-zinc-800">{e.h}</h2>
          <p class="mt-3 text-sm leading-loose text-zinc-600">{e.body}</p>
        </div>
      ))}
    </div>
  </section>

  {/* Deep への条件付き案内（成人2名は適合しうる） */}
  <section class="mb-14">
    <div class="border-t border-zinc-200 pt-5">
      <h2 class="text-xl font-semibold text-zinc-800">ふたりとも18歳以上なら</h2>
      <p class="mt-3 text-sm leading-loose text-zinc-600">
        設備のない森で過ごすディープフォレストも選べます。1〜3名限定、場所は非公開。
        水道・電源・売店はありません。
      </p>
      <p class="mt-4 text-sm">
        <a
          href="/deep/"
          class="underline underline-offset-2 text-[color:var(--light-accent)] transition hover:opacity-80"
          data-cta="duo-to-deep"
        >ディープフォレストを見る →</a>
      </p>
    </div>
  </section>

  {/* 予約導線 */}
  <section class="mb-14">
    <h2 class="mb-2 text-xl font-semibold text-zinc-800">予約する</h2>
    <p class="mb-5 text-sm leading-loose text-zinc-500">
      料金・空き状況は予約システムでご確認ください。
    </p>
    <a href={PROX_SEARCH_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center rounded-full bg-[color:var(--forest-600)] px-7 py-3 text-sm text-white shadow-sm transition hover:bg-[color:var(--forest-700)]"
     data-cta="reserve" data-cta-field="light">
      空き状況・予約はこちら ↗
    </a>
    {/* 該当プランID未確定のため全体検索（search/）へ着地。ID確定後に proxPlanUrl(id) 形式へ差し替える */}
  </section>

  {/* 関連内部リンク */}
  <section class="mb-14">
    <h2 class="mb-5 text-xl font-semibold text-zinc-800">あわせて見る</h2>
    <ul class="space-y-3 text-sm">
      <li>
        <a href="/light-guide/" class="text-zinc-600 underline underline-offset-2 transition hover:text-zinc-800">ライトフォレスト 利用案内</a>
        <span class="ml-2 text-zinc-400">— 設備・サイズ別目安・利用ルール</span>
      </li>
      <li>
        <a href="/rental/" class="text-zinc-600 underline underline-offset-2 transition hover:text-zinc-800">レンタル</a>
        <span class="ml-2 text-zinc-400">— 手ぶらでも始められる</span>
      </li>
    </ul>
  </section>
</PageLayout>
