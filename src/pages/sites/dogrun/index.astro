---
import { Picture } from "astro:assets";
import dogrunDog from "../../../assets/images/sites_dogrun_dog.jpg";
import dogrunHero from "../../../assets/images/sites_dogrun_hero.jpg";
import dogrunStay from "../../../assets/images/sites_dogrun_stay.jpg";
import { proxPlanUrl } from "../../../config/nav";
import PageLayout from "../../../layouts/PageLayout.astro";

const TITLE =
	"貸切ドッグランサイト｜400㎡・1日1組、愛犬とノーリードでキャンプ｜里山パークおいらの森（栃木）";
const DESC =
	"栃木県那須烏山市・里山パークおいらの森の貸切ドッグランサイト。柵で囲まれた約400㎡のドッグランの中でキャンプでき、車もそのまま入れます。1日1組限定。ライトフォレストは全サイト犬連れOKで、犬の頭数・大きさの制限はなく料金もかかりません。";
const URL = "https://oiranomori.jp/sites/dogrun/";
const OG_IMAGE = new globalThis.URL(dogrunHero.src, Astro.site).href;

const details = [
	{ label: "広さ", value: "約400㎡・柵で囲まれたドッグラン" },
	{ label: "利用", value: "1日1組限定の貸切（場内に1区画のみ）" },
	{ label: "設営場所", value: "柵内に2か所整備。地形によりレイアウトはある程度限られます" },
	{ label: "車", value: "ドッグラン内に乗り入れ可能" },
	{ label: "電源", value: "AC電源あり。有料・要予約、600Wまで" },
	{ label: "犬の頭数・大きさ・犬種", value: "制限なし" },
	{ label: "犬の料金", value: "無料" },
];

const reserveClass =
	"inline-flex items-center justify-center rounded-full bg-[color:var(--forest-600)] px-7 py-3 text-sm text-white shadow-sm transition hover:bg-[color:var(--forest-700)]";
const linkClass =
	"text-sm text-zinc-600 underline underline-offset-2 transition hover:text-zinc-800";
---

<PageLayout title={TITLE} description={DESC} ogImage={OG_IMAGE} lastUpdated="2026年10月">
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": TITLE,
      "description": DESC,
      "url": URL,
      "isPartOf": {
        "@type": "WebSite",
        "name": "里山パークおいらの森",
        "url": "https://oiranomori.jp"
      }
    })} />
  </Fragment>

  {/* ヒーロー */}
  <Picture
    src={dogrunHero}
    formats={["avif", "webp"]}
    alt="柵に囲まれたドッグランサイトと夕暮れの空"
    loading="eager"
    fetchpriority="high"
    sizes="(max-width: 768px) 100vw, 72rem"
    class="mb-10 aspect-[16/9] w-full object-cover"
  />

  {/* ページ見出し */}
  <div class="mb-14 border-b border-zinc-200 pb-8">
    <p class="text-xs tracking-[0.26em] text-zinc-400 uppercase">Dog Run</p>
    <h1 class="mt-3 text-3xl font-semibold leading-snug text-zinc-800 md:text-4xl">ドッグランの中で、愛犬とキャンプ</h1>
    <p class="mt-4 max-w-2xl text-sm leading-loose text-zinc-700">
      約400㎡のドッグランを貸し切って、その中でキャンプができます。柵内にはテントを張れる場所を2か所整備してあり、愛犬はノーリードで過ごせます。1日1組限定の、犬連れのためのサイトです。
    </p>
    <p class="mt-4 max-w-2xl text-sm leading-loose text-zinc-700">
      栃木県那須烏山市の里山パークおいらの森で、愛犬と一緒に一泊してみませんか。
    </p>
    <div class="mt-6">
      <a href={proxPlanUrl(7)} target="_blank" rel="noopener noreferrer" class={reserveClass} data-cta="reserve" data-cta-field="light">
        空き状況・料金を見る ↗
      </a>
    </div>
  </div>

  {/* 将来: サイズ別の空き状況＋個別区画一覧を client-fetch で描画する予定地点。
      実装までは DOM を生成しない（空セクションの余白を残さないため）。 */}

  <section class="mb-14">
    <h2 class="mb-5 text-xl font-semibold text-zinc-800">遊ぶ場所も、泊まる場所も一緒</h2>
    <Picture
      src={dogrunDog}
      formats={["avif", "webp"]}
      alt="木陰の草地で休む犬"
      loading="lazy"
      sizes="(max-width: 768px) 100vw, 36rem"
      class="mb-5 aspect-[3/2] w-full max-w-2xl object-cover"
    />
    <div class="max-w-2xl space-y-4 text-sm leading-loose text-zinc-600">
      <p>犬を遊ばせたらキャンプサイトへ戻る。ここでは、その移動がありません。ドッグランの中にテントを張るので、遊んだ後も、そのままそばで過ごせます。</p>
      <p>走り回ったり、においを嗅いで歩いたり、テントのそばで昼寝をしたり。飼い主さんが食事や休憩をしている間も、愛犬の様子を見ながら一緒に過ごせる場所です。</p>
      <p>ほかの利用者の犬と共用するドッグランではなく、滞在中は自分たちだけで使えます。遊ぶ時間を決めずに、キャンプの一日の中でドッグランを使ってください。</p>
      <p>どの子もうれしそうに駆け回ります。その姿を見て、また来ようと思ってくださる方が多いようです。</p>
    </div>
  </section>

  <section class="mb-14">
    <Picture
      src={dogrunStay}
      formats={["avif", "webp"]}
      alt="ハンモックのそばで焚き火を眺める犬"
      loading="lazy"
      sizes="(max-width: 768px) 100vw, 36rem"
      class="mb-8 aspect-[3/2] w-full max-w-2xl object-cover"
    />
    <h2 class="mb-5 text-xl font-semibold text-zinc-800">ドッグランサイトについて</h2>
    <div class="max-w-2xl space-y-4 text-sm leading-loose text-zinc-600">
      <p>約400㎡は、設営場所や駐車スペースを含めたドッグラン全体の広さです。地形に合わせてテントを張れる場所を2か所整備しています。場内のどこにでもテントを張れるわけではないため、テントやタープの配置は、整備された場所に合わせたレイアウトになります。</p>
      <p>広いので、大型犬でも思いきり走れます。そのぶん、小さな子だと姿を見失いそうで心配、という声もいただきます。目の届く範囲で過ごしたいときは、ほかの区画でリードを付けて、すぐそばに置いておくのもおすすめです。</p>
      <p>車はドッグランの中まで乗り入れできます。キャンプ道具に加えて、愛犬の食事や寝床など、荷物が多くなる犬連れキャンプでも、車のそばで積み下ろしができます。</p>
      <p>地面は芝生ではなく、森の土です。雨の日や雨上がりは、足もお腹も泥だらけになります。それでも犬たちは、おかまいなしに走り回ります。タオルは多めにどうぞ。</p>
    </div>

    <div class="mt-8 overflow-x-auto border-y border-zinc-200">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-zinc-200">
            <th scope="col" class="px-4 py-3 text-left font-medium text-zinc-500">項目</th>
            <th scope="col" class="px-4 py-3 text-left font-medium text-zinc-500">内容</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-zinc-100">
          {details.map((d) => (
            <tr>
              <th scope="row" class="px-4 py-3 text-left align-top font-medium text-zinc-700 sm:w-56">{d.label}</th>
              <td class="px-4 py-3 leading-loose text-zinc-600">{d.value}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="mt-6 max-w-2xl text-sm leading-loose text-zinc-600">
      柵の中でも愛犬から目を離さず、出入口の開閉時には飛び出しに気をつけてください。
    </p>
    <p class="mt-3 max-w-2xl text-sm leading-loose text-zinc-600">
      犬連れでの過ごし方は、利用案内にまとめています。<a href="/light-guide/#dog" class="ml-1 underline underline-offset-2 text-[color:var(--light-accent)] transition hover:opacity-80">→ ワンちゃんと一緒に</a>
    </p>
    <ul class="mt-5 space-y-2">
      <li><a href="/lightforest-map/" class={linkClass}>場内マップを見る →</a></li>
      <li><a href="/light-guide/" class={linkClass}>設備・利用案内を見る →</a></li>
    </ul>
  </section>

  {/* 予約導線 */}
  <section class="mb-14">
    <h2 class="mb-5 text-xl font-semibold text-zinc-800">ご予約</h2>
    <div class="max-w-2xl space-y-4 text-sm leading-loose text-zinc-600">
      <p>ご希望の日付・人数で、ドッグランサイトの空き状況と料金をご確認ください。</p>
      <p>ほかのキャンプサイトも犬連れで利用できます。リードを着けて過ごす場合は、そちらもお選びいただけます。</p>
    </div>
    <div class="mt-6">
      <a href={proxPlanUrl(7)} target="_blank" rel="noopener noreferrer" class={reserveClass} data-cta="reserve" data-cta-field="light">
        ドッグランサイトの空き状況・料金を見る ↗
      </a>
    </div>
    <ul class="mt-5 space-y-2">
      <li><a href="/sites/" class={linkClass} data-cta="dogrun-to-sites">ほかのサイトを見る →</a></li>
      <li><a href="/access/" class={linkClass}>アクセス →</a></li>
    </ul>
  </section>

  {/* 関連内部リンク */}
  <section class="mb-14">
    <h2 class="mb-5 text-xl font-semibold text-zinc-800">あわせて見る</h2>
    <ul class="space-y-3 text-sm">
      <li>
        <a href="/stay-light/" class="text-zinc-600 underline underline-offset-2 transition hover:text-zinc-800">ライトフォレストで過ごす一泊</a>
        <span class="ml-2 text-zinc-400">— 到着から翌朝までの流れ</span>
      </li>
      <li>
        <a href="/light-guide/" class="text-zinc-600 underline underline-offset-2 transition hover:text-zinc-800">ライトフォレスト 利用案内</a>
        <span class="ml-2 text-zinc-400">— 設備・サイズ別目安・利用ルール</span>
      </li>
      <li>
        <a href="/rental/" class="text-zinc-600 underline underline-offset-2 transition hover:text-zinc-800">レンタル</a>
        <span class="ml-2 text-zinc-400">— 手ぶらでも始められる</span>
      </li>
      <li>
        <a href="/access/" class="text-zinc-600 underline underline-offset-2 transition hover:text-zinc-800">アクセス</a>
        <span class="ml-2 text-zinc-400">— 行き方・駐車場</span>
      </li>
    </ul>
  </section>
</PageLayout>
