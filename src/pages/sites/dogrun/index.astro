---
import { Picture } from "astro:assets";
import dogrunDog from "../../../assets/images/sites_dogrun_dog.jpg";
import dogrunHero from "../../../assets/images/sites_dogrun_hero.jpg";
import dogrunStay from "../../../assets/images/sites_dogrun_stay.jpg";
import { proxPlanUrl } from "../../../config/nav";
import { PLAN_PRICES } from "../../../data/planPrices";
import PageLayout from "../../../layouts/PageLayout.astro";

const TITLE =
	"貸切ドッグランサイト｜400㎡・1日1組、愛犬とノーリードでキャンプ｜里山パークおいらの森（栃木）";
const DESC =
	"栃木県那須烏山市・里山パークおいらの森の貸切ドッグランサイト。柵で囲まれた約400㎡のドッグランの中でキャンプでき、車もそのまま入れます。1日1組限定。ライトフォレストは全サイト犬連れOKで、犬の頭数・大きさの制限はなく料金もかかりません。";
const URL = "https://oiranomori.jp/sites/dogrun/";
const OG_IMAGE = new globalThis.URL(dogrunHero.src, Astro.site).href;

const conditions = [
	{ label: "組数", value: "1日1組限定" },
	{ label: "広さ", value: "約400㎡" },
	{ label: "車", value: "柵の中に乗り入れ可" },
	{ label: "AC電源", value: "あり（有料オプション・要予約、600Wまで）" },
	{ label: "犬の頭数・大きさ・犬種", value: "制限なし" },
	{ label: "犬の料金", value: "無料" },
	{ label: "リード", value: "柵の中はノーリードOK。ドッグランサイト以外ではリードをお願いします" },
	{ label: "飼い主の責任", value: "ふんの処理・管理は飼い主が行ってください。" },
];
---

<PageLayout title={TITLE} description={DESC} ogImage={OG_IMAGE}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": TITLE,
      "description": DESC,
      "url": URL,
      "isPartOf": {
        "@type": "WebSite",
        "name": "里山パークおいらの森",
        "url": "https://oiranomori.jp"
      }
    })} />
  </Fragment>

  {/* ヒーロー */}
  <Picture
    src={dogrunHero}
    formats={["avif", "webp"]}
    alt="柵に囲まれた草地のドッグランサイトと夕暮れの空"
    loading="eager"
    fetchpriority="high"
    sizes="(max-width: 768px) 100vw, 72rem"
    class="mb-10 aspect-[16/9] w-full object-cover"
  />

  {/* ページ見出し */}
  <div class="mb-14 border-b border-zinc-200 pb-8">
    <p class="text-xs tracking-[0.26em] text-zinc-400 uppercase">Dog Run</p>
    <h1 class="mt-3 text-3xl font-semibold text-zinc-800 md:text-4xl">犬と、過ごす</h1>
    <p class="mt-4 max-w-2xl text-sm leading-loose text-zinc-700">
      柵に囲まれた約400㎡を貸し切り。リードを外して走らせて、夜は同じテントで眠る。<br />
      愛犬との一日を、まるごと森の中で。
    </p>
    <p class="mt-6 text-lg tracking-wide text-zinc-800">{PLAN_PRICES[7]}</p>
    <div class="mt-4 flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:gap-6">
      <a href={proxPlanUrl(7)}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center rounded-full bg-[color:var(--forest-600)] px-7 py-3 text-sm text-white shadow-sm transition hover:bg-[color:var(--forest-700)]"
       data-cta="reserve" data-cta-field="light">
        空き状況・予約はこちら ↗
      </a>
      <a href="/sites/" class="text-sm text-zinc-500 underline underline-offset-2 transition hover:text-zinc-800" data-cta="dogrun-to-sites">
        貸切でなくても大丈夫。通常のサイトを選ぶ
      </a>
    </div>
  </div>

  {/* 将来: サイズ別の空き状況＋個別区画一覧を client-fetch で描画する予定地点。
      実装までは DOM を生成しない（空セクションの余白を残さないため）。 */}

  <section class="mb-14">
    <h2 class="mb-5 text-xl font-semibold text-zinc-800">囲いの中で、リードを外す</h2>
    <Picture
      src={dogrunDog}
      formats={["avif", "webp"]}
      alt="木陰の草地で休む犬"
      loading="lazy"
      sizes="(max-width: 768px) 100vw, 36rem"
      class="mb-5 aspect-[3/2] w-full max-w-2xl object-cover"
    />
    <p class="max-w-2xl text-sm leading-loose text-zinc-600">
      柵の中に車ごと入ったら、あとはリードを外すだけ。<br />
      どの子もうれしそうに、森の中を駆け回ります。<br />
      その姿を見て、また来ようと思ってくださる方が多いようです。
    </p>
  </section>

  <section class="mb-14">
    <h2 class="mb-5 text-xl font-semibold text-zinc-800">広さは、約400㎡を貸し切り</h2>
    <p class="max-w-2xl text-sm leading-loose text-zinc-600">
      大型犬でも、思いきり走れる広さです。<br />
      そのぶん、小さな子だと姿を見失いそうで心配、という声もいただきます。<br />
      目の届く範囲で過ごしたいときは、ほかの区画でリードを付けて、すぐそばに置いておくのもおすすめです。
    </p>
  </section>

  <section class="mb-14">
    <h2 class="mb-5 text-xl font-semibold text-zinc-800">雨の日は、どろんこです</h2>
    <p class="max-w-2xl text-sm leading-loose text-zinc-600">
      地面は芝生ではなく、森の土です。雨の日や雨上がりは、足もお腹も泥だらけになります。<br />
      それでも犬たちは、おかまいなしに走り回ります。タオルは多めにどうぞ。
    </p>
  </section>

  <section class="mb-14">
    <h2 class="mb-5 text-xl font-semibold text-zinc-800">愛犬と、同じテントで</h2>
    <Picture
      src={dogrunStay}
      formats={["avif", "webp"]}
      alt="ハンモックのそばで焚き火を眺める犬"
      loading="lazy"
      sizes="(max-width: 768px) 100vw, 36rem"
      class="mb-5 aspect-[3/2] w-full max-w-2xl object-cover"
    />
    <p class="max-w-2xl text-sm leading-loose text-zinc-600">
      焚き火のそばで足元に伏せて、夜は同じテントで眠る。<br />
      朝、ケージから出すと、また走り出します。
    </p>
  </section>

  <section class="mb-14">
    <h2 class="mb-5 text-xl font-semibold text-zinc-800">ほかの区画でも、犬と泊まれます</h2>
    <p class="max-w-2xl text-sm leading-loose text-zinc-600">
      ライトフォレストは、全サイト犬連れOKです。<br />
      犬の頭数・大きさ・犬種に制限はなく、料金もかかりません。<br />
      ドッグランサイト以外では、リードをお願いします。
    </p>
    <p class="mt-4 text-sm">
      <a href="/sites/" class="underline underline-offset-2 text-[color:var(--light-accent)] transition hover:opacity-80">
        サイトを選ぶ →
      </a>
    </p>
  </section>

  {/* 利用条件 */}
  <section class="mb-14">
    <h2 class="mb-5 text-xl font-semibold text-zinc-800">利用条件</h2>
    <dl class="divide-y divide-zinc-200 border-y border-zinc-200">
      {conditions.map((r) => (
        <div class="grid gap-1 py-4 sm:grid-cols-[12rem_1fr] sm:gap-6">
          <dt class="text-sm font-medium text-zinc-700">{r.label}</dt>
          <dd class="text-sm leading-loose text-zinc-600">{r.value}</dd>
        </div>
      ))}
    </dl>
  </section>

  {/* 予約導線 */}
  <section class="mb-14">
    <h2 class="mb-2 text-xl font-semibold text-zinc-800">予約する</h2>
    <p class="mb-5 text-sm leading-loose text-zinc-500">
      料金・空き状況は予約システムでご確認ください。
    </p>
    <p class="mb-4 text-lg tracking-wide text-zinc-800">{PLAN_PRICES[7]}</p>
    <a href={proxPlanUrl(7)}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center rounded-full bg-[color:var(--forest-600)] px-7 py-3 text-sm text-white shadow-sm transition hover:bg-[color:var(--forest-700)]"
     data-cta="reserve" data-cta-field="light">
      空き状況・予約はこちら ↗
    </a>
  </section>

  {/* 関連内部リンク */}
  <section class="mb-14">
    <h2 class="mb-5 text-xl font-semibold text-zinc-800">あわせて見る</h2>
    <ul class="space-y-3 text-sm">
      <li>
        <a href="/stay-light/" class="text-zinc-600 underline underline-offset-2 transition hover:text-zinc-800">ライトフォレストで過ごす一泊</a>
        <span class="ml-2 text-zinc-400">— 到着から翌朝までの流れ</span>
      </li>
      <li>
        <a href="/light-guide/" class="text-zinc-600 underline underline-offset-2 transition hover:text-zinc-800">ライトフォレスト 利用案内</a>
        <span class="ml-2 text-zinc-400">— 設備・サイズ別目安・利用ルール</span>
      </li>
      <li>
        <a href="/rental/" class="text-zinc-600 underline underline-offset-2 transition hover:text-zinc-800">レンタル</a>
        <span class="ml-2 text-zinc-400">— 手ぶらでも始められる</span>
      </li>
      <li>
        <a href="/access/" class="text-zinc-600 underline underline-offset-2 transition hover:text-zinc-800">アクセス</a>
        <span class="ml-2 text-zinc-400">— 行き方・駐車場</span>
      </li>
      <li>
        <a href="/sites/" class="text-zinc-600 underline underline-offset-2 transition hover:text-zinc-800">全サイズの実寸・設営例を見る</a>
      </li>
    </ul>
  </section>
</PageLayout>
