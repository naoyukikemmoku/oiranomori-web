---
import PageLayout from "../../../layouts/PageLayout.astro";

const TITLE = "ソロキャンプ｜里山パークおいらの森（栃木・那須烏山）";
const DESC =
	"隣を気にしない距離感のソロ向けサイト。ハンモック可否や場内の条件も掲載。栃木・那須烏山でひとりの森時間を。";
const URL = "https://oiranomori.jp/sites/solo/";

// 「あなたの人数なら、このサイズ」変換ブロック（light-guide の sizeGuide 構造を流用）
const sizeGuide = [
	{
		size: "SS",
		area: "20㎡未満",
		guide: "ソロテント1張り。通称ソロ区画。プライベート感重視。",
	},
	{
		size: "S",
		area: "20〜39㎡",
		guide: "小型テント1張り＋タープ。ゆったり張りたいソロに。",
	},
];

const experiences = [
	{
		h: "隣の気配が、遠い",
		body: "森に距離をもらう。区画の間に木立が入り、視線も音も遮られる。ひとりの時間が薄まらない。",
	},
	{
		h: "平日なら、もっと静かに",
		body: "平日ソロ限定の割引プランがあります。仕事を持ち込むワーケーションプランも平日ソロ向け。",
	},
];

// ハンモック可否は spots.json の区画メモ（desc）を正とする。
const hammockSites = [
	{ site: "区画11", note: "ハンモック最適。プライベート感あり、10番と貫通利用可。" },
	{ site: "オート19・20", note: "ハンモックは張りにくい（見通し重視の区画）。" },
	{ site: "オートA", note: "ハンモックは張りにくい。" },
];
---

<PageLayout title={TITLE} description={DESC} noindex={true}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": TITLE,
      "description": DESC,
      "url": URL,
      "isPartOf": {
        "@type": "WebSite",
        "name": "里山パークおいらの森",
        "url": "https://oiranomori.jp"
      }
    })} />
  </Fragment>

  {/* ページ見出し */}
  <div class="mb-10 border-b border-zinc-200 pb-8">
    <p class="text-xs tracking-[0.26em] text-zinc-400 uppercase">Solo</p>
    <h1 class="mt-3 text-3xl font-semibold text-zinc-800 md:text-4xl">ひとりの森時間</h1>
    <p class="mt-4 max-w-2xl text-sm leading-loose text-zinc-500">
      誰にも合わせなくていい一日。火を起こして、本を開いて、ただ森の音を聞く。
      ひとりで来るあなたのための区画があります。
    </p>
  </div>

  {/* あなたの人数なら、このサイズ */}
  <section class="mb-14">
    <h2 class="mb-2 text-xl font-semibold text-zinc-800">あなたなら、このサイズ</h2>
    <p class="mb-5 text-sm text-zinc-500">ソロ（2人以下）に合うのは SS・S。</p>
    <div class="overflow-x-auto border-y border-zinc-200">
      <table class="w-full min-w-[480px] text-sm">
        <thead>
          <tr class="border-b border-zinc-200 bg-zinc-50">
            <th class="px-4 py-3 text-left font-medium text-zinc-600">サイズ</th>
            <th class="px-4 py-3 text-left font-medium text-zinc-600">有効面積</th>
            <th class="px-4 py-3 text-left font-medium text-zinc-600">目安</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-zinc-100">
          {sizeGuide.map((s) => (
            <tr class="transition hover:bg-zinc-50">
              <td class="px-4 py-3 font-medium text-zinc-700">{s.size}</td>
              <td class="px-4 py-3 text-zinc-600">{s.area}</td>
              <td class="px-4 py-3 text-zinc-600">{s.guide}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-4 text-sm">
      <a href="/sites/" class="underline underline-offset-2 text-[color:var(--light-accent)] transition hover:opacity-80">
        全サイズの実寸・設営例を見る →
      </a>
    </p>
  </section>

  {/* 動的枠プレースホルダ（②③：サイズ別空き＋個別区画一覧） */}
  <section id="size-availability" class="mb-14">
    {/* TODO: client-fetch でサイズ別空き＋個別区画一覧。App handoff 後に実装 */}
  </section>

  {/* 体験 */}
  <section class="mb-14">
    <div class="grid gap-8 sm:grid-cols-2">
      {experiences.map((e) => (
        <div class="border-t border-zinc-200 pt-5">
          <h2 class="text-lg font-semibold text-zinc-800">{e.h}</h2>
          <p class="mt-3 text-sm leading-loose text-zinc-600">{e.body}</p>
        </div>
      ))}
    </div>
  </section>

  {/* ハンモック */}
  <section id="hammock" class="mb-14">
    <h2 class="mb-2 text-xl font-semibold text-zinc-800">ハンモックを吊る</h2>
    <p class="mb-5 text-sm leading-loose text-zinc-500">
      木と木の間隔で決まります。向く区画と、向かない区画があります。
    </p>
    <dl class="divide-y divide-zinc-200 border-y border-zinc-200">
      {hammockSites.map((h) => (
        <div class="grid gap-1 py-4 sm:grid-cols-[10rem_1fr] sm:gap-6">
          <dt class="text-sm font-medium text-zinc-700">{h.site}</dt>
          <dd class="text-sm leading-loose text-zinc-600">{h.note}</dd>
        </div>
      ))}
    </dl>
    <p class="mt-5 text-sm leading-loose text-zinc-600">
      本体を持っていなくても、DDハンモックを1,100円で借りられます。タープも同額です。
      <a href="/rental/" class="ml-1 underline underline-offset-2 text-[color:var(--light-accent)] transition hover:opacity-80">レンタル一覧を見る →</a>
    </p>
    <p class="mt-3 text-sm leading-loose text-zinc-600">
      区画ごとの位置関係は
      <a href="/lightforest-map/" class="underline underline-offset-2 text-[color:var(--light-accent)] transition hover:opacity-80">場内マップ</a>
      で確認できます。
    </p>
  </section>

  {/* ひとりで来るときの場内の条件 */}
  <section class="mb-14">
    <h2 class="mb-2 text-xl font-semibold text-zinc-800">ひとりで来るときの、場内の条件</h2>
    <p class="mb-5 text-sm leading-loose text-zinc-500">
      安全をお約束はできません。判断の材料になる事実だけ書きます。
    </p>
    <dl class="divide-y divide-zinc-200 border-y border-zinc-200">
      {[
        { label: "受付・管理棟", value: "9:00〜17:30。受付は管理棟で行います。" },
        { label: "管理人", value: "おいら家族が敷地内に常駐しています。受付時間外も人がいる環境です。" },
        { label: "トイレ", value: "水洗・洋式。男女各2室（新築）。" },
        { label: "水道・流し", value: "2か所（うち給湯器付き1か所）。水道水は飲用可。" },
        { label: "明かり", value: "場内に全域を照らす照明はありません。ヘッドライト等の携行を推奨します。" },
        { label: "連絡", value: "無料Wi-Fiあり。ソロ区画・オートA・オートBはエリア外です。" },
      ].map((r) => (
        <div class="grid gap-1 py-4 sm:grid-cols-[10rem_1fr] sm:gap-6">
          <dt class="text-sm font-medium text-zinc-700">{r.label}</dt>
          <dd class="text-sm leading-loose text-zinc-600">{r.value}</dd>
        </div>
      ))}
    </dl>
  </section>

  {/* 平日ソロ・ワーケーション */}
  <section class="mb-14">
    <h2 class="mb-2 text-xl font-semibold text-zinc-800">平日ソロ・ワーケーション</h2>
    <p class="mb-5 text-sm leading-loose text-zinc-500">
      平日ソロ限定のプランが2つあります。詳細と料金は利用案内のプラン表から。
    </p>
    <ul class="space-y-3 text-sm">
      <li>
        <a
          href="https://www.489pro-x.com/ja/s/oiranomori/search/?plans=21&show=plan"
          target="_blank"
          rel="noopener noreferrer"
          class="underline underline-offset-2 text-[color:var(--light-accent)] transition hover:opacity-80"
          data-cta="reserve"
          data-cta-field="light"
        >ソロ割りオートサイト ↗</a>
        <span class="ml-2 text-zinc-500">— 平日ソロ限定</span>
      </li>
      <li>
        <a
          href="https://www.489pro-x.com/ja/s/oiranomori/search/?plans=16&show=plan"
          target="_blank"
          rel="noopener noreferrer"
          class="underline underline-offset-2 text-[color:var(--light-accent)] transition hover:opacity-80"
          data-cta="reserve"
          data-cta-field="light"
        >ワーケーション ↗</a>
        <span class="ml-2 text-zinc-500">— 平日ソロ限定</span>
      </li>
    </ul>
  </section>

  {/* Deep への積極提案（ソロは適合者） */}
  <section class="mb-14">
    <div class="border-t border-zinc-200 pt-5">
      <h2 class="text-xl font-semibold text-zinc-800">もっと深い静けさを求める方へ</h2>
      <p class="mt-3 text-sm leading-loose text-zinc-600">
        18歳以上・1〜3名限定で、設備のない森を利用する<br />
        ディープフォレストもあります。
      </p>
      <p class="mt-4 text-sm">
        <a
          href="/deep/"
          class="underline underline-offset-2 text-[color:var(--light-accent)] transition hover:opacity-80"
          data-cta="solo-to-deep"
        >ディープフォレストを見る →</a>
      </p>
    </div>
  </section>

  {/* 予約導線 */}
  <section class="mb-14">
    <h2 class="mb-2 text-xl font-semibold text-zinc-800">予約する</h2>
    <p class="mb-5 text-sm leading-loose text-zinc-500">
      料金・空き状況は予約システムでご確認ください。平日ソロ向けの割引プランもあります。
    </p>
    <a href="https://www.489pro-x.com/ja/s/oiranomori/search/?plans=21&show=plan"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center rounded-full bg-[color:var(--forest-600)] px-7 py-3 text-sm text-white shadow-sm transition hover:bg-[color:var(--forest-700)]"
     data-cta="reserve" data-cta-field="light">
      空き状況・予約はこちら ↗
    </a>
  </section>

  {/* 関連内部リンク */}
  <section class="mb-14">
    <h2 class="mb-5 text-xl font-semibold text-zinc-800">あわせて見る</h2>
    <ul class="space-y-3 text-sm">
      <li>
        <a href="/light-guide/" class="text-zinc-600 underline underline-offset-2 transition hover:text-zinc-800">ライトフォレスト 利用案内</a>
        <span class="ml-2 text-zinc-400">— 設備・サイズ別目安・利用ルール</span>
      </li>
      <li>
        <a href="/rental/" class="text-zinc-600 underline underline-offset-2 transition hover:text-zinc-800">レンタル</a>
        <span class="ml-2 text-zinc-400">— 手ぶらでも始められる</span>
      </li>
    </ul>
  </section>
</PageLayout>
