---
import { Picture } from "astro:assets";
import soloHero from "../../../assets/images/sites_solo_hero.jpg";
import soloWorkation from "../../../assets/images/sites_solo_workation.jpg";
import { proxPlanUrl } from "../../../config/nav";
import PageLayout from "../../../layouts/PageLayout.astro";

const TITLE =
	"ソロキャンプ｜ひとりで焚き火と森の音を楽しむ林間サイト｜里山パークおいらの森（栃木）";
const DESC =
	"ひとりの時間が好きな人のソロキャンプに。静かな森で焚き火を眺め、雨音や森の音に耳を澄ます。焚き火は夜通しOK。女性ひとりでも安心。栃木県那須烏山市のキャンプ場。";
const URL = "https://oiranomori.jp/sites/solo/";

// 「あなたの人数なら、このサイズ」変換ブロック（light-guide の sizeGuide 構造を流用）
const sizeGuide = [
	{
		size: "SS",
		area: "20㎡未満",
		guide:
			"ソロテント1張り。通称ソロ区画。区画が小さいぶん、まわりとの距離が近すぎない場所を選べます。",
	},
	{
		size: "S",
		area: "20〜39㎡",
		guide: "小型テント1張り＋タープ。タープも張って、道具を広げたい人に。",
	},
];

const linkClass =
	"underline underline-offset-2 text-[color:var(--light-accent)] transition hover:opacity-80";

// ハンモック可否は spots.json の区画メモ（desc）を正とする。
const hammockSites = [
	{
		site: "区画11",
		note: "ハンモック最適。プライベート感あり、10番と貫通利用可。",
	},
	{
		site: "オート19・20",
		note: "ハンモックは張りにくい（見通し重視の区画）。",
	},
	{ site: "オートA", note: "ハンモックは張りにくい。" },
];
---

<PageLayout title={TITLE} description={DESC} lastUpdated="2026年10月">
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": TITLE,
      "description": DESC,
      "url": URL,
      "isPartOf": {
        "@type": "WebSite",
        "name": "里山パークおいらの森",
        "url": "https://oiranomori.jp"
      }
    })} />
  </Fragment>

  {/* ヒーロー */}
  <Picture
    src={soloHero}
    formats={["avif", "webp"]}
    alt="杉林のサイトで焚き火のそばに座るソロキャンパー"
    loading="eager"
    fetchpriority="high"
    sizes="(max-width: 768px) 100vw, 72rem"
    class="mb-10 aspect-[16/9] w-full object-cover"
  />

  {/* ページ見出し */}
  <div class="mb-10 border-b border-zinc-200 pb-8">
    <p class="text-xs tracking-[0.26em] text-zinc-400 uppercase">Solo</p>
    <h1 class="mt-3 text-3xl font-semibold leading-snug text-zinc-800 md:text-4xl">ひとりの時間を楽しむ、森のソロキャンプ</h1>
    <p class="mt-4 max-w-2xl text-sm leading-loose text-zinc-700">
      家族からも、家からも少し離れて、静かな森でひとりきり。<br />
      大好きなキャンプを、自分のペースで、好きなことだけ。<br />
      女性一人でも安心してお過ごしいただけます。
    </p>
    <div class="mt-6">
      <a href={proxPlanUrl(21)}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center rounded-full bg-[color:var(--forest-600)] px-7 py-3 text-sm text-white shadow-sm transition hover:bg-[color:var(--forest-700)]"
       data-cta="reserve" data-cta-field="light">
        空き状況・料金を見る ↗
      </a>
    </div>
  </div>

  <section class="mb-14">
    <h2 class="mb-5 text-xl font-semibold text-zinc-800">何をしても、しなくてもいい</h2>
    <p class="max-w-2xl text-sm leading-loose text-zinc-600">
      Wi-Fiで映画を観るのもいい（イヤホンでどうぞ。使えない区画は<a href="/light-guide/#wifi" class={linkClass}>利用案内でご確認ください</a>）。<br />
      寝てしまうのもいいし、ぼ〜っと焚き火を眺めるのもいい。<br />
      いくらお酒を飲んでも、タバコを吸っても、誰にも文句は言われません。
    </p>
  </section>

  <section class="mb-14">
    <h2 class="mb-5 text-xl font-semibold text-zinc-800">ひとりだから、聞こえる音</h2>
    <p class="max-w-2xl text-sm leading-loose text-zinc-600">
      ひとりでいると、普段は気づかない森の音がよく耳に入ります。<br />
      雨が降れば、テントを打つ雨音がよく聞こえて、それもまた乙なものです。
    </p>
  </section>

  <section class="mb-14">
    <h2 class="mb-5 text-xl font-semibold text-zinc-800">一晩中、焚き火を</h2>
    <p class="max-w-2xl text-sm leading-loose text-zinc-600">
      おいらの森では、消灯後は森が完全に静まり返ります。<br />
      それでも、焚き火だけは夜通しOK。<br />
      ひとりなら、静かな森で、ずっと火を眺めていられます。
    </p>
    <p class="mt-4 text-sm"><a href="/light-guide/#n-starry" class={linkClass}>夜の過ごし方を見る →</a></p>
  </section>

  <section class="mb-14">
    <h2 class="mb-5 text-xl font-semibold text-zinc-800">冬は、薪ストーブでお籠もり</h2>
    <p class="max-w-2xl text-sm leading-loose text-zinc-600">
      冬は薪ストーブを持ち込んで、テントにお籠もりするのもおすすめです。
    </p>
    <p class="mt-4 text-sm"><a href="/firewood/" class={linkClass}>おいらの薪 →</a></p>
  </section>

  <section class="mb-14">
    <h2 class="mb-5 text-xl font-semibold text-zinc-800">道具は、車に積みっぱなしで</h2>
    <p class="max-w-2xl text-sm leading-loose text-zinc-600">
      装備はできるだけ簡単に。車に積みっぱなしにして、いっぱい来てください。<br />
      日付を選べば手頃に泊まれますし、年間パスポートなら、別荘気分で通えます。
    </p>
    <p class="mt-4 text-sm"><a href="/passport/" class={linkClass}>年間パスポート・回数券 →</a></p>
  </section>

  {/* ひとりに合うサイズ */}
  <section class="mb-14">
    <h2 class="mb-2 text-xl font-semibold text-zinc-800">ひとりに合うサイズ</h2>
    <p class="mb-5 text-sm text-zinc-500">1人で使うなら SS・S。</p>
    <div class="overflow-x-auto border-y border-zinc-200">
      <table class="w-full min-w-[480px] text-sm">
        <thead>
          <tr class="border-b border-zinc-200 bg-zinc-50">
            <th class="px-4 py-3 text-left font-medium text-zinc-600">サイズ</th>
            <th class="px-4 py-3 text-left font-medium text-zinc-600">有効面積</th>
            <th class="px-4 py-3 text-left font-medium text-zinc-600">目安</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-zinc-100">
          {sizeGuide.map((s) => (
            <tr class="transition hover:bg-zinc-50">
              <td class="px-4 py-3 font-medium text-zinc-700">{s.size}</td>
              <td class="px-4 py-3 text-zinc-600">{s.area}</td>
              <td class="px-4 py-3 text-zinc-600">{s.guide}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-4 text-sm">
      <a href="/sites/" class="underline underline-offset-2 text-[color:var(--light-accent)] transition hover:opacity-80">
        全サイズの実寸・設営例を見る →
      </a>
    </p>
  </section>

  {/* 将来: サイズ別の空き状況＋個別区画一覧を client-fetch で描画する予定地点。
      実装までは DOM を生成しない（空セクションの余白を残さないため）。 */}

  {/* ハンモック */}
  <section id="hammock" class="mb-14">
    <h2 class="mb-2 text-xl font-semibold text-zinc-800">ハンモックを吊る</h2>
    <p class="mb-5 text-sm leading-loose text-zinc-500">
      木と木の間隔で決まります。向く区画と、向かない区画があります。
    </p>
    <dl class="divide-y divide-zinc-200 border-y border-zinc-200">
      {hammockSites.map((h) => (
        <div class="grid gap-1 py-4 sm:grid-cols-[10rem_1fr] sm:gap-6">
          <dt class="text-sm font-medium text-zinc-700">{h.site}</dt>
          <dd class="text-sm leading-loose text-zinc-600">{h.note}</dd>
        </div>
      ))}
    </dl>
    <p class="mt-5 text-sm leading-loose text-zinc-600">
      本体を持っていなくても、DDハンモックを1,100円で借りられます。タープも同額です。
      <a href="/rental/" class="ml-1 underline underline-offset-2 text-[color:var(--light-accent)] transition hover:opacity-80">レンタル一覧を見る →</a>
    </p>
    <p class="mt-3 text-sm leading-loose text-zinc-600">
      区画ごとの位置関係は
      <a href="/lightforest-map/" class="underline underline-offset-2 text-[color:var(--light-accent)] transition hover:opacity-80">場内マップ</a>
      で確認できます。
    </p>
  </section>

  {/* 平日ソロ・ワーケーション */}
  <section class="mb-14">
    <h2 class="mb-2 text-xl font-semibold text-zinc-800">平日ソロ・ワーケーション</h2>
    <Picture
      src={soloWorkation}
      formats={["avif", "webp"]}
      alt="夜の杉林でタープを張り焚き火を囲むソロサイト"
      loading="lazy"
      sizes="(max-width: 768px) 100vw, 26rem"
      class="mb-5 aspect-[4/5] w-full max-w-2xl object-cover"
    />
    <p class="mb-5 text-sm leading-loose text-zinc-500">
      平日ソロ限定のプランが2つあります。詳細と料金は、各プランのページでご確認ください。
    </p>
    <ul class="space-y-3 text-sm">
      <li>
        <a
          href={proxPlanUrl(21)}
          target="_blank"
          rel="noopener noreferrer"
          class="underline underline-offset-2 text-[color:var(--light-accent)] transition hover:opacity-80"
          data-cta="reserve"
          data-cta-field="light"
        >ソロ割りオートサイト ↗</a>
        <span class="ml-2 text-zinc-500">— 平日ソロ限定</span>
      </li>
      <li>
        <a
          href={proxPlanUrl(16)}
          target="_blank"
          rel="noopener noreferrer"
          class="underline underline-offset-2 text-[color:var(--light-accent)] transition hover:opacity-80"
          data-cta="reserve"
          data-cta-field="light"
        >ワーケーション ↗</a>
        <span class="ml-2 text-zinc-500">— 平日ソロ限定</span>
      </li>
    </ul>
  </section>

  {/* Deep への積極提案（ソロは適合者） */}
  <section class="mb-14">
    <div class="border-t border-zinc-200 pt-5">
      <h2 class="text-xl font-semibold text-zinc-800">もっと深い静けさを求める方へ</h2>
      <p class="mt-3 text-sm leading-loose text-zinc-600">
        18歳以上・1〜3名限定で、設備のない森を利用する<br />
        ディープフォレストもあります。
      </p>
      {/* ライトとは別商品。/stay-light/ と同じ行に並べず、Deep 専用の導線として分ける */}
      <div class="mt-4 flex flex-wrap gap-x-8 gap-y-3 text-sm">
        <a
          href="/deep/"
          class="underline underline-offset-2 text-[color:var(--light-accent)] transition hover:opacity-80"
          data-cta="solo-to-deep"
        >ディープフォレストを見る →</a>
        <a
          href="/stay-deep/"
          class="text-zinc-600 underline underline-offset-2 transition hover:text-zinc-800"
          data-cta="solo-to-stay-deep"
          data-cta-target="/stay-deep/"
        >ディープフォレストで過ごす一泊を見る →</a>
      </div>
    </div>
  </section>

  {/* 予約導線 */}
  <section class="mb-14">
    <h2 class="mb-2 text-xl font-semibold text-zinc-800">予約する</h2>
    <p class="mb-5 text-sm leading-loose text-zinc-500">
      料金・空き状況は予約システムでご確認ください。平日ソロ向けの割引プランもあります。
    </p>
    <a href={proxPlanUrl(21)}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center rounded-full bg-[color:var(--forest-600)] px-7 py-3 text-sm text-white shadow-sm transition hover:bg-[color:var(--forest-700)]"
     data-cta="reserve" data-cta-field="light">
      空き状況・予約はこちら ↗
    </a>
  </section>

  {/* 関連内部リンク */}
  <section class="mb-14">
    <h2 class="mb-5 text-xl font-semibold text-zinc-800">あわせて見る</h2>
    <ul class="space-y-3 text-sm">
      <li>
        <a href="/stay-light/" class="text-zinc-600 underline underline-offset-2 transition hover:text-zinc-800">ライトフォレストで過ごす一泊</a>
        <span class="ml-2 text-zinc-400">— 到着から翌朝までの流れ</span>
      </li>
      <li>
        <a href="/light-guide/" class="text-zinc-600 underline underline-offset-2 transition hover:text-zinc-800">ライトフォレスト 利用案内</a>
        <span class="ml-2 text-zinc-400">— 設備・サイズ別目安・利用ルール</span>
      </li>
      <li>
        <a href="/firewood/" class="text-zinc-600 underline underline-offset-2 transition hover:text-zinc-800">おいらの薪</a>
      </li>
      <li>
        <a href="/passport/" class="text-zinc-600 underline underline-offset-2 transition hover:text-zinc-800">年間パスポート・回数券</a>
      </li>
    </ul>
    <p class="mt-5 text-sm"><a href="/forest-day/" class={linkClass}>何もしない贅沢を森の中で →</a></p>
  </section>
</PageLayout>
