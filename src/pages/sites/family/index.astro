---
import { Picture } from "astro:assets";
import familyAuto from "../../../assets/images/sites_family_auto.jpg";
import familyHero from "../../../assets/images/sites_family_hero.jpg";
import familySpace from "../../../assets/images/sites_family_space.jpg";
import { PROX_SEARCH_URL } from "../../../config/nav";
import PageLayout from "../../../layouts/PageLayout.astro";

const TITLE =
	"ファミリーキャンプ｜子どもは虫とり、家族で焚き火を囲む林間サイト｜里山パークおいらの森（栃木）";
const DESC =
	"子ども連れの家族キャンプに。夏はカブトムシやクワガタ、トンボやチョウ。森で見つけた生き物に夢中になる子どもと、焚き火を囲む一泊。成人した子どもと広く使うならXLも。栃木県那須烏山市のキャンプ場。";
const URL = "https://oiranomori.jp/sites/family/";
const OG_IMAGE = new globalThis.URL(familyHero.src, Astro.site).href;

const sizeGuide = [
	{
		size: "M",
		area: "40〜59㎡",
		guide: "道具をコンパクトにまとめる3〜4人向け。",
	},
	{
		size: "L",
		area: "60〜79㎡",
		guide: "大型テントやタープを使う4〜6人向け。",
	},
	{
		size: "LL",
		area: "80〜109㎡",
		guide: "大型幕とタープに加え、区画内へ余白も残したい家族向け。",
	},
];

const insectSeasons = [
	{ season: "6月下旬〜7月中旬", insect: "クワガタムシ" },
	{ season: "7月下旬〜8月", insect: "カブトムシ" },
	{ season: "9月下旬", insect: "クワガタムシ" },
];

const linkClass =
	"underline underline-offset-2 text-[color:var(--light-accent)] transition hover:opacity-80";
const reserveClass =
	"inline-flex items-center justify-center rounded-full bg-[color:var(--forest-600)] px-7 py-3 text-sm text-white shadow-sm transition hover:bg-[color:var(--forest-700)]";
---

<PageLayout title={TITLE} description={DESC} ogImage={OG_IMAGE} lastUpdated="2026年10月">
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": TITLE,
      "description": DESC,
      "url": URL,
      "isPartOf": {
        "@type": "WebSite",
        "name": "里山パークおいらの森",
        "url": "https://oiranomori.jp"
      }
    })} />
  </Fragment>

  {/* ヒーロー */}
  <Picture
    src={familyHero}
    formats={["avif", "webp"]}
    alt="タープの下で焚き火を囲み食事をする家族と犬"
    loading="eager"
    fetchpriority="high"
    sizes="(max-width: 768px) 100vw, 72rem"
    class="mb-10 aspect-[16/9] w-full object-cover"
  />

  {/* ページ見出し */}
  <div class="mb-10 border-b border-zinc-200 pb-8">
    <p class="text-xs tracking-[0.26em] text-zinc-400 uppercase">Family</p>
    <h1 class="mt-3 text-3xl font-semibold leading-snug text-zinc-800 md:text-4xl">森で遊んで、火を囲む。家族のキャンプ</h1>
    <p class="mt-4 max-w-2xl text-sm leading-loose text-zinc-700">
      小さな子どもを連れた家族がたくさん来ます。年少さんから小学生くらいまでの子が中心で、中学生もいます。<br />
      大型遊具はありません。遊び道具は、森のほうにあります。
    </p>
    <div class="mt-6">
      <a href={PROX_SEARCH_URL} target="_blank" rel="noopener noreferrer" class={reserveClass} data-cta="reserve" data-cta-field="light">
        空き状況・料金を見る ↗
      </a>
    </div>
  </div>

  <section class="mb-14">
    <h2 class="mb-5 text-xl font-semibold text-zinc-800">子どもの一番人気は、虫とり</h2>
    <p class="mb-5 max-w-2xl text-sm leading-loose text-zinc-600">
      小学生くらいまでの子どもたちが、いちばん夢中になるのは昆虫採集です。
    </p>
    <div class="max-w-2xl border-y border-zinc-200">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-zinc-200 bg-zinc-50">
            <th scope="col" class="px-4 py-3 text-left font-medium text-zinc-600">時期</th>
            <th scope="col" class="px-4 py-3 text-left font-medium text-zinc-600">出会える虫</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-zinc-100">
          {insectSeasons.map((r) => (
            <tr>
              <td class="px-4 py-3 text-zinc-700">{r.season}</td>
              <td class="px-4 py-3 text-zinc-600">{r.insect}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-5 max-w-2xl text-sm leading-loose text-zinc-600">
      ノコギリクワガタやコクワガタ、カナブン、タマムシ、カミキリムシ、カマキリ、バッタ、セミ。オニヤンマやギンヤンマなどのトンボ、オオムラサキなどのチョウ、ナナフシ、きれいなフンコロガシも。<br />
      運がよければミヤマクワガタ、ごくまれにタガメに出会えることも。ホタルや、ムササビ・リスも暮らしています。とにかく、いろんなのがいます。
    </p>
    <p class="mt-4 text-sm"><a href="/light-guide/#insects" class={linkClass}>持ち帰りについて →</a></p>
  </section>

  <section class="mb-14">
    <h2 class="mb-5 text-xl font-semibold text-zinc-800">興味は、次から次へ</h2>
    <p class="max-w-2xl text-sm leading-loose text-zinc-600">
      子どもの興味は、次々に変わります。<br />
      「焚き火をやりたい」と言っていたのに、気づけばどこかで虫を探している。そんなものです。<br />
      大人の予定に付き合わせるより、子どもの「次はこれ」に付き合ってみてください。そのほうが、次のキャンプもきっと楽しくなります。
    </p>
    <p class="mt-4 max-w-2xl text-sm leading-loose text-zinc-600">
      子ども連れでの過ごし方は、利用案内にまとめています。<a href="/light-guide/#kids" class={`ml-1 ${linkClass}`}>→ お子さんと一緒に</a>
    </p>
    <Picture
      src={familySpace}
      formats={["avif", "webp"]}
      alt="木漏れ日が差す広い林間サイト"
      loading="lazy"
      sizes="(max-width: 768px) 100vw, 36rem"
      class="mt-8 aspect-[3/2] w-full max-w-2xl object-cover"
    />
  </section>

  <section class="mb-14">
    <h2 class="mb-5 text-xl font-semibold text-zinc-800">ごはんは、順番がコツ</h2>
    <p class="max-w-2xl text-sm leading-loose text-zinc-600">
      いつもは大人が最後に食べる焼きそばなどの締めを、最初に作って子どもに食べてもらいます。おなかが落ち着いて静かになったら、大人はゆっくりBBQを。<br />
      そのあとで子どもの大好きなウインナーを焼けば、おなかいっぱいで満足する子が多いです。
    </p>
  </section>

  <section class="mb-14">
    <h2 class="mb-5 text-xl font-semibold text-zinc-800">焼きマシュマロは、炭火で</h2>
    <p class="max-w-2xl text-sm leading-loose text-zinc-600">
      割りばしにマシュマロを刺して、BBQコンロの上で焼くだけ。簡単なので、子どもでも焼けます。<br />
      焚き火は火が強すぎて、焼きマシュマロにはちょっと向きません。
    </p>
  </section>

  {/* 家族に合うサイズ（表の中身は 12/1 の区分切り替えまで変えない） */}
  <section class="mb-14">
    <h2 class="mb-5 text-xl font-semibold text-zinc-800">家族に合うサイズ</h2>
    <div class="overflow-x-auto border-y border-zinc-200">
      <table class="w-full min-w-[480px] text-sm">
        <thead>
          <tr class="border-b border-zinc-200 bg-zinc-50">
            <th class="px-4 py-3 text-left font-medium text-zinc-600">サイズ</th>
            <th class="px-4 py-3 text-left font-medium text-zinc-600">有効面積</th>
            <th class="px-4 py-3 text-left font-medium text-zinc-600">目安</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-zinc-100">
          {sizeGuide.map((s) => (
            <tr class="transition hover:bg-zinc-50">
              <td class="px-4 py-3 font-medium text-zinc-700">{s.size}</td>
              <td class="px-4 py-3 text-zinc-600">{s.area}</td>
              <td class="px-4 py-3 text-zinc-600">{s.guide}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-5 max-w-2xl text-sm leading-loose text-zinc-600">
      子どもが成人していてテントを別に張る家族や、車3台で来る親子もいます。サイトを広く使いたいなら、XLも検討の価値があります。<a href="/sites/#size" class={`ml-1 ${linkClass}`}>→ サイズ別の広さを見る</a>
    </p>
    <Picture
      src={familyAuto}
      formats={["avif", "webp"]}
      alt="木立のサイトに設営したテントと横付けした白い車"
      loading="lazy"
      sizes="(max-width: 768px) 100vw, 36rem"
      class="mt-8 aspect-[3/2] w-full max-w-2xl object-cover"
    />
  </section>

  {/* 将来: サイズ別の空き状況＋個別区画一覧を client-fetch で描画する予定地点。
      実装までは DOM を生成しない（空セクションの余白を残さないため）。 */}

  <section class="mb-14">
    <h2 class="mb-5 text-xl font-semibold text-zinc-800">道具がなくても</h2>
    <p class="max-w-2xl text-sm leading-loose text-zinc-600">
      一式そろっていなくても始められます。足りないものは借りればいい。<a href="/rental/" class={`ml-1 ${linkClass}`}>→ レンタル</a>
    </p>
  </section>

  {/* 予約導線。該当プランID未確定のため全体検索（search/）へ着地 */}
  <section class="mb-14">
    <h2 class="mb-5 text-xl font-semibold text-zinc-800">予約する</h2>
    <a href={PROX_SEARCH_URL} target="_blank" rel="noopener noreferrer" class={reserveClass} data-cta="reserve" data-cta-field="light">
      空き状況と料金を確認する ↗
    </a>
  </section>

  {/* 関連内部リンク。Deep へは案内しない（ライト利用が前提の客層ページ） */}
  <section class="mb-14">
    <h2 class="mb-5 text-xl font-semibold text-zinc-800">あわせて見る</h2>
    <ul class="space-y-3 text-sm">
      <li>
        <a href="/stay-light/" class="text-zinc-600 underline underline-offset-2 transition hover:text-zinc-800">ライトフォレストで過ごす一泊</a>
        <span class="ml-2 text-zinc-400">— 到着から翌朝までの流れ</span>
      </li>
      <li>
        <a href="/light-guide/" class="text-zinc-600 underline underline-offset-2 transition hover:text-zinc-800">ライトフォレスト 利用案内</a>
        <span class="ml-2 text-zinc-400">— 設備・利用時間・利用ルール</span>
      </li>
      <li>
        <a href="/rental/" class="text-zinc-600 underline underline-offset-2 transition hover:text-zinc-800">レンタル</a>
        <span class="ml-2 text-zinc-400">— 手ぶらでも始められる</span>
      </li>
      <li>
        <a href="/access/" class="text-zinc-600 underline underline-offset-2 transition hover:text-zinc-800">アクセス</a>
        <span class="ml-2 text-zinc-400">— 行き方・駐車場</span>
      </li>
    </ul>
  </section>
</PageLayout>
