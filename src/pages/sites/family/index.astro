---
import PageLayout from "../../../layouts/PageLayout.astro";
import { PROX_SEARCH_URL } from "../../../config/nav";

const TITLE = "ファミリーキャンプ｜里山パークおいらの森（栃木）";
const DESC =
	"区画内に遊べる余白があり、トイレも近い。初めての家族キャンプにも。栃木・那須烏山のファミリー向けキャンプサイト。";
const URL = "https://oiranomori.jp/sites/family/";

const sizeGuide = [
	{ size: "M", area: "40〜59㎡", guide: "3〜4人：中型テント1張り＋タープ。" },
	{
		size: "L",
		area: "60〜79㎡",
		guide: "4〜6人：大型テント1〜2張り＋タープ。",
	},
	{
		size: "LL",
		area: "80〜109㎡",
		guide: "6人前後：大型テント＋タープ、子どもの遊ぶ余白あり。",
	},
];

const experiences = [
	{
		h: "区画の中に、遊べる余白",
		body: "テントを張っても、その外に余白が残る広さ。目の届く自分たちの区画の中で遊ばせられます。通路や他の区画は、走り回る場所ではありません。",
	},
	{
		h: "トイレが、近い",
		body: "水洗・洋式が近くにある区画を選べます。夜中も、子どもがいても、慌てない。",
	},
	{
		h: "道具がなくても",
		body: "一式そろわなくても始められます。足りないものは借りればいい。",
		linkHref: "/rental/",
		linkText: "レンタルを見る",
	},
	{
		h: "初めての家族キャンプでも",
		body: "管理人が常駐しています。困ったら聞ける距離に人がいる安心。",
	},
];
---

<PageLayout title={TITLE} description={DESC}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": TITLE,
      "description": DESC,
      "url": URL,
      "isPartOf": {
        "@type": "WebSite",
        "name": "里山パークおいらの森",
        "url": "https://oiranomori.jp"
      }
    })} />
  </Fragment>

  {/* ページ見出し */}
  <div class="mb-10 border-b border-zinc-200 pb-8">
    <p class="text-xs tracking-[0.26em] text-zinc-400 uppercase">Family</p>
    <h1 class="mt-3 text-3xl font-semibold text-zinc-800 md:text-4xl">家族で、気持ちよく</h1>
    <p class="mt-4 max-w-2xl text-sm leading-loose text-zinc-500">
      区画の中に遊べる余白があり、トイレも近い。
      初めての家族キャンプでも、落ち着いて過ごせます。
    </p>
  </div>

  {/* あなたの人数なら、このサイズ */}
  <section class="mb-14">
    <h2 class="mb-2 text-xl font-semibold text-zinc-800">あなたなら、このサイズ</h2>
    <p class="mb-5 text-sm text-zinc-500">家族（3〜6人）に合うのは M・L・LL。</p>
    <div class="overflow-x-auto border-y border-zinc-200">
      <table class="w-full min-w-[480px] text-sm">
        <thead>
          <tr class="border-b border-zinc-200 bg-zinc-50">
            <th class="px-4 py-3 text-left font-medium text-zinc-600">サイズ</th>
            <th class="px-4 py-3 text-left font-medium text-zinc-600">有効面積</th>
            <th class="px-4 py-3 text-left font-medium text-zinc-600">目安</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-zinc-100">
          {sizeGuide.map((s) => (
            <tr class="transition hover:bg-zinc-50">
              <td class="px-4 py-3 font-medium text-zinc-700">{s.size}</td>
              <td class="px-4 py-3 text-zinc-600">{s.area}</td>
              <td class="px-4 py-3 text-zinc-600">{s.guide}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-4 text-sm">
      <a href="/sites/" class="underline underline-offset-2 text-[color:var(--light-accent)] transition hover:opacity-80">
        全サイズの実寸・設営例を見る →
      </a>
    </p>
  </section>

  {/* 将来: サイズ別の空き状況＋個別区画一覧を client-fetch で描画する予定地点。
      実装までは DOM を生成しない（空セクションの余白を残さないため）。 */}

  {/* 体験 */}
  <section class="mb-14">
    <div class="grid gap-8 sm:grid-cols-2">
      {experiences.map((e) => (
        <div class="border-t border-zinc-200 pt-5">
          <h2 class="text-lg font-semibold text-zinc-800">{e.h}</h2>
          <p class="mt-3 text-sm leading-loose text-zinc-600">
            {e.body}
            {e.linkHref && (
              <a href={e.linkHref} class="ml-1 underline underline-offset-2 text-[color:var(--light-accent)] transition hover:opacity-80">
                {e.linkText} →
              </a>
            )}
          </p>
        </div>
      ))}
    </div>
  </section>

  {/* 場内の設備と、1日の流れ */}
  <section class="mb-14">
    <h2 class="mb-2 text-xl font-semibold text-zinc-800">場内の設備と、1日の流れ</h2>
    <p class="mb-5 text-sm leading-loose text-zinc-500">
      通常チェックインは12:00〜17:00です。前日夕方までに確認し、当日の空きに余裕がある場合は、9:00から無料でアーリーチェックインできます。
    </p>
    <dl class="divide-y divide-zinc-200 border-y border-zinc-200">
      {[
        { label: "12:00〜17:00", value: "通常チェックイン。17:00を過ぎると安全管理上、入場できません。" },
        { label: "9:00〜（条件付き）", value: "受付オープン。前日夕方までの確認と当日の空きに余裕がある場合、9:00から無料でアーリーチェックインできます。" },
        { label: "翌12:00", value: "チェックアウト。空きがあれば延長できる場合があります。" },
        { label: "トイレ", value: "水洗・洋式。男女各2室（新築）。" },
        { label: "炊事場", value: "水道・流しが2か所（うち給湯器付き1か所）。水道水は飲用可。洗剤・油・残飯は流せません。" },
        { label: "受付・売店", value: "9:00〜17:30。飲料と薪を販売。" },
        { label: "管理体制", value: "おいら家族が敷地内に常駐しています。受付時間外も人がいる環境です。" },
        { label: "シャワー", value: "場内にはありません。車で行ける温泉がいくつもあります。" },
      ].map((r) => (
        <div class="grid gap-1 py-4 sm:grid-cols-[10rem_1fr] sm:gap-6">
          <dt class="text-sm font-medium text-zinc-700">{r.label}</dt>
          <dd class="text-sm leading-loose text-zinc-600">{r.value}</dd>
        </div>
      ))}
    </dl>
  </section>

  {/* 周辺と自然環境 */}
  <section class="mb-14">
    <h2 class="mb-2 text-xl font-semibold text-zinc-800">温泉・買い出し・もしものとき</h2>
    <p class="mb-5 text-sm leading-loose text-zinc-500">
      場内にシャワーはありません。そのぶん、温泉とセットで組むと一日が気持ちよく収まります。
    </p>
    <ul class="space-y-3 text-sm leading-loose text-zinc-600">
      <li>温泉：道の駅たかねざわ 元気あっぷむらが最寄り。喜連川方面には美肌の湯もあります。</li>
      <li>買い出し：かましん大金店、近くにセブン-イレブン 那須烏山大金店。</li>
      <li>医療機関・緊急連絡先を含む周辺情報は、周辺マップにまとめています。</li>
    </ul>
    <p class="mt-4 text-sm">
      <a href="/map/" class="underline underline-offset-2 text-[color:var(--light-accent)] transition hover:opacity-80">
        周辺マップを見る →
      </a>
    </p>
    <h3 class="mt-8 text-lg font-semibold text-zinc-800">自然環境と虫</h3>
    <p class="mt-3 text-sm leading-loose text-zinc-600">
      里山の森なので、季節によって蚊・ブヨ・蜂、夏にはカブトムシやクワガタもいます。
      虫除けと、肌の出にくい服装を用意してください。虫が苦手なお子さんがいる場合は、時期を選ぶと過ごしやすくなります。
    </p>
  </section>

  {/* 楽しみ方・事前に知っておきたいこと（トーンガイド §4・§5 準拠：
      読み手を評価せず、「ない」は代わりにあるものとセットで書く） */}
  <section class="mb-14">
    <h2 class="mb-2 text-xl font-semibold text-zinc-800">この森で気持ちよく過ごすために</h2>
    <p class="mb-5 text-sm leading-loose text-zinc-500">
      来てからの発見が、いい方向に転がるように。先に書いておきます。
    </p>
    <div class="grid gap-10 sm:grid-cols-2">
      <div>
        <h3 class="border-b border-zinc-200 pb-3 text-base font-semibold text-zinc-800">楽しみ方が合う方</h3>
        <ul class="mt-4 space-y-3 text-sm leading-loose text-zinc-600">
          {[
            "森の中で、静かに過ごしたい",
            "焚き火や自然そのものを楽しみにしている",
            "道具を広げて、自分たちのペースで過ごしたい",
            "初めてで、聞ける相手が近くにいると心強い",
          ].map((t) => <li class="flex items-start gap-3"><span class="mt-2 h-px w-3 shrink-0 bg-zinc-300"></span><span>{t}</span></li>)}
        </ul>
      </div>
      <div>
        <h3 class="border-b border-zinc-200 pb-3 text-base font-semibold text-zinc-800">先に知っておきたいこと</h3>
        <dl class="mt-4 space-y-4 text-sm leading-loose text-zinc-600">
          <div>
            <dt class="font-medium text-zinc-700">シャワーは場内にありません</dt>
            <dd class="mt-1">
              その代わり、車で行ける温泉がいくつもあります。最寄りは道の駅たかねざわ 元気あっぷむら。
            </dd>
          </div>
          <div>
            <dt class="font-medium text-zinc-700">大型遊具はありません</dt>
            <dd class="mt-1">
              遊び道具は森のほうにあります。木立、落ち葉、虫。区画の中に、遊べる余白も残ります。
            </dd>
          </div>
          <div>
            <dt class="font-medium text-zinc-700">里山なので、虫がいます</dt>
            <dd class="mt-1">
              季節によって蚊やブヨ、夏にはカブトムシやクワガタも。虫除けと、肌の出にくい服装があると快適です。
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  {/* 予約導線 */}
  <section class="mb-14">
    <h2 class="mb-2 text-xl font-semibold text-zinc-800">予約する</h2>
    <p class="mb-5 text-sm leading-loose text-zinc-500">
      料金・空き状況は予約システムでご確認ください。
    </p>
    <a href={PROX_SEARCH_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center rounded-full bg-[color:var(--forest-600)] px-7 py-3 text-sm text-white shadow-sm transition hover:bg-[color:var(--forest-700)]"
     data-cta="reserve" data-cta-field="light">
      空き状況・予約はこちら ↗
    </a>
    {/* 該当プランID未確定のため全体検索（search/）へ着地。ID確定後に proxPlanUrl(id) 形式へ差し替える */}
  </section>

  {/* 関連内部リンク */}
  <section class="mb-14">
    <h2 class="mb-5 text-xl font-semibold text-zinc-800">あわせて見る</h2>
    <ul class="space-y-3 text-sm">
      <li>
        <a href="/light-guide/" class="text-zinc-600 underline underline-offset-2 transition hover:text-zinc-800">ライトフォレスト 利用案内</a>
        <span class="ml-2 text-zinc-400">— 設備・サイズ別目安・利用ルール</span>
      </li>
      <li>
        <a href="/rental/" class="text-zinc-600 underline underline-offset-2 transition hover:text-zinc-800">レンタル</a>
        <span class="ml-2 text-zinc-400">— 手ぶらでも始められる</span>
      </li>
      <li>
        <a href="/access/" class="text-zinc-600 underline underline-offset-2 transition hover:text-zinc-800">アクセス</a>
        <span class="ml-2 text-zinc-400">— 行き方・駐車場</span>
      </li>
    </ul>
  </section>
</PageLayout>
