---
import { Picture } from "astro:assets";
import sitesHero from "../../assets/images/sites_hero.jpg";
import thumbDogrun from "../../assets/images/sites_thumb_dogrun.jpg";
import thumbDuo from "../../assets/images/sites_thumb_duo.jpg";
import thumbFamily from "../../assets/images/sites_thumb_family.jpg";
import thumbSolo from "../../assets/images/sites_thumb_solo.jpg";
import { PROX_SEARCH_URL } from "../../config/nav";
import PageLayout from "../../layouts/PageLayout.astro";

const TITLE = "ライトフォレストのサイトを選ぶ｜里山パークおいらの森";
const DESC =
	"全48区画のライトフォレスト。人数・過ごし方と、車の横付けや電源などの条件から、あなたに合う区画を選べます。栃木・那須烏山のキャンプ場。";
const URL = "https://oiranomori.jp/sites/";

// ページ内目次。セクションの並びと一致させる。
const toc = [
	{ href: "#audience", label: "人数・過ごし方から選ぶ" },
	{ href: "#gear", label: "設営するテントで選ぶ" },
	{ href: "#conditions", label: "条件から選ぶ" },
	{ href: "#size", label: "サイズ別の広さ" },
	{ href: "#map", label: "場内マップで選ぶ" },
	{ href: "#notes", label: "選ぶ前に知っておきたいこと" },
	{ href: "#price", label: "料金の仕組み" },
];

// 人数・過ごし方から選ぶ（客層ページへの入口）
const audienceCards = [
	{
		href: "/sites/solo/",
		label: "ソロ",
		size: "SS・S",
		img: thumbSolo,
		alt: "林間のソロ区画に張った小型テント",
		copy: "小さく張るか、タープまで広げるか。ひとりに合う広さと場内環境を確認できます。",
	},
	{
		href: "/sites/duo/",
		label: "デュオ・カップル",
		size: "S・M",
		img: thumbDuo,
		alt: "木立の中にテントとハンモックを張ったサイト",
		copy: "コンパクトに過ごすS、ゆったり使うM。2人の道具量から選べます。",
	},
	{
		href: "/sites/family/",
		label: "ファミリー",
		size: "M・L・LL",
		img: thumbFamily,
		alt: "石積みの区画に大型テントとタープを設営した秋の林間サイト",
		copy: "テント、タープ、車と、区画内に残したい余白から選びます。",
	},
	{
		href: "/sites/group/",
		label: "グループ・ソログル・貸切",
		size: "LL・XL・貸切",
		img: null,
		alt: "",
		copy: "大型幕、複数テント、隣接区画、貸切を分けて確認できます。",
	},
	{
		href: "/sites/dogrun/",
		label: "ドッグラン",
		size: "専用1区画",
		img: thumbDogrun,
		alt: "秋のキャンプサイトで飼い主になでられる大型犬",
		copy: "柵内約400㎡を1日1組で利用する、犬連れ専用のサイトです。",
	},
];

// 設営するものから選ぶ（仕様書 2-5）。サイズ記号より先に道具量から入る導線。
const gearRoutes = [
	{
		label: "小型テントのみ",
		body: "ソロテント1張りを中心に、荷物を小さくまとめる使い方。",
		size: "SS・S",
		href: "/sites/solo/",
		linkText: "ソロ向けを見る",
	},
	{
		label: "テント＋タープ",
		body: "寝る場所と、食事や焚き火の場所を分けたい使い方。",
		size: "S・M",
		href: "/sites/duo/",
		linkText: "デュオ向けを見る",
	},
	{
		label: "大型テント＋タープ",
		body: "2ルームや大型幕に加え、区画内へ余白も残したい使い方。",
		size: "L・LL",
		href: "/sites/family/",
		linkText: "ファミリー向けを見る",
	},
	{
		label: "複数のテント",
		body: "各自のテントを並べる場合は、XLまたは隣接区画を検討します。",
		size: "XL・連結",
		href: "/sites/group/",
		linkText: "グループ向けを見る",
	},
	{
		label: "ハンモック",
		body: "木の位置と間隔が合う区画を選ぶ必要があります。",
		size: "要確認",
		href: "/sites/solo/#hammock",
		linkText: "ハンモックの条件",
	},
];

// サイト選びに影響する共通条件だけを置く。
// 設備・利用時間・ルールの全文は /light-guide/ を正本とし、ここでは複製しない。
const commonNotes = [
	"場内にシャワーはありません。入浴は周辺の温泉を利用します。",
	"ごみは灰以外すべて持ち帰りです。分別袋をご持参ください。",
	"夜は暗いため、移動用のライトを人数分ご用意ください。",
	"地面は土で、雨天時はぬかるむことがあります。",
	"林間のため、季節に応じた虫対策が必要です。",
];

// 条件から選ぶ。事実は light-guide（設備・サイト種別）を正とする。
const conditions = [
	{
		label: "車を横付けしたい",
		body: "オートサイトなら区画内に車を乗り入れ・横付けできます。全37区画。サイト料金に車両1台分が含まれます。",
		// サイト種別の説明は本ページと往復になるため、位置確認に意味のある場内マップへ送る。
		href: "/light-guide/#map",
		linkText: "場内マップで位置を見る",
	},
	{
		label: "ハンモックを使いたい",
		body: "木立の間隔が合う区画があります。区画11はハンモック最適、オートAは向きません。",
		href: "/sites/solo/#hammock",
		linkText: "ハンモックの条件",
	},
	{
		label: "AC電源を使いたい",
		body: "有料オプション・要予約。600Wまで。オート1・2・3・4・17・20・32〜36／オートE／ドッグランサイトが対応します。",
		href: "/light-guide/",
		linkText: "設備一覧を見る",
	},
	{
		label: "トイレとの距離を重視したい",
		body: "水洗・洋式、男女各2室（新築）。近い区画は場内マップで位置関係を確認できます。",
		href: "/light-guide/#map",
		linkText: "場内マップで見る",
	},
	{
		label: "大型テントを設営したい",
		body: "80㎡以上の LL・XL なら超大型テント＋タープも収まります。",
		href: "/sites/group/",
		linkText: "大人数向けを見る",
	},
	{
		label: "複数区画を隣接して使いたい",
		body: "隣り合う区画を連結して使えます。オートDは連結すると場内で最も広く取れます。",
		href: "/sites/group/",
		linkText: "連結・貸切を見る",
	},
];

// サイズ実寸。本ページを正本とする（light-guide からは本ページへ誘導）。
const sizeGuide = [
	{
		size: "XL",
		area: "110㎡以上",
		guide: "10人以上：超大型テント＋タープ、車3台＋ソロテント3張り",
	},
	{
		size: "LL",
		area: "80〜109㎡",
		guide: "6〜8人：超大型テント1張り＋タープ、ソロテント数張り",
	},
	{ size: "L", area: "60〜79㎡", guide: "4〜6人：大型テント1〜2張り＋タープ" },
	{ size: "M", area: "40〜59㎡", guide: "2〜4人：中型テント1張り＋タープ" },
	{ size: "S", area: "20〜39㎡", guide: "1〜2人：小型テント1張り＋タープ" },
	{
		size: "SS",
		area: "20㎡未満",
		guide: "1人：ソロテント1張り。通称ソロ区画。プライベート感重視。",
	},
];
---

{/* ライトフォレストのサイト選択ハブ。旧URLの301受け皿かつ検索入口。
    本ページと客層ページ5件（solo/duo/family/group/dogrun）はいずれも index 対象。
    サイズの実寸・比較は本ページを正本とし、客層ページからはここへリンクする。 */}
<PageLayout title={TITLE} description={DESC}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": TITLE,
      "description": DESC,
      "url": URL,
      "isPartOf": {
        "@type": "WebSite",
        "name": "里山パークおいらの森",
        "url": "https://oiranomori.jp"
      }
    })} />
  </Fragment>

  {/* ヒーロー。木立・高低差・設営後の区画を一度に見せる */}
  <Picture
    src={sitesHero}
    formats={["avif", "webp"]}
    alt="木立の間に複数のテントが並ぶライトフォレストの林間サイト"
    loading="eager"
    fetchpriority="high"
    widths={[768, 1280, 1920, 2560, 3200]}
    sizes="100vw"
    class="full-bleed mb-10 object-cover aspect-[16/9] sm:aspect-[2.6/1]"
  />

  {/* ページ見出し */}
  <div class="mb-10 border-b border-zinc-200 pb-8">
    <p class="text-xs tracking-[0.26em] text-zinc-400 uppercase">Light Forest Sites</p>
    <h1 class="mt-3 text-3xl font-semibold text-zinc-800 md:text-4xl">ライトフォレストのサイトを選ぶ</h1>
    <p class="mt-4 max-w-2xl text-sm leading-loose text-zinc-500">
      木立の間に、それぞれ広さや形の違うサイトがあります。
      誰と来るか、何を張るか、外せない条件は何か。順に確かめながら、自分に合う場所を選んでください。
    </p>
    <p class="mt-4 max-w-2xl text-sm leading-loose text-zinc-500">
      このページでは、受付や水洗トイレ、炊事場のあるライトフォレスト全48区画をご案内します。
      ディープフォレストは、設備や利用条件の異なる別のフィールドです。
    </p>

    {/* ページ内目次。長いページのため、最初に全体像と飛び先を示す。 */}
    <nav class="mt-7 flex flex-wrap gap-2.5 text-sm" aria-label="このページの目次">
      {toc.map((t) => (
        <a
          href={t.href}
          class="rounded-full border border-zinc-300 px-4 py-1.5 text-zinc-600 transition hover:border-[color:var(--light-accent)] hover:text-[color:var(--light-accent)]"
        >
          {t.label}
        </a>
      ))}
    </nav>
  </div>

  {/* 1. 人数・過ごし方から選ぶ
      白いカードUI・枠線・影は使わない（AGENTS.md 禁忌事項）。
      背景になじむフラットなリンク一覧とし、区切り線・余白・字組みで階層を作る。 */}
  <section id="audience" class="mb-16 scroll-mt-24">
    <h2 class="mb-2 text-xl font-semibold text-zinc-800">人数・過ごし方から選ぶ</h2>
    <p class="mb-6 max-w-2xl text-sm leading-loose text-zinc-500">何人で、どう過ごすか。それだけ決まっていれば選べます。</p>
    <ul class="divide-y divide-zinc-200 border-y border-zinc-200 sm:grid sm:grid-cols-2 sm:gap-x-12 sm:divide-y-0">
      {audienceCards.map((c) => (
        <li class="sm:border-b sm:border-zinc-200">
          <a
            href={c.href}
            class="group block py-6 transition"
            data-cta="sites-audience"
            data-cta-target={c.href}
          >
            <span class="flex flex-wrap items-baseline gap-x-3">
              <span class="text-lg font-semibold text-zinc-800 underline decoration-zinc-300 underline-offset-4 transition group-hover:text-[color:var(--light-accent)] group-hover:decoration-[color:var(--light-accent)]">{c.label}</span>
              <span class="text-xs tracking-[0.14em] text-zinc-400">{c.size}</span>
            </span>
            {c.img ? (
              <Picture
                src={c.img}
                formats={["avif", "webp"]}
                alt={c.alt}
                loading="lazy"
                sizes="(max-width: 640px) 100vw, 22rem"
                class="mt-4 aspect-[4/3] w-full object-cover"
              />
            ) : (
              <span class="mt-4 flex aspect-[4/3] w-full items-center justify-center border border-dashed border-zinc-300 bg-zinc-50">
                <span class="text-xs tracking-[0.16em] text-zinc-400">写真 準備中</span>
              </span>
            )}
            <span class="mt-3 block text-sm leading-loose text-zinc-600">{c.copy}</span>
            <span class="mt-3 inline-flex items-center gap-1.5 text-sm text-[color:var(--light-accent)] underline underline-offset-4 transition group-hover:opacity-80">
              {c.label}のサイトを見る
              <span aria-hidden="true">→</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {/* 2. 設営するものから選ぶ。サイズ記号より先に「何を張るか」で絞る導線 */}
  <section id="gear" class="mb-16 scroll-mt-24">
    <h2 class="mb-2 text-xl font-semibold text-zinc-800">設営するテントで選ぶ</h2>
    <p class="mb-6 max-w-2xl text-sm leading-loose text-zinc-500">
      同じ人数でも、テントの大きさやタープの有無で必要な広さは変わります。サイズ記号より先に、持っていく道具から考えてください。
    </p>
    <ul class="divide-y divide-zinc-200 border-y border-zinc-200 sm:grid sm:grid-cols-2 sm:gap-x-12 sm:divide-y-0">
      {gearRoutes.map((g) => (
        <li class="sm:border-b sm:border-zinc-200">
          <div class="py-6">
            <p class="flex flex-wrap items-baseline gap-x-3">
              <span class="text-lg font-semibold text-zinc-800">{g.label}</span>
              <span class="text-xs tracking-[0.14em] text-zinc-400">{g.size}</span>
            </p>
            {/* 写真は別途選定。枠だけ先に確保する。 */}
            <span class="mt-4 flex aspect-[4/3] w-full items-center justify-center border border-dashed border-zinc-300 bg-zinc-50">
              <span class="text-xs tracking-[0.16em] text-zinc-400">写真 準備中</span>
            </span>
            <p class="mt-3 text-sm leading-loose text-zinc-600">{g.body}</p>
            <p class="mt-3">
              <a
                href={g.href}
                class="inline-flex items-center gap-1.5 text-sm text-[color:var(--light-accent)] underline underline-offset-4 transition hover:opacity-80"
                data-cta="sites-gear"
                data-cta-target={g.href}
              >
                {g.linkText}
                <span aria-hidden="true">→</span>
              </a>
            </p>
          </div>
        </li>
      ))}
    </ul>
    <p class="mt-5 max-w-2xl text-sm leading-loose text-zinc-600">
      テント・タープの寸法や張り綱の取り方によって、同じサイズ表記でも収まり方が変わります。大型幕や特殊な形状は、予約前に実寸をご確認ください。
    </p>
  </section>

  {/* 3. 条件から選ぶ */}
  <section id="conditions" class="mb-16 scroll-mt-24">
    <h2 class="mb-2 text-xl font-semibold text-zinc-800">条件から選ぶ</h2>
    <p class="mb-5 max-w-2xl text-sm leading-loose text-zinc-500">
      外せない条件がある場合は、先に確認してください。すべての区画が同じ設備・形状ではありません。
    </p>
    <dl class="divide-y divide-zinc-200 border-y border-zinc-200">
      {conditions.map((c) => (
        <div class="grid gap-2 py-5 sm:grid-cols-[14rem_1fr] sm:gap-6">
          <dt class="text-sm font-semibold text-zinc-800">{c.label}</dt>
          <dd class="text-sm leading-loose text-zinc-600">
            {c.body}
            <a
              href={c.href}
              class="ml-1 whitespace-nowrap text-[color:var(--light-accent)] underline underline-offset-4 transition hover:opacity-80"
            >
              {c.linkText} →
            </a>
          </dd>
        </div>
      ))}
    </dl>
  </section>

  {/* 4. サイズ別の実寸・設営例 */}
  <section id="size" class="mb-16 scroll-mt-24">
    <h2 class="mb-2 text-xl font-semibold text-zinc-800">サイズ別の広さと設営例</h2>
    <p class="mb-5 max-w-2xl text-sm leading-loose text-zinc-500">
      人数はあくまで目安です。実際には、テント、タープ、車、張り綱まで含めて判断してください。オートサイトの有効面積は、車を置く部分を除いた広さです。
    </p>
    <div class="overflow-x-auto border-y border-zinc-200">
      <table class="w-full min-w-[520px] text-sm">
        <thead>
          <tr class="border-b border-zinc-200 bg-zinc-50">
            <th scope="col" class="px-4 py-3 text-left font-medium text-zinc-600">サイズ</th>
            <th scope="col" class="px-4 py-3 text-left font-medium text-zinc-600">有効面積</th>
            <th scope="col" class="px-4 py-3 text-left font-medium text-zinc-600">設営例の目安</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-zinc-100">
          {sizeGuide.map((s) => (
            <tr class="transition hover:bg-zinc-50">
              <th scope="row" class="px-4 py-3 text-left font-medium text-zinc-700">{s.size}</th>
              <td class="px-4 py-3 text-zinc-600">{s.area}</td>
              <td class="px-4 py-3 text-zinc-600">{s.guide}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-5 max-w-2xl text-sm leading-loose text-zinc-600">
      迷ったときは、人数だけでなく「何を張るか」と「区画内にどれだけ余白を残したいか」で、一つ上のサイズも比較してください。
    </p>
  </section>

  {/* 5. 場内マップ。広さだけでなく位置で選ぶ視点を足す */}
  <section id="map" class="mb-16 scroll-mt-24">
    <h2 class="mb-2 text-xl font-semibold text-zinc-800">広さだけでなく、場所で選ぶ</h2>
    <p class="mb-6 max-w-2xl text-sm leading-loose text-zinc-500">
      トイレや炊事場までの距離、隣接区画との関係、車の進入方向も、使い勝手を左右します。候補のサイズが決まったら、場内マップで位置を確認してください。
    </p>
    <a
      href="/light-guide/#map"
      class="group block"
      data-cta="sites-map"
    >
      <img
        src="/images/light-field-map.png"
        alt="ライトフォレストの場内マップ。区画の配置とトイレ・炊事場の位置がわかる"
        width="842"
        height="595"
        loading="lazy"
        decoding="async"
        class="w-full border border-zinc-200 transition group-hover:opacity-90"
      />
      <span class="mt-3 inline-flex items-center gap-1.5 text-sm text-[color:var(--light-accent)] underline underline-offset-4 transition group-hover:opacity-80">
        利用案内の場内マップを見る
        <span aria-hidden="true">→</span>
      </span>
    </a>
  </section>

  {/* 6. 選ぶ前に知っておく共通条件。
      サイト選びに影響する条件だけに絞る。設備一覧・利用ルールの全文は
      /light-guide/ を正本とし、ここで複製しない（AGENTS.md §0 情報は1層だけ）。 */}
  <section id="notes" class="mb-16 scroll-mt-24">
    <h2 class="mb-2 text-xl font-semibold text-zinc-800">選ぶ前に知っておきたいこと</h2>
    <p class="mb-5 max-w-2xl text-sm leading-loose text-zinc-500">
      サイト選びに影響する条件だけを、ここで先に確認します。設備の詳細、利用時間、ルールは利用案内にまとめています。
    </p>
    <ul class="space-y-3 text-sm leading-loose text-zinc-600">
      {commonNotes.map((n) => (
        <li class="flex items-start gap-3">
          <span class="mt-3 h-px w-3 shrink-0 bg-zinc-300"></span>
          <span>{n}</span>
        </li>
      ))}
    </ul>
    <p class="mt-5 text-sm">
      <a
        href="/light-guide/"
        class="inline-flex items-center gap-1.5 text-[color:var(--light-accent)] underline underline-offset-4 transition hover:opacity-80"
        data-cta="sites-to-light-guide"
      >
        設備・利用時間・ルールを詳しく見る →
      </a>
    </p>
  </section>

  {/* 7. 料金の仕組み。総額の代表例は子ども料金・対象日のサイト料金確定後に追加する。
      推測値は載せない。 */}
  <section id="price" class="mb-16 scroll-mt-24">
    <h2 class="mb-2 text-xl font-semibold text-zinc-800">料金は、人数とサイトで決まります</h2>
    <p class="mb-5 max-w-2xl text-sm leading-loose text-zinc-500">
      宿泊料金は、利用人数に応じた料金と、日付・サイトサイズによって変わるサイト料金の合計です。
      追加の車両やAC電源などを使う場合は、オプション料金が加わります。
    </p>
    <p class="border-y border-zinc-200 py-5 text-sm leading-loose text-zinc-700">
      人数料金　＋　日付・サイズ別のサイト料金　＋　追加車両・電源等のオプション
    </p>
    <p class="mt-5">
      <a
        href="/reservation-guide/#price"
        class="inline-flex items-center gap-1.5 text-sm text-[color:var(--light-accent)] underline underline-offset-4 transition hover:opacity-80"
        data-cta="sites-to-price"
      >
        料金の決まり方を詳しく見る
        <span aria-hidden="true">→</span>
      </a>
    </p>
  </section>

  {/* 8. ライトの一泊への補助導線。サイト比較の途中には置かず、料金説明の後に短く置く */}
  <section class="mb-14">
    <h2 class="mb-2 text-xl font-semibold text-zinc-800">選んだサイトで、どんな一泊を過ごすか</h2>
    <p class="mb-5 max-w-2xl text-sm leading-loose text-zinc-500">
      チェックインして設営し、森の夜を過ごし、朝に片付けて帰るまで。ライトフォレストでの一泊を、時間の流れに沿って紹介します。
    </p>
    <p class="text-sm">
      <a
        href="/stay-light/"
        class="inline-flex items-center gap-1.5 text-[color:var(--light-accent)] underline underline-offset-4 transition hover:opacity-80"
        data-cta="sites-to-stay-light"
        data-cta-target="/stay-light/"
      >
        ライトフォレストで過ごす一泊を見る →
      </a>
    </p>
  </section>

  {/* 9. ディープフォレスト（別商品の補助導線。選択ゲートにはしない） */}
  <section class="mb-14">
    <h2 class="mb-2 text-xl font-semibold text-zinc-800">設備のあるライトとは、別の森もあります</h2>
    <p class="mb-5 max-w-2xl text-sm leading-loose text-zinc-500">
      ディープフォレストは、場所非公開、18歳以上、1〜3名限定。水道や電源、売店のない森で過ごす、ライトフォレストとは別条件のフィールドです。
      ライトの上級版ではなく、求める過ごし方が違う方のための選択肢です。
    </p>
    <div class="flex flex-wrap gap-x-8 gap-y-3 text-sm">
      <a
        href="/deep/"
        class="inline-flex items-center gap-1.5 text-[color:var(--light-accent)] underline underline-offset-4 transition hover:opacity-80"
        data-cta="sites-to-deep"
      >
        ディープフォレストを見る →
      </a>
      <a
        href="/stay-deep/"
        class="text-zinc-700 underline underline-offset-4 transition hover:text-zinc-900"
        data-cta="sites-to-stay-deep"
        data-cta-target="/stay-deep/"
      >
        ディープフォレストで過ごす一泊を見る →
      </a>
    </div>
  </section>

  {/* 10. 予約CTA */}
  <section class="mb-14">
    <h2 class="mb-2 text-xl font-semibold text-zinc-800">日付ごとの空き状況と料金を見る</h2>
    <p class="mb-6 max-w-2xl text-sm leading-loose text-zinc-500">
      利用日と人数を入力すると、その日に予約できるプランと料金が表示されます。サイトの候補が決まったら、予約システムで確認してください。
    </p>
    <div class="flex flex-wrap items-center gap-x-8 gap-y-4">
      <a
        href={PROX_SEARCH_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center rounded-full bg-[color:var(--forest-600)] px-7 py-3 text-sm text-white shadow-sm transition hover:bg-[color:var(--forest-700)]"
        data-cta="reserve"
        data-cta-field="light"
      >
        空き状況と料金を確認する ↗
      </a>
      <a
        href="/reservation-guide/"
        class="inline-flex items-center gap-1.5 text-sm text-[color:var(--light-accent)] underline underline-offset-4 transition hover:opacity-80"
        data-cta="sites-to-reservation-guide"
      >
        予約方法を確認する →
      </a>
    </div>
  </section>

  {/* 11. 関連内部リンク */}
  <section class="mb-14">
    <h2 class="mb-5 text-xl font-semibold text-zinc-800">あわせて見る</h2>
    <ul class="space-y-3 text-sm">
      <li>
        <a href="/light-guide/" class="text-zinc-700 underline underline-offset-4 transition hover:text-zinc-900">
          ライトフォレスト 利用案内
        </a>
        <span class="ml-2 text-zinc-400">— 設備・利用時間・利用ルール</span>
      </li>
      <li>
        <a href="/rental/" class="text-zinc-700 underline underline-offset-4 transition hover:text-zinc-900">
          レンタル
        </a>
        <span class="ml-2 text-zinc-400">— 手ぶらでも始められる</span>
      </li>
    </ul>
  </section>
</PageLayout>
