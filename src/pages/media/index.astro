---
import { Picture } from "astro:assets";
import lightguideField from "../../assets/images/lightguide_field.jpg";
import bepalArticle from "../../assets/images/media_bepal_article.jpg";
import camplifeArticle from "../../assets/images/media_camplife_article.jpg";
import camplifeCampbean from "../../assets/images/media_camplife_campbean.jpg";
import mediaHero from "../../assets/images/media_hero.jpg";
import honmonoTochigi from "../../assets/images/media_honmono_tochigi.jpg";
import mediaLocation from "../../assets/images/media_location.jpg";
import sanpoArticle from "../../assets/images/media_sanpo_article.jpg";
import sanpoCover from "../../assets/images/media_sanpo_cover.jpg";
import tochinavi1 from "../../assets/images/media_tochinavi_1.jpg";
import tochinavi2 from "../../assets/images/media_tochinavi_2.jpg";
import PageLayout from "../../layouts/PageLayout.astro";

const TITLE = "メディア掲載・ロケ地｜里山パークおいらの森（栃木県那須烏山市）";
const DESC =
	"栃木県那須烏山市の里山キャンプ場。明るい広葉樹林と、樹齢80年以上のスギ・ヒノキの森で、映画・ドラマ・CM・MV・番組・スチールの撮影を受け入れています。夜間撮影・焚き火の演出にも対応。東京から約2時間。テレビ・MV・雑誌の掲載実績も紹介しています。";

const conditions = [
	{ label: "撮影の種類", value: "映画・ドラマ・CM・MV・テレビ番組・スチール" },
	{ label: "営業日の撮影", value: "可。ほかのお客様がいる日は、場内ルールの範囲での撮影になります" },
	{ label: "貸切", value: "可" },
	{ label: "夜間撮影", value: "貸切時のみ" },
	{ label: "焚き火の演出", value: "可" },
	{ label: "ドローン", value: "要相談" },
	{ label: "受け入れない時期", value: "GWなどの繁忙期" },
	{ label: "申込期限", value: "状況によります" },
	{ label: "料金", value: "応相談" },
];

const facilities = [
	{ label: "車両", value: "ロケバス・機材車の乗り入れ可（ディープフォレストは入り口まで）" },
	{ label: "駐車台数", value: "10台以上" },
	{ label: "電源", value: "あり" },
	{ label: "控室", value: "あり" },
	{ label: "トイレ", value: "水洗（シャワーはありません）" },
	{ label: "アクセス", value: "東京駅から約2時間／宇都宮駅から約40分" },
];

const steps = [
	"お問い合わせ（フォーム・電話・メール）",
	"ロケハン（無料・管理人が立ち会います）",
	"お見積り",
	"撮影",
];

const linkClass =
	"inline-flex items-center gap-2 border-b border-[#4A5D4E] pb-0.5 text-[#4A5D4E] transition hover:border-[#2d3a30] hover:text-[#2d3a30]";

const magazines = [
	{
		label: "Magazine / 2021",
		name: "散歩の達人",
		issue: "2021年4月号",
		feature: "特集「東京近郊の青春18きっぷで行ける日帰りキャンプ」",
		images: [
			{ src: sanpoCover, alt: "散歩の達人 2021年4月号の表紙" },
			{ src: sanpoArticle, alt: "散歩の達人 2021年4月号の掲載記事" },
		],
	},
	{
		label: "Magazine / 2022",
		name: "CampLife",
		issue: "2022年秋冬号",
		feature: "特集「ブッシュクラフトの似合うキャンプ場」",
		images: [
			{ src: camplifeArticle, alt: "CampLife 2022年秋冬号の掲載記事" },
			{ src: camplifeCampbean, alt: "CampLife 2022年秋冬号 同じ特集のCAMPBEANの掲載ページ" },
		],
		note: "同じ特集では、キャンプビーンさんも紹介されています。",
	},
	{
		label: "Magazine / 2022",
		name: "BE-PAL",
		issue: "2022年12月号",
		feature: "特集「絶対お得なアウトドア界のサブスク」で年間パスポートを紹介",
		images: [{ src: bepalArticle, alt: "BE-PAL 2022年12月号の掲載記事" }],
		passport: true,
	},
];

const pamphlets = [
	{
		label: "Pamphlet / 2022",
		name: "栃ナビ！フリーペーパー",
		issue: "2022年8・9月号（那須烏山特集）",
		images: [
			{ src: tochinavi1, alt: "栃ナビ！フリーペーパー 那須烏山特集の紙面" },
			{ src: tochinavi2, alt: "栃ナビ！フリーペーパー 那須烏山特集の紙面全体" },
		],
	},
	{
		label: "Pamphlet / 2023",
		name: "本物の出会い 栃木",
		issue: "2023年冬号（栃木県観光交流課 発行）",
		images: [{ src: honmonoTochigi, alt: "本物の出会い 栃木 2023年冬号の紙面" }],
	},
];
---

<PageLayout
  title={TITLE}
  description={DESC}
  lastUpdated="2026年10月"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebPage",
          "name": TITLE,
          "description": DESC,
          "url": "https://oiranomori.jp/media/",
          "isPartOf": {
            "@type": "WebSite",
            "name": "里山パークおいらの森",
            "url": "https://oiranomori.jp"
          }
        },
        {
          "@type": "ItemList",
          "name": "里山パークおいらの森 メディア掲載実績",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "ヒロシのぼっちキャンプ（BS-TBS）",
              "description": "BS-TBS「ヒロシのぼっちキャンプ」Season 6 #127・#128（2023年3月22日放送）。ディープフォレストでの野営が放映されました。"
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "パソコン音楽クラブ「SIGN feat. 藤井隆」MV",
              "description": "2022年11月4日リリース。ミュージックビデオのロケ地。"
            },
            {
              "@type": "ListItem",
              "position": 3,
              "name": "散歩の達人 2021年4月号",
              "description": "特集「東京近郊の青春18きっぷで行ける日帰りキャンプ」"
            },
            {
              "@type": "ListItem",
              "position": 4,
              "name": "CampLife 2022年秋冬号",
              "description": "特集「ブッシュクラフトの似合うキャンプ場」"
            },
            {
              "@type": "ListItem",
              "position": 5,
              "name": "BE-PAL 2022年12月号",
              "description": "特集「絶対お得なアウトドア界のサブスク」で年間パスポートを紹介"
            },
            {
              "@type": "ListItem",
              "position": 6,
              "name": "栃ナビ！フリーペーパー 2022年8・9月号",
              "description": "那須烏山特集"
            },
            {
              "@type": "ListItem",
              "position": 7,
              "name": "本物の出会い 栃木 2023年冬号",
              "description": "栃木県観光交流課 発行"
            }
          ]
        }
      ]
    })} />
  </Fragment>

    {/* ヒーロー */}
  <Picture
    src={mediaHero}
    formats={["avif", "webp"]}
    alt="森の中で三脚を立てて撮影する人物"
    loading="eager"
    fetchpriority="high"
    sizes="(max-width: 768px) 100vw, 72rem"
    class="mb-10 aspect-[16/9] w-full object-cover"
  />

  {/* ページヘッダー */}
  <div class="mb-14 border-b border-zinc-200 pb-10">
    <p class="text-xs tracking-[0.26em] text-zinc-400 uppercase">Media / Location</p>
    <h1 class="mt-3 text-3xl font-semibold text-zinc-800 md:text-4xl">メディア掲載・ロケ地</h1>
    <p class="mt-5 max-w-2xl text-base leading-loose text-zinc-600">
      映画・ドラマ・CM・MV・テレビ番組・スチールの撮影を受け入れています。<br />
      東京から車で約2時間、栃木県那須烏山市の里山にある、森のキャンプ場です。<br />
      ロケハンには管理人が立ち会います。
    </p>
  </div>

  {/* 撮れる景色（FAQ からのリンク先） */}
  <section id="location" class="mb-16 scroll-mt-24">
    <h2 class="text-xl font-semibold text-zinc-800">撮れる景色</h2>

    <div class="mt-8 space-y-12">
      <div>
        <h3 class="text-lg font-semibold text-zinc-800">ライトフォレスト｜明るい広葉樹の森</h3>
        <Picture
          src={lightguideField}
          formats={["avif", "webp"]}
          alt="明るい広葉樹の林間に、テントと車が並ぶオートサイト"
          loading="lazy"
          sizes="(max-width: 768px) 100vw, 42rem"
          class="mt-4 aspect-[16/9] w-full max-w-2xl object-cover"
        />
        <p class="mt-4 max-w-2xl text-sm leading-loose text-zinc-600">
          下草まで手の入った林間に、オートサイトと区画サイトが並ぶフィールドです。季節ごとに色が変わる森で、キャンプ場らしいアウトドアのシーンが撮れます。
        </p>
      </div>

      <div>
        <h3 class="text-lg font-semibold text-zinc-800">ディープフォレスト｜樹齢80年以上のスギ・ヒノキの森</h3>
        <Picture
          src={mediaLocation}
          formats={["avif", "webp"]}
          alt="木漏れ日が差し込む、背の高いスギ・ヒノキの林"
          loading="lazy"
          sizes="(max-width: 768px) 100vw, 42rem"
          class="mt-4 aspect-[3/2] w-full max-w-2xl object-cover"
        />
        <p class="mt-4 max-w-2xl text-sm leading-loose text-zinc-600">
          針葉樹が密に立つ林業の森です。冬でも緑のまま撮れます。整えた施設はほとんどなく、人工物の少ない森の絵になります。全面で直火ができるので、焚き火のシーンも撮れます。夜は街灯のない闇です。
        </p>
        <p class="mt-3 max-w-2xl text-sm leading-loose text-zinc-500">
          ※ディープフォレストの所在地は、ロケハンの日程が決まった方にお伝えします。
        </p>
      </div>
    </div>
  </section>

  {/* MEDIA */}
  <section class="mb-16">
    <p class="text-xs tracking-[0.26em] text-[#4A5D4E] uppercase">Media</p>
    <h2 class="mt-2 text-xl font-semibold text-zinc-800">メディア掲載実績</h2>
    <p class="mt-4 max-w-2xl text-sm leading-loose text-zinc-500">
      2026年4月28日に「フォレストパークおいらの森」から現在の名称に改めました。それより前の掲載は旧名称で紹介されています。紙面の料金は掲載当時のものです。
    </p>

    <div class="mt-8 space-y-12">

      {/* BS-TBS */}
      <div class="border-l-2 border-[#4A5D4E] pl-6">
        <p class="text-xs tracking-[0.22em] text-zinc-400 uppercase">TV / 2023</p>
        <h3 class="mt-2 text-lg font-semibold text-zinc-800">ヒロシのぼっちキャンプ</h3>
        <p class="mt-1 text-sm text-zinc-500">BS-TBS｜Season 6｜#127・#128｜2023年3月22日放送</p>
        <p class="mt-4 max-w-2xl text-sm leading-loose text-zinc-600">
          ソロキャンプで知られる芸人・ヒロシ氏が、ディープフォレストで野営。
          樹齢80年のスギ・ヒノキの森、全面直火可のフィールドが番組で紹介されました。
        </p>
        <ul class="mt-4 space-y-2 text-sm">
          <li>
            <a href="https://bs.tbs.co.jp/botticamp/archives/127_128.html" target="_blank" rel="noopener noreferrer" class={linkClass}>
              番組公式の回のページ ↗
            </a>
          </li>
          <li>
            <a href="https://youtu.be/53y1P5PhUoM" target="_blank" rel="noopener noreferrer" class={linkClass}>
              予告動画（YouTube） ↗
            </a>
          </li>
        </ul>
      </div>

      {/* MV */}
      <div class="border-l-2 border-[#4A5D4E] pl-6">
        <p class="text-xs tracking-[0.22em] text-zinc-400 uppercase">Music Video / 2022</p>
        <h3 class="mt-2 text-lg font-semibold text-zinc-800">パソコン音楽クラブ「SIGN feat. 藤井隆」</h3>
        <p class="mt-1 text-sm text-zinc-500">2022年11月4日リリース</p>
        <p class="mt-4 max-w-2xl text-sm leading-loose text-zinc-600">
          ミュージックビデオのロケ地になりました。おいらの森が映るのは 1:23・1:53・2:57。おいらも出演しています。
        </p>
        <p class="mt-4 text-sm">
          <a href="https://youtu.be/GmetlootbhE" target="_blank" rel="noopener noreferrer" class={linkClass}>
            ミュージックビデオ（YouTube） ↗
          </a>
        </p>
      </div>

      {/* 雑誌 */}
      {magazines.map((m) => (
        <div class="border-l-2 border-[#4A5D4E] pl-6">
          <p class="text-xs tracking-[0.22em] text-zinc-400 uppercase">{m.label}</p>
          <h3 class="mt-2 text-lg font-semibold text-zinc-800">{m.name}</h3>
          <p class="mt-1 text-sm text-zinc-500">{m.issue}</p>
          <p class="mt-4 max-w-2xl text-sm leading-loose text-zinc-600">{m.feature}</p>
          <div class="mt-5 grid max-w-2xl grid-cols-2 gap-3">
            {m.images.map((img) => (
              <a href={img.src.src} target="_blank" rel="noopener" aria-label={`${img.alt}（画像を拡大）`}>
                <Picture
                  src={img.src}
                  formats={["avif", "webp"]}
                  alt={img.alt}
                  loading="lazy"
                  sizes="(max-width: 768px) 50vw, 21rem"
                  class="w-full"
                />
              </a>
            ))}
          </div>
          {m.note && <p class="mt-3 max-w-2xl text-sm leading-loose text-zinc-500">{m.note}</p>}
          {m.passport && (
            <p class="mt-4 text-sm">
              <a href="/passport/" class={linkClass}>年間パスポート・回数券 →</a>
            </p>
          )}
        </div>
      ))}

      {/* パンフレット */}
      {pamphlets.map((p) => (
        <div class="border-l-2 border-[#4A5D4E] pl-6">
          <p class="text-xs tracking-[0.22em] text-zinc-400 uppercase">{p.label}</p>
          <h3 class="mt-2 text-lg font-semibold text-zinc-800">{p.name}</h3>
          <p class="mt-1 text-sm text-zinc-500">{p.issue}</p>
          <div class="mt-5 grid max-w-2xl grid-cols-2 gap-3">
            {p.images.map((img) => (
              <a href={img.src.src} target="_blank" rel="noopener" aria-label={`${img.alt}（画像を拡大）`}>
                <Picture
                  src={img.src}
                  formats={["avif", "webp"]}
                  alt={img.alt}
                  loading="lazy"
                  sizes="(max-width: 768px) 50vw, 21rem"
                  class="w-full"
                />
              </a>
            ))}
          </div>
        </div>
      ))}

    </div>
  </section>

  {/* 受け入れ条件 */}
  <section class="mb-16">
    <h2 class="text-xl font-semibold text-zinc-800">受け入れ条件</h2>
    <dl class="mt-6 max-w-2xl divide-y divide-zinc-200 border-y border-zinc-200">
      {conditions.map((r) => (
        <div class="grid gap-1 py-4 sm:grid-cols-[10rem_1fr] sm:gap-6">
          <dt class="text-sm font-medium text-zinc-700">{r.label}</dt>
          <dd class="text-sm leading-loose text-zinc-600">{r.value}</dd>
        </div>
      ))}
    </dl>
  </section>

  {/* 設備・アクセス */}
  <section class="mb-16">
    <h2 class="text-xl font-semibold text-zinc-800">設備・アクセス</h2>
    <dl class="mt-6 max-w-2xl divide-y divide-zinc-200 border-y border-zinc-200">
      {facilities.map((r) => (
        <div class="grid gap-1 py-4 sm:grid-cols-[10rem_1fr] sm:gap-6">
          <dt class="text-sm font-medium text-zinc-700">{r.label}</dt>
          <dd class="text-sm leading-loose text-zinc-600">{r.value}</dd>
        </div>
      ))}
      <div class="grid gap-1 py-4 sm:grid-cols-[10rem_1fr] sm:gap-6">
        <dt class="text-sm font-medium text-zinc-700">周辺</dt>
        <dd class="text-sm leading-loose text-zinc-600">
          温泉・スーパー・食事処は車で10分ほど
          <a href="/map/" class="ml-2 underline underline-offset-2 text-[#4A5D4E] transition hover:text-[#2d3a30]">周辺案内 →</a>
        </dd>
      </div>
    </dl>
  </section>

  {/* 撮影までの流れ */}
  <section class="mb-16">
    <h2 class="text-xl font-semibold text-zinc-800">撮影までの流れ</h2>
    <ol class="mt-6 max-w-2xl space-y-3 text-sm leading-loose text-zinc-600">
      {steps.map((s, i) => (
        <li class="flex gap-4">
          <span class="font-medium text-[#4A5D4E]">{i + 1}.</span>
          <span>{s}</span>
        </li>
      ))}
    </ol>
  </section>

  {/* お問い合わせの際に */}
  <section class="mb-16">
    <h2 class="text-xl font-semibold text-zinc-800">お問い合わせの際にお知らせください</h2>
    <p class="mt-5 max-w-2xl text-sm leading-loose text-zinc-600">
      作品の種類、撮影希望日（予備日があれば予備日も）、人数、車両の台数と種類、撮影の内容（夜間・焚き火・ドローンの有無）、貸切の希望の有無。
    </p>
    <p class="mt-6 text-sm">
      <a href="/contact/" class={linkClass}>
        撮影のお問い合わせ →
      </a>
    </p>
  </section>

  {/* 団体貸し切りの案内先（旧リンクから来た人向け） */}
  <p class="mb-10 max-w-2xl text-sm leading-loose text-zinc-500">
    団体での貸し切りは<a href="/sites/group/#charter" class="mx-1 underline underline-offset-2 text-[#4A5D4E] transition hover:text-[#2d3a30]">グループ・貸切のページ</a>でご案内しています。
  </p>

</PageLayout>
