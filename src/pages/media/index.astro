---
import { Picture } from "astro:assets";
import bepalArticle from "../../assets/images/media_bepal_article.jpg";
import camplifeArticle from "../../assets/images/media_camplife_article.jpg";
import camplifeCampbean from "../../assets/images/media_camplife_campbean.jpg";
import mediaHero from "../../assets/images/media_hero.jpg";
import honmonoTochigi from "../../assets/images/media_honmono_tochigi.jpg";
import mediaLocation from "../../assets/images/media_location.jpg";
import sanpoArticle from "../../assets/images/media_sanpo_article.jpg";
import sanpoCover from "../../assets/images/media_sanpo_cover.jpg";
import tochinavi1 from "../../assets/images/media_tochinavi_1.jpg";
import tochinavi2 from "../../assets/images/media_tochinavi_2.jpg";
import PageLayout from "../../layouts/PageLayout.astro";

const TITLE = "メディア掲載・ロケ地 | 里山パークおいらの森";
const DESC =
	"BS-TBS「ヒロシのぼっちキャンプ」、パソコン音楽クラブ「SIGN feat. 藤井隆」MVのロケ地。散歩の達人・CampLife・BE-PALなどの掲載実績と、撮影利用のご案内。";

const linkClass =
	"inline-flex items-center gap-2 border-b border-[#4A5D4E] pb-0.5 text-[#4A5D4E] transition hover:border-[#2d3a30] hover:text-[#2d3a30]";

const magazines = [
	{
		label: "Magazine / 2021",
		name: "散歩の達人",
		issue: "2021年4月号",
		feature: "特集「東京近郊の青春18きっぷで行ける日帰りキャンプ」",
		images: [
			{ src: sanpoCover, alt: "散歩の達人 2021年4月号の表紙" },
			{ src: sanpoArticle, alt: "散歩の達人 2021年4月号の掲載記事" },
		],
	},
	{
		label: "Magazine / 2022",
		name: "CampLife",
		issue: "2022年秋冬号",
		feature: "特集「ブッシュクラフトの似合うキャンプ場」",
		images: [
			{ src: camplifeArticle, alt: "CampLife 2022年秋冬号の掲載記事" },
			{ src: camplifeCampbean, alt: "CampLife 2022年秋冬号 同じ特集のCAMPBEANの掲載ページ" },
		],
		note: "同じ特集では、キャンプビーンさんも紹介されています。",
	},
	{
		label: "Magazine / 2022",
		name: "BE-PAL",
		issue: "2022年12月号",
		feature: "特集「絶対お得なアウトドア界のサブスク」で年間パスポートを紹介",
		images: [{ src: bepalArticle, alt: "BE-PAL 2022年12月号の掲載記事" }],
		passport: true,
	},
];

const pamphlets = [
	{
		label: "Pamphlet / 2022",
		name: "栃ナビ！フリーペーパー",
		issue: "2022年8・9月号（那須烏山特集）",
		images: [
			{ src: tochinavi1, alt: "栃ナビ！フリーペーパー 那須烏山特集の紙面" },
			{ src: tochinavi2, alt: "栃ナビ！フリーペーパー 那須烏山特集の紙面全体" },
		],
	},
	{
		label: "Pamphlet / 2023",
		name: "本物の出会い 栃木",
		issue: "2023年冬号（栃木県観光交流課 発行）",
		images: [{ src: honmonoTochigi, alt: "本物の出会い 栃木 2023年冬号の紙面" }],
	},
];
---

<PageLayout
  title={TITLE}
  description={DESC}
  lastUpdated="2026年10月"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebPage",
          "name": TITLE,
          "description": DESC,
          "url": "https://oiranomori.jp/media/",
          "isPartOf": {
            "@type": "WebSite",
            "name": "里山パークおいらの森",
            "url": "https://oiranomori.jp"
          }
        },
        {
          "@type": "ItemList",
          "name": "里山パークおいらの森 メディア掲載実績",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "ヒロシのぼっちキャンプ（BS-TBS）",
              "description": "BS-TBS「ヒロシのぼっちキャンプ」Season 6 #127・#128（2023年3月22日放送）。ディープフォレストでの野営が放映されました。"
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "パソコン音楽クラブ「SIGN feat. 藤井隆」MV",
              "description": "2022年11月4日リリース。ミュージックビデオのロケ地。"
            },
            {
              "@type": "ListItem",
              "position": 3,
              "name": "散歩の達人 2021年4月号",
              "description": "特集「東京近郊の青春18きっぷで行ける日帰りキャンプ」"
            },
            {
              "@type": "ListItem",
              "position": 4,
              "name": "CampLife 2022年秋冬号",
              "description": "特集「ブッシュクラフトの似合うキャンプ場」"
            },
            {
              "@type": "ListItem",
              "position": 5,
              "name": "BE-PAL 2022年12月号",
              "description": "特集「絶対お得なアウトドア界のサブスク」で年間パスポートを紹介"
            },
            {
              "@type": "ListItem",
              "position": 6,
              "name": "栃ナビ！フリーペーパー 2022年8・9月号",
              "description": "那須烏山特集"
            },
            {
              "@type": "ListItem",
              "position": 7,
              "name": "本物の出会い 栃木 2023年冬号",
              "description": "栃木県観光交流課 発行"
            }
          ]
        }
      ]
    })} />
  </Fragment>

    {/* ヒーロー */}
  <Picture
    src={mediaHero}
    formats={["avif", "webp"]}
    alt="森の中で三脚を立てて撮影する人物"
    loading="eager"
    fetchpriority="high"
    sizes="(max-width: 768px) 100vw, 72rem"
    class="mb-10 aspect-[16/9] w-full object-cover"
  />

  {/* ページヘッダー */}
  <div class="mb-14 border-b border-zinc-200 pb-10">
    <p class="text-xs tracking-[0.26em] text-zinc-400 uppercase">Media / Location</p>
    <h1 class="mt-3 text-3xl font-semibold text-zinc-800 md:text-4xl">メディア掲載・ロケ地</h1>
    <p class="mt-5 max-w-2xl text-base leading-loose text-zinc-600">
      おいらの森は、テレビ番組やミュージックビデオのロケ地、雑誌の取材先として使われてきました。
      取材・撮影のご相談はお気軽に。
    </p>
  </div>

  {/* MEDIA */}
  <section class="mb-16">
    <p class="text-xs tracking-[0.26em] text-[#4A5D4E] uppercase">Media</p>
    <h2 class="mt-2 text-xl font-semibold text-zinc-800">メディア掲載実績</h2>

    <div class="mt-8 space-y-12">

      {/* BS-TBS */}
      <div class="border-l-2 border-[#4A5D4E] pl-6">
        <p class="text-xs tracking-[0.22em] text-zinc-400 uppercase">TV / 2023</p>
        <h3 class="mt-2 text-lg font-semibold text-zinc-800">ヒロシのぼっちキャンプ</h3>
        <p class="mt-1 text-sm text-zinc-500">BS-TBS｜Season 6｜#127・#128｜2023年3月22日放送</p>
        <p class="mt-4 max-w-2xl text-sm leading-loose text-zinc-600">
          ソロキャンプで知られる芸人・ヒロシ氏が、ディープフォレストで野営。
          樹齢80年のスギ・ヒノキの森、全面直火可のフィールドが番組で紹介されました。
        </p>
        <ul class="mt-4 space-y-2 text-sm">
          <li>
            <a href="https://bs.tbs.co.jp/botticamp/archives/127_128.html" target="_blank" rel="noopener noreferrer" class={linkClass}>
              番組公式の回のページ ↗
            </a>
          </li>
          <li>
            <a href="https://youtu.be/53y1P5PhUoM" target="_blank" rel="noopener noreferrer" class={linkClass}>
              予告動画（YouTube） ↗
            </a>
          </li>
        </ul>
      </div>

      {/* MV */}
      <div class="border-l-2 border-[#4A5D4E] pl-6">
        <p class="text-xs tracking-[0.22em] text-zinc-400 uppercase">Music Video / 2022</p>
        <h3 class="mt-2 text-lg font-semibold text-zinc-800">パソコン音楽クラブ「SIGN feat. 藤井隆」</h3>
        <p class="mt-1 text-sm text-zinc-500">2022年11月4日リリース</p>
        <p class="mt-4 max-w-2xl text-sm leading-loose text-zinc-600">
          ミュージックビデオのロケ地になりました。おいらの森が映るのは 1:23・1:53・2:57。おいらも出演しています。
          クレジットの Special thanks に「Forest Park Oira no Mori」。
        </p>
        <p class="mt-4 text-sm">
          <a href="https://youtu.be/GmetlootbhE" target="_blank" rel="noopener noreferrer" class={linkClass}>
            ミュージックビデオ（YouTube） ↗
          </a>
        </p>
      </div>

      {/* 雑誌 */}
      {magazines.map((m) => (
        <div class="border-l-2 border-[#4A5D4E] pl-6">
          <p class="text-xs tracking-[0.22em] text-zinc-400 uppercase">{m.label}</p>
          <h3 class="mt-2 text-lg font-semibold text-zinc-800">{m.name}</h3>
          <p class="mt-1 text-sm text-zinc-500">{m.issue}</p>
          <p class="mt-4 max-w-2xl text-sm leading-loose text-zinc-600">{m.feature}</p>
          <div class="mt-5 grid max-w-2xl grid-cols-2 gap-3">
            {m.images.map((img) => (
              <a href={img.src.src} target="_blank" rel="noopener" aria-label={`${img.alt}（画像を拡大）`}>
                <Picture
                  src={img.src}
                  formats={["avif", "webp"]}
                  alt={img.alt}
                  loading="lazy"
                  sizes="(max-width: 768px) 50vw, 21rem"
                  class="w-full"
                />
              </a>
            ))}
          </div>
          {m.note && <p class="mt-3 max-w-2xl text-sm leading-loose text-zinc-500">{m.note}</p>}
          {m.passport && (
            <p class="mt-4 text-sm">
              <a href="/passport/" class={linkClass}>年間パスポート・回数券 →</a>
            </p>
          )}
        </div>
      ))}

      {/* パンフレット */}
      {pamphlets.map((p) => (
        <div class="border-l-2 border-[#4A5D4E] pl-6">
          <p class="text-xs tracking-[0.22em] text-zinc-400 uppercase">{p.label}</p>
          <h3 class="mt-2 text-lg font-semibold text-zinc-800">{p.name}</h3>
          <p class="mt-1 text-sm text-zinc-500">{p.issue}</p>
          <div class="mt-5 grid max-w-2xl grid-cols-2 gap-3">
            {p.images.map((img) => (
              <a href={img.src.src} target="_blank" rel="noopener" aria-label={`${img.alt}（画像を拡大）`}>
                <Picture
                  src={img.src}
                  formats={["avif", "webp"]}
                  alt={img.alt}
                  loading="lazy"
                  sizes="(max-width: 768px) 50vw, 21rem"
                  class="w-full"
                />
              </a>
            ))}
          </div>
        </div>
      ))}

    </div>
  </section>

  {/* LOCATION */}
  <section class="mb-16">
    <p class="text-xs tracking-[0.26em] text-[#4A5D4E] uppercase">Location</p>
    <h2 class="mt-2 text-xl font-semibold text-zinc-800">ロケ地・撮影利用</h2>
    <Picture
      src={mediaLocation}
      formats={["avif", "webp"]}
      alt="木漏れ日が差し込む背の高い杉林"
      loading="lazy"
      sizes="(max-width: 768px) 100vw, 36rem"
      class="mb-5 aspect-[3/2] w-full max-w-2xl object-cover"
    />
    <p class="mt-5 max-w-2xl text-sm leading-loose text-zinc-600">
      ライトフォレスト・ディープフォレストともに、撮影ロケ地としての利用が可能です。
      広葉樹林の明るい森、樹齢80年の針葉樹林、焚き火、里山の風景。
      詳細・条件はお問い合わせください。
      料金はシーズン、曜日、利用エリアの範囲によって変動しますので、ご相談ください。
    </p>
    <p class="mt-6 text-sm">
      <a href="/contact/" class={linkClass}>
        撮影利用のお問い合わせ →
      </a>
    </p>
  </section>

  {/* 団体貸し切りの案内先（旧リンクから来た人向け） */}
  <p class="mb-10 max-w-2xl text-sm leading-loose text-zinc-500">
    団体での貸し切りは<a href="/sites/group/#charter" class="mx-1 underline underline-offset-2 text-[#4A5D4E] transition hover:text-[#2d3a30]">グループ・貸切のページ</a>でご案内しています。
  </p>

</PageLayout>
