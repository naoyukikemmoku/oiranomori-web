---
import { Image } from "astro:assets";
import planDaycamp from "../assets/images/plan_daycamp.JPEG";
import planDogrun from "../assets/images/plan_dogrun.JPEG";
import planKukaku from "../assets/images/plan_kukaku.jpg";
import planStandard from "../assets/images/plan_standard.JPEG";
import planTrain from "../assets/images/plan_train.JPEG";
import planWorkation from "../assets/images/plan_workation.jpg";
// 野営っぽくキャンプ・ソロ割りオートサイトの写真（plan_yaei・plan_solo）は夜の写真のため、
// 夜の写真は「ライトの一泊」の段だけにする決まりに合わせ、/sites/ の昼の写真を仮に使う（差し替えはナオが行う）
import sitesGearSmall from "../assets/images/sites_gear_small.jpg";
import sitesGearTarp from "../assets/images/sites_gear_tarp.jpg";
import CongestionMatrix from "../components/CongestionMatrix.astro";
import OshiraseList from "../components/OshiraseList.astro";
import SeasonSlider from "../components/SeasonSlider.astro";
import { PROX_SEARCH_URL, proxPlanUrl } from "../config/nav";
import { PLAN_PRICES } from "../data/planPrices";
import LpLayout from "../layouts/LpLayout.astro";
import { getOshirase } from "../lib/oshirase";

const { contents } = await getOshirase(3);

// プラン一覧。チェックイン・チェックアウトの時刻は、一覧の上に一度だけ書く（カードには書かない）
const plans: Array<{
	name: string;
	price: string;
	id: number;
	img: typeof planStandard | null;
	alt: string;
	badge?: string;
	subtitle?: string;
}> = [
	{
		name: "スタンダード・\nオートサイト",
		price: PLAN_PRICES[4],
		id: 4,
		img: planStandard,
		alt: "那須烏山 里山パークおいらの森 スタンダード・オートサイトのキャンプサイト",
	},
	{
		name: "区画サイト",
		price: PLAN_PRICES[5],
		id: 5,
		img: planKukaku,
		alt: "林間にタープとハンモックを張り、石を組んだ焚き火をする区画サイト",
		subtitle: "車の乗り入れなし",
	},
	{
		name: "野営っぽく\nキャンプ",
		price: PLAN_PRICES[6],
		id: 6,
		img: sitesGearTarp,
		alt: "テントの上に大きなタープを重ねて張った林間サイト",
		subtitle: "ライトフォレスト",
	},
	{
		name: "貸切\nドッグランサイト",
		price: PLAN_PRICES[7],
		id: 7,
		img: planDogrun,
		alt: "那須烏山 里山パークおいらの森 貸切ドッグランサイトのキャンプサイト",
		badge: "1組限定（場内に1サイト）",
		subtitle: "柵付き・専用区画",
	},
	{
		name: "日帰り\nデイキャンプ",
		price: PLAN_PRICES[14],
		id: 14,
		img: planDaycamp,
		alt: "那須烏山 里山パークおいらの森 日帰りデイキャンプのキャンプサイト",
	},
	{
		name: "ワーケーション",
		price: PLAN_PRICES[16],
		id: 16,
		img: planWorkation,
		alt: "パラソルの下でノートパソコンを広げる平日ソロのワーケーション",
		subtitle: "平日ソロ限定",
	},
	{
		name: "ソロ割り\nオートサイト",
		price: PLAN_PRICES[21],
		id: 21,
		img: sitesGearSmall,
		alt: "竹林を背にした区画に張った小型ドームテント",
		subtitle: "平日ソロ限定",
	},
	{
		name: "電車キャンパー\n歓迎",
		price: PLAN_PRICES[23],
		id: 23,
		img: planTrain,
		alt: "那須烏山 里山パークおいらの森 電車キャンパー歓迎プランのキャンプサイト",
		subtitle: "送迎無料サービスあり",
	},
];

// 人数・過ごし方から選ぶ。呼び方と一言は /sites/ の客層ページへの案内と同じ
const audiences = [
	{
		href: "/sites/solo/",
		label: "ソロ",
		copy: "小さく張るか、タープまで広げるか。ひとりに合う広さと場内環境を確認できます。",
	},
	{
		href: "/sites/duo/",
		label: "デュオ・カップル",
		copy: "コンパクトに過ごすS、ゆったり使うM。2人の道具量から選べます。",
	},
	{
		href: "/sites/family/",
		label: "ファミリー",
		copy: "テント、タープ、車と、区画内に残したい余白から選びます。",
	},
	{
		href: "/sites/group/",
		label: "グループ・ソログル・貸切",
		copy: "大型幕、複数テント、隣接区画、貸切を分けて確認できます。",
	},
	{
		href: "/sites/dogrun/",
		label: "ドッグラン",
		copy: "柵内約400㎡を1日1組で利用する、犬連れのためのサイトです。",
	},
];

// おいらの森の、ここがいい。1項目1行とリンク（文はナオの確認用の仮の文）。
// 例外・細かい条件はリンク先（spec §14.4 の正本ページ）にだけ書く。
// 前のトップにしかなかった4つの文は、受け持つページへ移した（虫よけと靴→/light-guide/#facility、
// 薪ストーブ対応テント→/rental/ の冬期限定、生ビールの銘柄とプラカップ→/shop/ のドリンク）
const notes: Array<{
	text: string;
	links: Array<{ href: string; text: string; cta?: string }>;
}> = [
	{
		text: "管理人が家族で隣に住んでいるので、困ったときはすぐ声をかけられます。女性のソロキャンプも歓迎です。",
		links: [
			{ href: "/sites/solo/", text: "ソロのサイト" },
			{ href: "/light-guide/", text: "利用案内" },
		],
	},
	{
		text: "アーリーチェックインは無料で、朝9時から入れます。",
		links: [{ href: "/light-guide/#n-early", text: "アーリーチェックイン" }],
	},
	{
		text: "トイレは水洗です。",
		links: [{ href: "/light-guide/#toilet", text: "設備" }],
	},
	{
		text: "通年営業なので、冬キャンプも年越しキャンプもできます。",
		links: [{ href: "/seasons/#winter", text: "冬の森" }],
	},
	{
		text: "薪は、林業家のおいらが森から仕立てたものです。生ビールは売店で量り売りしています。",
		links: [
			{ href: "/firewood/", text: "薪" },
			{ href: "/shop/", text: "売店" },
		],
	},
	{
		text: "温泉もスーパーも、車で10分ほどです。",
		links: [{ href: "/map/", text: "周辺の食事・観光" }],
	},
	{
		text: "クマの生息域から離れた里山です。",
		links: [
			{ href: "/faq/#nature", text: "詳しくはFAQへ", cta: "top-to-wildlife" },
		],
	},
];
---

<LpLayout
  title="里山パークおいらの森｜栃木県那須烏山市のキャンプ場"
  description="東京埼玉から2時間。栃木県那須烏山市にある里山パーク「おいらの森」。おいらのおすすめはオートサイトとソロ区画。ファミリーから野営まで、どなたでも森の中でキャンプを楽しめます。通年営業。"
  lastUpdated="2026年11月"
>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": ["LocalBusiness", "Campground"],
    "name": "里山パークおいらの森",
    "alternateName": "フォレストパークおいらの森",
    "description": "東京埼玉から2時間。栃木県那須烏山市にある里山パークおいらの森。おいらのおすすめはオートサイトとソロ区画。ファミリーから野営まで、どなたでも森の中でキャンプを楽しめます。通年営業。",
    "url": "https://oiranomori.jp",
    "telephone": "050-3647-1047",
    "address": {
      "@type": "PostalAddress",
      "addressCountry": "JP",
      "addressRegion": "栃木県",
      "addressLocality": "那須烏山市",
      "streetAddress": "福岡1047"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 36.6384419,
      "longitude": 140.0695418
    },
    "openingHoursSpecification": [
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
        "opens": "09:00",
        "closes": "17:30"
      }
    ],
    "priceRange": "¥¥",
    "image": "https://oiranomori.jp/images/lp/hero.jpg",
    "sameAs": [
      "https://note.com/oiranomori",
      "https://instagram.com/oiranomori",
      "https://facebook.com/oiranomori",
      "https://x.com/oiranomori",
      "https://www.youtube.com/@Oiranomori"
    ]
  })} />
  <link rel="preload" as="image" href="/images/lp/hero.jpg" fetchpriority="high" slot="head" />

  {/* トップの並び（spec §4.1）。2トップ方針（spec §14.1）のとおり、ここはライトフォレストのトップ。
      暗い写真の上に白い字を載せるのは、最初の写真のほかは 2・3・4 の段だけ。夜の写真は 4 の段だけ。 */}

  {/* 1. 最初の写真。Scroll は次の段（2. ライトの森の様子）へ */}
  <section id="top" class="lp-hero" style="background-image:url('/images/lp/hero.jpg');">
    <div class="lp-hero__overlay"></div>
    <div class="mx-auto max-w-6xl px-5">
      <div class="lp-hero__content">
        <p class="text-xs tracking-[0.32em] text-zinc-400">OI RA NO MORI</p>
        <h1 class="mt-5 font-semibold leading-snug text-white">
          <span class="block text-2xl md:text-3xl">里山パーク</span>
          <span class="block text-5xl md:text-7xl">おいらの森</span>
        </h1>
        <p class="mt-8 max-w-2xl text-sm leading-[2] text-zinc-200 md:text-base">
          里山パークおいらの森は栃木県那須烏山の里山にある静かな森のキャンプ場。<br />
          森で遊び、森に泊まり、森を味わいに。<br />
          焚き火を眺め、朝のコーヒーを淹れ、のんびりする時間を。<br />
          明るい広葉樹林のライトフォレスト、深い針葉樹林のディープフォレスト、<br />
          2つのフィールドでお待ちしております。
        </p>
        <p class="mt-10 text-sm tracking-[0.18em]">
          <a
            href="/residents/"
            class="text-white underline decoration-white/50 underline-offset-4 transition hover:decoration-white"
          >
            この森をつくる人 — 森の住人<span aria-hidden="true" class="link-arrow [--link-arrow-gap:0.5rem]">&nbsp;→</span>
          </a>
        </p>
      </div>
    </div>
    <a href="#light-forest" class="lp-scroll">Scroll</a>
  </section>

  {/* 2. ライトの森の様子。前の「整えすぎず」と「森が、ちょうどよくしてくれる」の段を1つにまとめた。
      文は2つの段にあった文から選んだ（新しい文は足していない）。写真は「森が、ちょうどよくしてくれる」の段のもの */}
  <section id="light-forest" class="relative overflow-hidden py-24 md:py-32">
    <picture>
      <source type="image/avif" srcset="/images/lp/lp-in-the-forest-1200.avif 1200w, /images/lp/lp-in-the-forest.avif 2400w" sizes="100vw" />
      <source type="image/webp" srcset="/images/lp/lp-in-the-forest-1200.webp 1200w, /images/lp/lp-in-the-forest.webp 2400w" sizes="100vw" />
      <img
        src="/images/lp/lp-in-the-forest-1200.jpg"
        srcset="/images/lp/lp-in-the-forest-1200.jpg 1200w, /images/lp/lp-in-the-forest.jpg 2400w"
        sizes="100vw"
        alt="那須烏山 里山パークおいらの森の林間"
        width="2365"
        height="1330"
        loading="lazy"
        class="absolute inset-0 h-full w-full object-cover"
      />
    </picture>
    <div class="absolute inset-0 bg-black/60"></div>
    <div class="relative z-10 mx-auto max-w-6xl px-6 md:px-10">
      <div class="max-w-2xl">
        <p class="text-xs tracking-[0.32em] text-zinc-400">LIGHT FOREST</p>
        <p class="mt-4 text-3xl font-semibold leading-snug text-white md:text-4xl">
          整えすぎず、けど、手は入っている。
        </p>
        <h2 class="mt-3 text-base font-medium text-zinc-200 md:text-lg">
          夏は木陰、冬は風よけ。ハンモックを掛けやすい林間サイト
        </h2>
        <p class="mt-5 text-sm leading-loose text-zinc-200 md:text-base">
          地面は土で、夜は暗く、虫も当たり前に暮らしています。<br />
          その分、森本来の心地よさがそのままあります。
        </p>
        <p class="mt-4 text-sm leading-loose text-zinc-200 md:text-base">
          高い木が強い風をいなして、地面はおだやか。<br />
          夏は木陰、冬は北風よけ。森が勝手に整えてくれる。<br />
          気に入った木にハンモックをかけて昼寝するのも、<br />
          本を持って奥のほうに歩いていくのも、何もせずぼーっとするのも、ぜんぶ自由。
        </p>
        <p class="mt-4 text-sm leading-loose text-zinc-200 md:text-base">
          下草まで手の入った歩きやすい森を、お好きにどうぞ。
        </p>
        <p class="mt-6 text-sm md:text-base">
          <a href="/forest-day/" class="text-zinc-100 underline underline-offset-4 transition hover:text-white">何もしない贅沢を森の中で →</a>
        </p>
      </div>
    </div>
  </section>

  {/* 3. 四季。見出しはスライダー内（左上）に重ねている。
      各スライドは /seasons/ の該当の季節へ。下の帯は /seasons/ 全体へのリンク（スライダーと同じ地の色でつなぐ）。 */}
  <SeasonSlider />
  <div class="bg-[#1a2118]">
    <div class="mx-auto max-w-6xl px-6 py-5 md:px-10">
      {/* 矢印は、下線を矢印の下まで引けるよう、絵（svg）でなく字の → にしている */}
      <a
        href="/seasons/"
        class="text-sm tracking-[0.14em] text-zinc-200 underline decoration-white/40 underline-offset-4 transition hover:text-white hover:decoration-white"
        data-cta="top-to-seasons"
        data-cta-target="/seasons/"
      >
        四季のおいらの森を見る<span aria-hidden="true" class="link-arrow [--link-arrow-gap:0.5rem]">&nbsp;→</span>
      </a>
    </div>
  </div>

  {/* 4. ライトの一泊。前の焚き火の段の写真と文に、前の「ライトフォレストで過ごす一泊」の段の文を合わせ、/stay-light/ へ案内する。
      夜の写真をトップで使うのはこの段だけ。薪へのリンクは、見出しのすぐ下（おいらの薪）と 8. おいらの森の、ここがいい の両方にある。
      ディープの一泊は /deep/ 側で扱う（別商品として分離）。 */}
  <section
    id="bonfire"
    class="relative bg-cover bg-center py-24 md:py-32"
    style="background-image:url('/images/bonfire.jpg');"
  >
    <div class="absolute inset-0 bg-black/55"></div>
    <div class="relative z-10 mx-auto max-w-6xl px-6 md:px-10">
      <div class="max-w-2xl">
        <p class="text-xs tracking-[0.32em] text-zinc-400">A NIGHT IN THE LIGHT FOREST</p>
        <p class="mt-4 text-3xl font-semibold leading-snug text-white md:text-4xl">
          キャンプといえば焚火
        </p>
        <h2 class="mt-3 text-base font-medium text-zinc-200 md:text-lg">
          おいらの森から仕立てた最高の薪で、焚き火を満喫できるキャンプ場
        </h2>
        <p class="mt-3 text-sm tracking-[0.14em] md:text-base">
          <a
            href="/firewood/"
            class="text-zinc-100 underline decoration-white/50 underline-offset-4 transition hover:text-white hover:decoration-white"
            data-cta="top-stay-to-firewood"
            data-cta-target="/firewood/"
          >
            おいらの薪<span aria-hidden="true" class="link-arrow [--link-arrow-gap:0.5rem]">&nbsp;→</span>
          </a>
        </p>
        <p class="mt-3 text-sm tracking-[0.16em] text-zinc-300 md:text-base">
          焚き火をするためにキャンプする方も
        </p>
        <p class="mt-5 text-sm leading-loose text-zinc-200 md:text-base">
          チェックインして設営し、森の夜を過ごし、朝に片付けて帰るまで。<br />
          はじめての方でも、一泊の流れが先に分かれば準備がしやすくなります。
        </p>
        <p class="mt-8 text-sm tracking-[0.14em] md:text-base">
          <a
            href="/stay-light/"
            class="text-zinc-100 underline decoration-white/50 underline-offset-4 transition hover:text-white hover:decoration-white"
            data-cta="top-stay-to-stay-light"
            data-cta-target="/stay-light/"
          >
            ライトの一泊を見る<span aria-hidden="true" class="link-arrow [--link-arrow-gap:0.5rem]">&nbsp;→</span>
          </a>
        </p>
      </div>
    </div>
  </section>

  {/* 5. サイトを選ぶ。人数・過ごし方から /sites/ と客層の5ページへ。写真は付けない。
      料金は計算の仕方を1行だけ書き、金額は書かない（料金の計算式の正本は /reservation-guide/。spec §14.4） */}
  <section id="sites" class="py-20 md:py-28 bg-white">
    <div class="mx-auto max-w-6xl px-6 md:px-10">
      <p class="text-xs tracking-[0.32em] text-zinc-400">SITES</p>
      <h2 class="mt-3 text-2xl font-semibold leading-snug text-zinc-800 md:text-3xl">
        人数・過ごし方からサイトを選ぶ
      </h2>
      <ul class="mt-8 divide-y divide-zinc-200 border-y border-zinc-200">
        {audiences.map((a) => (
          <li>
            <a
              href={a.href}
              class="group flex items-start justify-between gap-4 py-5 transition"
              data-cta="top-to-sites"
              data-cta-target={a.href}
            >
              <span>
                <span class="block text-base font-medium text-zinc-800 transition group-hover:text-[color:var(--light-accent)]">{a.label}</span>
                <span class="mt-1 block text-sm leading-relaxed text-zinc-600">{a.copy}</span>
              </span>
              <span aria-hidden="true" class="mt-0.5 text-zinc-500 transition group-hover:text-[color:var(--light-accent)]">→</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-6">
        <a
          href="/sites/"
          class="text-sm tracking-[0.14em] text-zinc-700 underline underline-offset-4 transition hover:text-[color:var(--light-accent)]"
          data-cta="top-to-sites"
          data-cta-target="/sites/"
        >
          ライトフォレストのサイトを選ぶ<span aria-hidden="true" class="link-arrow [--link-arrow-gap:0.5rem]">&nbsp;→</span>
        </a>
      </p>
      <p class="mt-8 text-sm leading-loose text-zinc-600">
        料金は、人数の料金とサイトの料金の合計です。
        <a
          href="/reservation-guide/#price"
          class="ml-1 whitespace-nowrap text-zinc-700 underline underline-offset-4 transition hover:text-[color:var(--light-accent)]"
        >
          料金の決まり方<span aria-hidden="true" class="link-arrow [--link-arrow-gap:0.25rem]">&nbsp;→</span>
        </a>
      </p>
    </div>
  </section>

  {/* 6. プラン一覧。プラン名・価格・単位は写真に重ねず、写真の下の明るい地に書く。
      チェックイン・チェックアウトの時刻は、一覧の上に一度だけ書く */}
  <section id="plans" class="py-20 md:py-28 bg-[#f4f5f2]">
    <div class="mx-auto max-w-6xl px-6 md:px-10">
      <p class="text-xs tracking-[0.32em] text-zinc-400">PLAN</p>
      <p class="mt-3 text-2xl font-semibold text-zinc-800 md:text-3xl">プランを選ぶ</p>
      <h2 class="mt-3 text-base font-medium text-zinc-700 md:text-lg">
        ライトフォレストの全プラン。1組限定の貸切ドッグランサイトあり
      </h2>
      <p class="mt-4 text-sm leading-loose text-zinc-600">
        宿泊のプランは、チェックイン 12:00〜17:00、チェックアウト 翌12:00。日帰りデイキャンプは 9:00〜18:00。
      </p>

      <div class="mt-10 grid grid-cols-2 gap-x-3 gap-y-8 md:grid-cols-4 md:gap-x-4 md:gap-y-10">
        {plans.map((plan) => (
          <a href={proxPlanUrl(plan.id)}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex flex-col"
           data-cta="reserve" data-cta-field="light">
            <span class="relative block overflow-hidden bg-zinc-200" style="aspect-ratio: 4/3;">
              {plan.img ? (
                <Image
                  src={plan.img}
                  alt={plan.alt}
                  width={600}
                  height={450}
                  loading="lazy"
                  class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-105"
                />
              ) : (
                <span class="absolute inset-0 flex items-center justify-center">
                  <span class="text-xs tracking-[0.16em] text-zinc-600">写真 準備中</span>
                </span>
              )}
            </span>
            <span class="block pt-3">
              {plan.badge && (
                <span class="mb-1 block text-xs leading-snug text-zinc-600">{plan.badge}</span>
              )}
              <span class="block whitespace-pre-line text-sm font-semibold leading-snug text-zinc-800 md:text-base">
                {plan.name}
              </span>
              {plan.subtitle && plan.subtitle !== plan.price && (
                <span class="mt-1 block text-xs leading-snug text-zinc-600">{plan.subtitle}</span>
              )}
              <span class="mt-2 block text-sm font-medium text-zinc-800">{plan.price}</span>
              <span class="mt-2 inline-flex items-center gap-1 text-xs tracking-[0.16em] text-zinc-600 transition group-hover:text-zinc-900">
                予約する
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M5 12h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                  <path d="M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </span>
          </a>
        ))}
      </div>

      <div class="mt-10">
        <a href={PROX_SEARCH_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-xs tracking-[0.2em] text-zinc-600 transition hover:text-zinc-900"
         data-cta="reserve" data-cta-field="light">
          すべてのプランを見る
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            <path d="M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  {/* 7. 混み具合カレンダー（いまのまま） */}
  <CongestionMatrix />

  {/* 8. おいらの森の、ここがいい。写真を使わない帯。1項目1行とリンク（例外・細かい条件はリンク先にだけ書く） */}
  <section id="good-to-know" class="py-16 md:py-20 bg-white">
    <div class="mx-auto max-w-6xl px-6 md:px-10">
      <p class="text-xs tracking-[0.32em] text-zinc-400">OIRA NO MORI</p>
      <h2 class="mt-3 text-2xl font-semibold leading-snug text-zinc-800 md:text-3xl">
        おいらの森の、ここがいい
      </h2>
      <ul class="mt-8 divide-y divide-zinc-200 border-y border-zinc-200">
        {notes.map((n) => (
          <li class="py-4 md:flex md:items-baseline md:justify-between md:gap-8">
            <p class="text-sm leading-relaxed text-zinc-800 md:text-base">{n.text}</p>
            <p class="mt-2 flex flex-wrap gap-x-5 gap-y-1 md:mt-0 md:shrink-0">
              {n.links.map((l) => (
                <a
                  href={l.href}
                  class="text-sm text-zinc-600 underline underline-offset-4 transition hover:text-[color:var(--light-accent)]"
                  data-cta={l.cta}
                >
                  {l.text}<span aria-hidden="true" class="link-arrow [--link-arrow-gap:0.25rem]">&nbsp;→</span>
                </a>
              ))}
            </p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* 9. 今日のおいらの森・天気・お知らせ（最後に回す） */}

  {/* 今日のおいらの森（client-fetch widget。最新1件と一覧へのリンク。取得失敗・0件時は JS でセクションごと非表示） */}
  <section id="forest-daily-widget" class="py-10 md:py-14 bg-[#f4f5f2]" hidden>
    <div class="mx-auto max-w-6xl px-4 md:floating-tab-gutter">
      <p class="text-xs tracking-[0.32em] text-zinc-400">FOREST DAILY</p>
      <h2 class="mt-3 text-2xl font-semibold leading-snug text-zinc-800 md:text-3xl">
        今日のおいらの森
      </h2>
      <ul id="fd-widget-list" class="mt-5 divide-y divide-zinc-200 border-t border-zinc-200"></ul>
      <div class="mt-6">
        <a
          href="/forest-daily/"
          class="inline-flex items-center gap-2 text-sm tracking-[0.14em] text-zinc-600 transition hover:text-zinc-900"
        >
          過去のおいらの森
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            <path d="M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  {/* 天気（/now/ への案内）。今日のおいらの森が隠れても、上の帯（白）と色が続かないよう地の色を変えている */}
  <section id="forest-now" class="py-10 md:py-14 bg-[#eef1ec]">
    <div class="mx-auto max-w-6xl px-4 md:floating-tab-gutter">
      <p class="text-xs tracking-[0.32em] text-zinc-400">FOREST WEATHER</p>
      <h2 class="mt-3 text-2xl font-semibold leading-snug text-zinc-800 md:text-3xl">
        おいらの森の天気と気象
      </h2>
      <p class="mt-4 text-sm leading-loose text-zinc-600">
        天気、雨雲、週間予報、那須烏山アメダス。ライブカメラも、ここで確認できます。
      </p>
      <ul class="mt-5 divide-y divide-zinc-200 border-t border-zinc-200">
        <li>
          <a
            href="/now/"
            class="flex items-center justify-between gap-4 py-4 text-sm text-zinc-700 transition hover:text-[color:var(--light-accent)]"
          >
            <span>天気・気温・ライブカメラを見る</span>
            <span aria-hidden="true">→</span>
          </a>
        </li>
        <li>
          <a
            href="/forest-daily/"
            class="flex items-center justify-between gap-4 py-4 text-sm text-zinc-700 transition hover:text-[color:var(--light-accent)]"
          >
            <span>今日の記録を読む</span>
            <span aria-hidden="true">→</span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  {/* お知らせ */}
  <section id="news" class="py-12 md:py-16 bg-white">
    <div class="mx-auto max-w-6xl px-4 md:floating-tab-gutter">
      <OshiraseList items={contents} />
    </div>
  </section>

  <script>
    // ════════════════════════════════════════════════════════════
    //  今日のおいらの森 トップ widget（最新1件・サムネ無しの行）
    //  - forestDaily.ts の fetchForestDailyList(1,0) / formatPostDateMD を再利用
    //  - 「M月D日 タイトル」を1行に連結。日付不正時はタイトルのみへフォールバック
    //  - 1行 truncate（折り返さず右で省略）
    //  - API 由来テキストは textContent でセット（XSS 回避・innerHTML 不使用）
    //  - 取得失敗・0件はセクションごと非表示のまま（空枠を残さない）
    // ════════════════════════════════════════════════════════════
    import {
      fetchForestDailyList,
      formatPostDateMD,
      type ForestDaily,
    } from "../lib/forestDaily";

    const section = document.getElementById("forest-daily-widget");
    const list = document.getElementById("fd-widget-list");

    function widgetRow(item: ForestDaily): HTMLElement {
      const li = document.createElement("li");
      const a = document.createElement("a");
      a.href = `/forest-daily/?id=${encodeURIComponent(item.id)}`;
      a.className =
        "group block py-2.5 transition hover:text-zinc-900";

      const title = document.createElement("span");
      title.className =
        "block whitespace-nowrap overflow-hidden text-ellipsis text-sm font-medium leading-snug text-zinc-700 group-hover:text-zinc-900";
      const md = formatPostDateMD(item.postDate);
      title.textContent = md ? `${md} ${item.title}` : item.title;
      a.appendChild(title);

      li.appendChild(a);
      return li;
    }

    async function init(): Promise<void> {
      if (!section || !list) return;
      let data: { contents: ForestDaily[]; totalCount: number };
      try {
        data = await fetchForestDailyList(1, 0);
      } catch (e) {
        console.warn("[forest-daily widget] 取得失敗", e);
        return; // セクションは hidden のまま
      }
      if (data.contents.length === 0) return; // 0件はセクションごと非表示
      for (const item of data.contents) list.appendChild(widgetRow(item));
      section.hidden = false;
    }

    init();
  </script>

</LpLayout>
