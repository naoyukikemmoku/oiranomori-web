  <script>
    // ════════════════════════════════════════════════════════════
    //  今日のおいらの森 トップ widget（直近7件・サムネ無しの行リスト）
    //  - forestDaily.ts の fetchForestDailyList(7,0) / formatPostDateMD を再利用
    //  - 「M月D日 タイトル」を1行に連結。日付不正時はタイトルのみへフォールバック
    //  - 1行 truncate（折り返さず右で省略）。余白は密に
    //  - API 由来テキストは textContent でセット（XSS 回避・innerHTML 不使用）
    //  - 取得失敗・0件はセクションごと非表示のまま（空枠を残さない）
    // ════════════════════════════════════════════════════════════
    import {
      fetchForestDailyList,
      formatPostDateMD,
      type ForestDaily,
    } from "../lib/forestDaily";

    const section = document.getElementById("forest-daily-widget");
    const list = document.getElementById("fd-widget-list");

    function widgetRow(item: ForestDaily): HTMLElement {
      const li = document.createElement("li");
      const a = document.createElement("a");
      a.href = `/forest-daily/?id=${encodeURIComponent(item.id)}`;
      a.className =
        "group block py-2.5 transition hover:text-zinc-900";

      const title = document.createElement("span");
      title.className =
        "block whitespace-nowrap overflow-hidden text-ellipsis text-sm font-medium leading-snug text-zinc-700 group-hover:text-zinc-900";
      const md = formatPostDateMD(item.postDate);
      title.textContent = md ? `${md} ${item.title}` : item.title;
      a.appendChild(title);

      li.appendChild(a);
      return li;
    }

    async function init(): Promise<void> {
      if (!section || !list) return;
      let data: { contents: ForestDaily[]; totalCount: number };
      try {
        data = await fetchForestDailyList(7, 0);
      } catch (e) {
        console.warn("[forest-daily widget] 取得失敗", e);
        return; // セクションは hidden のまま
      }
      if (data.contents.length === 0) return; // 0件はセクションごと非表示
      for (const item of data.contents) list.appendChild(widgetRow(item));
      section.hidden = false;
    }

    init();
  </script>

