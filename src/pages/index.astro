---
import { Image } from "astro:assets";
import planDaycamp from "../assets/images/plan_daycamp.JPEG";
import planDogrun from "../assets/images/plan_dogrun.JPEG";
import planStandard from "../assets/images/plan_standard.JPEG";
import planTrain from "../assets/images/plan_train.JPEG";
import CongestionMatrix from "../components/CongestionMatrix.astro";
import OshiraseList from "../components/OshiraseList.astro";
import SeasonSlider from "../components/SeasonSlider.astro";
import { PROX_SEARCH_URL, proxPlanUrl } from "../config/nav";
import LpLayout from "../layouts/LpLayout.astro";
import { getOshirase } from "../lib/oshirase";

const { contents } = await getOshirase(3);

const plans: Array<{
	name: string;
	price: string;
	ci: string;
	co: string;
	id: number;
	img: typeof planStandard | null;
	alt: string;
	badge?: string;
	subtitle?: string;
	body?: string;
}> = [
	{
		name: "スタンダード・\nオートサイト",
		price: "¥3,300/サイト〜",
		ci: "IN 12:00〜17:00",
		co: "チェックアウト 翌12:00",
		id: 4,
		img: planStandard,
		alt: "那須烏山 里山パークおいらの森 スタンダード・オートサイトのキャンプサイト",
	},
	{
		name: "区画サイト",
		price: "¥3,300/サイト〜",
		ci: "IN 12:00〜17:00",
		co: "チェックアウト 翌12:00",
		id: 5,
		img: null,
		alt: "",
		subtitle: "車の乗り入れなし",
	},
	{
		name: "野営っぽく\nキャンプ",
		price: "¥3,300/サイト〜",
		ci: "IN 12:00〜17:00",
		co: "チェックアウト 翌12:00",
		id: 6,
		img: null,
		alt: "",
		subtitle: "ライトフォレスト",
	},
	{
		name: "貸切\nドッグランサイト",
		price: "¥4,400/サイト〜",
		ci: "IN 12:00〜17:00",
		co: "チェックアウト 翌12:00",
		id: 7,
		img: planDogrun,
		alt: "那須烏山 里山パークおいらの森 貸切ドッグランサイトのキャンプサイト",
		badge: "1組限定（場内に1サイト）",
		subtitle: "柵付き・専用区画",
	},
	{
		name: "日帰り\nデイキャンプ",
		price: "¥2,200/サイト〜",
		ci: "IN 9:00",
		co: "アウト 18:00",
		id: 14,
		img: planDaycamp,
		alt: "那須烏山 里山パークおいらの森 日帰りデイキャンプのキャンプサイト",
		subtitle: "9:00〜18:00",
	},
	{
		name: "ワーケーション",
		price: "平日ソロ限定",
		ci: "IN 12:00〜17:00",
		co: "チェックアウト 翌12:00",
		id: 16,
		img: null,
		alt: "",
		subtitle: "平日ソロ限定",
	},
	{
		name: "ソロ割り\nオートサイト",
		price: "平日ソロ限定",
		ci: "IN 12:00〜17:00",
		co: "チェックアウト 翌12:00",
		id: 21,
		img: null,
		alt: "",
		subtitle: "平日ソロ限定",
	},
	{
		name: "電車キャンパー\n歓迎",
		price: "¥3,300/サイト〜",
		ci: "IN 12:00〜17:00",
		co: "チェックアウト 翌12:00",
		id: 23,
		img: planTrain,
		alt: "那須烏山 里山パークおいらの森 電車キャンパー歓迎プランのキャンプサイト",
		subtitle: "送迎無料サービスあり",
	},
];
---

<LpLayout
  title="里山パークおいらの森｜栃木県那須烏山市のキャンプ場"
  description="東京埼玉から2時間。栃木県那須烏山市にある里山パーク「おいらの森」。おいらのおすすめはオートサイトとソロ区画。ファミリーから野営まで、どなたでも森の中でキャンプを楽しめます。通年営業。"
  lastUpdated="2026年5月"
>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": ["LocalBusiness", "Campground"],
    "name": "里山パークおいらの森",
    "alternateName": "フォレストパークおいらの森",
    "description": "東京埼玉から2時間。栃木県那須烏山市にある里山パークおいらの森。おいらのおすすめはオートサイトとソロ区画。ファミリーから野営まで、どなたでも森の中でキャンプを楽しめます。通年営業。",
    "url": "https://oiranomori.jp",
    "telephone": "050-3647-1047",
    "address": {
      "@type": "PostalAddress",
      "addressCountry": "JP",
      "addressRegion": "栃木県",
      "addressLocality": "那須烏山市",
      "streetAddress": "福岡1047"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 36.6384419,
      "longitude": 140.0695418
    },
    "openingHoursSpecification": [
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
        "opens": "09:00",
        "closes": "18:00"
      }
    ],
    "priceRange": "¥¥",
    "image": "https://oiranomori.jp/images/lp/hero.jpg",
    "sameAs": [
      "https://note.com/oiranomori",
      "https://instagram.com/oiranomori",
      "https://facebook.com/oiranomori",
      "https://x.com/oiranomori",
      "https://www.youtube.com/@Oiranomori"
    ]
  })} />
  <link rel="preload" as="image" href="/images/lp/hero.jpg" fetchpriority="high" slot="head" />

  {/* 1. Hero */}
  <section id="top" class="lp-hero" style="background-image:url('/images/lp/hero.jpg');">
    <div class="lp-hero__overlay"></div>
    <div class="mx-auto max-w-6xl px-5">
      <div class="lp-hero__content">
        <p class="text-xs tracking-[0.32em] text-zinc-400">OI RA NO MORI</p>
        <h1 class="mt-5 font-semibold leading-snug text-white">
          <span class="block text-2xl md:text-3xl">里山パーク</span>
          <span class="block text-5xl md:text-7xl">おいらの森</span>
        </h1>
        <p class="mt-8 max-w-2xl text-sm leading-[2] text-zinc-200 md:text-base">
          里山パークおいらの森は栃木県那須烏山の里山にある静かな森のキャンプ場。<br />
          森で遊び、森に泊まり、森を味わいに。<br />
          焚き火を眺め、朝のコーヒーを淹れ、のんびりする時間を。<br />
          明るい広葉樹林のライトフォレスト、深い針葉樹林のディープフォレスト、<br />
          2つのフィールドでお待ちしております。
        </p>
        <p class="mt-10 text-sm tracking-[0.18em]">
          <a
            href="/residents/"
            class="inline-flex items-center gap-2 text-white underline decoration-white/50 underline-offset-4 transition hover:decoration-white"
          >
            この森をつくる人 — 森の住人
            <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>
    </div>
    <a href="#season" class="lp-scroll">Scroll</a>
  </section>

  {/* 2. 今日のおいらの森（client-fetch widget。取得失敗・0件時は JS でセクションごと非表示） */}
  {/* 背景は bg-white。前後の #f4f5f2 セクションと背景リズムで視覚分離する */}
  <section id="forest-daily-widget" class="py-10 md:py-14 bg-white" hidden>
    <div class="mx-auto max-w-6xl px-4">
      <p class="text-xs tracking-[0.32em] text-zinc-400">FOREST DAILY</p>
      <h2 class="mt-3 text-2xl font-semibold leading-snug text-zinc-800 md:text-3xl">
        今日のおいらの森
      </h2>
      <ul id="fd-widget-list" class="mt-5 divide-y divide-zinc-200 border-t border-zinc-200"></ul>
      <div class="mt-6">
        <a
          href="/forest-daily/"
          class="inline-flex items-center gap-2 text-sm tracking-[0.14em] text-zinc-600 transition hover:text-zinc-900"
        >
          過去のおいらの森
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            <path d="M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  {/* 3. お知らせ */}
  <section id="news" class="py-12 md:py-16 bg-[#f4f5f2]">
    <div class="mx-auto max-w-6xl px-4">
      <OshiraseList items={contents} />
    </div>
  </section>

  {/* 【新】① 森のいま誘導。
      お知らせ・今日のおいらの森と同じ構成（狭い上下余白／見出し＋リンク列）に
      揃え、3セクションで同一感を出す。写真は置かない。 */}
  <section id="forest-now" class="py-10 md:py-14 bg-white">
    <div class="mx-auto max-w-6xl px-4">
      <p class="text-xs tracking-[0.32em] text-zinc-400">FOREST WEATHER</p>
      <h2 class="mt-3 text-2xl font-semibold leading-snug text-zinc-800 md:text-3xl">
        おいらの森の天気と気象
      </h2>
      <p class="mt-4 text-sm leading-loose text-zinc-600">
        天気、雨雲、週間予報、那須烏山アメダス。予約の混雑状況やライブカメラも、ここで確認できます。
      </p>
      <ul class="mt-5 divide-y divide-zinc-200 border-t border-zinc-200">
        <li>
          <a
            href="/now/"
            class="flex items-center justify-between gap-4 py-4 text-sm text-zinc-700 transition hover:text-[color:var(--light-accent)]"
          >
            <span>天気・気温・ライブカメラを見る</span>
            <span aria-hidden="true">→</span>
          </a>
        </li>
        <li>
          <a
            href="/forest-daily/"
            class="flex items-center justify-between gap-4 py-4 text-sm text-zinc-700 transition hover:text-[color:var(--light-accent)]"
          >
            <span>今日の記録を読む</span>
            <span aria-hidden="true">→</span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  {/* 3. 森の四季スライダー。スライダー本体は全幅のため、見出しだけ先に置く。 */}
  <section class="pt-12 pb-6 md:pt-16 md:pb-8 bg-white">
    <div class="mx-auto max-w-6xl px-4">
      <p class="text-xs tracking-[0.32em] text-zinc-400">FOUR SEASONS</p>
      <h2 class="mt-3 text-2xl font-semibold leading-snug text-zinc-800 md:text-3xl">
        おいらの森の四季
      </h2>
    </div>
  </section>
  <SeasonSlider />

  {/* 4. 焚火セクション */}
  <section
    id="bonfire"
    class="relative bg-cover bg-center py-24 md:py-32"
    style="background-image:url('/images/bonfire.jpg');"
  >
    <div class="absolute inset-0 bg-black/55"></div>
    <div class="relative z-10 mx-auto max-w-6xl px-6 md:px-10">
      <div class="max-w-2xl">
        <p class="text-xs tracking-[0.32em] text-zinc-400">CAMPFIRE</p>
        <p class="mt-4 text-3xl font-semibold leading-snug text-white md:text-4xl">
          キャンプといえば焚火
        </p>
        <h2 class="mt-3 text-base font-medium text-zinc-200 md:text-lg">
          おいらの森から仕立てた最高の薪で、焚き火を満喫できるキャンプ場
        </h2>
        <p class="mt-3 text-sm tracking-[0.16em] text-zinc-300 md:text-base">
          焚き火をするためにキャンプする方も
        </p>
        <a
          href="/firewood/"
          class="mt-8 inline-flex items-center gap-2 rounded border border-white/40 bg-white/10 px-5 py-2.5 text-sm tracking-[0.16em] text-zinc-200 backdrop-blur-sm transition hover:bg-white/20 hover:text-white hover:border-white/60"
        >
          林業家おいらの最高の薪
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            <path d="M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  {/* 5. アーリーチェックイン。焚き火セクションと同じ背景写真構成。
      注意書き・補足は写真に重ねず、直下の明るい帯に置く。 */}
  <section
    id="early-checkin"
    class="relative bg-cover bg-center py-24 md:py-32"
    style="background-image:url('/images/lp/lp-early-checkin.jpg');"
  >
    <div class="absolute inset-0 bg-black/55"></div>
    <div class="relative z-10 mx-auto max-w-6xl px-6 md:px-10">
      <div class="max-w-2xl">
        <p class="text-xs tracking-[0.32em] text-zinc-400">EARLY CHECK-IN</p>
        <p class="mt-4 text-3xl font-semibold leading-snug text-white md:text-4xl">
          キャンプを存分に楽しんでもらいたい。
        </p>
        <h2 class="mt-3 text-base font-medium text-zinc-200 md:text-lg">
          チェックイン 12:00〜17:00（9:00〜アーリーチェックイン無料）／チェックアウト 翌12:00
        </h2>
        <p class="mt-5 text-sm leading-loose text-zinc-300 md:text-base">
          だからアーリーチェックインは無料にしています。<br />
          朝から来て、翌日12時のチェックアウトまでこの森でゆっくりと時間を過ごしてほしい。<br />
          それがおいらの想いです。
        </p>
      </div>
    </div>
  </section>

  {/* 上の写真に重ねない注意書き */}
  <section class="py-8 md:py-10 bg-[#eef1ec]">
    <div class="mx-auto max-w-6xl px-6 md:px-10">
      <p class="text-sm leading-loose text-zinc-600">
        アーリーチェックインはエリアに余裕がある場合のみ。前日までにご連絡ください。
      </p>
      <p class="mt-3 text-sm leading-loose text-zinc-600">
        基本は年中無休ですが、ご予約がない日は臨時休業とする場合があります。
        当日のご来場をお考えの場合は、事前にお電話ください。当日のご予約はお電話で承ります。
      </p>
    </div>
  </section>

  {/* 【新】② 周辺便利。背景写真構成。件数・リンクは写真下の帯に置く。 */}
  <section
    id="neighborhood"
    class="relative bg-cover bg-center py-24 md:py-32"
    style="background-image:url('/images/lp/lp-neighborhood.jpg');"
  >
    <div class="absolute inset-0 bg-black/55"></div>
    <div class="relative z-10 mx-auto max-w-6xl px-6 md:px-10">
      <div class="max-w-2xl">
        <p class="text-xs tracking-[0.32em] text-zinc-400">NEIGHBORHOOD</p>
        <p class="mt-4 text-3xl font-semibold leading-snug text-white md:text-4xl">
          森の中だけど、不便じゃない。
        </p>
        <h2 class="mt-3 text-base font-medium text-zinc-200 md:text-lg">
          温泉もスーパーも車で10分。栃木県那須烏山市の里山キャンプ場
        </h2>
        <p class="mt-5 text-sm leading-loose text-zinc-300 md:text-base">
          森の中だけど、車で10分も走れば<br />
          温泉、スーパー、食事処、観光スポット、だいたい揃ってる。<br />
          忘れ物しても、温泉に浸かりに出ても、すぐ戻ってこれる距離。
        </p>
      </div>
    </div>
  </section>

  {/* 上の写真に重ねない件数・アクセスとリンク */}
  <section class="py-10 md:py-12 bg-[#f4f5f2]">
    <div class="mx-auto max-w-6xl px-6 md:px-10">
      <dl class="grid grid-cols-2 gap-x-8 gap-y-4 sm:grid-cols-3">
        {[
          { label: "食事", count: "14件" },
          { label: "温泉・お風呂", count: "11件" },
          { label: "買い物", count: "20件" },
          { label: "観光スポット", count: "13件" },
          { label: "救急医療", count: "1件" },
        ].map(({ label, count }) => (
          <div>
            <dt class="text-xs text-zinc-400">{label}</dt>
            <dd class="mt-0.5 text-base font-semibold text-zinc-800">{count}</dd>
          </div>
        ))}
      </dl>
      <dl class="mt-6 grid grid-cols-3 gap-x-8 gap-y-4">
        {[
          { label: "東京駅から", count: "約2時間" },
          { label: "大宮駅から", count: "約1時間40分" },
          { label: "宇都宮駅から", count: "約40分" },
        ].map(({ label, count }) => (
          <div>
            <dt class="text-xs text-zinc-400">{label}</dt>
            <dd class="mt-0.5 text-base font-semibold text-zinc-800">{count}</dd>
          </div>
        ))}
      </dl>
      <p class="mt-8">
        <a
          href="/map/"
          class="inline-flex items-center gap-2 text-sm tracking-[0.14em] text-zinc-700 underline underline-offset-4 transition hover:text-[color:var(--light-accent)]"
        >
          周辺マップを見る
          <span aria-hidden="true">→</span>
        </a>
      </p>
    </div>
  </section>

  {/* 6. ライトフォレスト紹介 ①。背景写真構成。リンクは写真下の帯に置く。 */}
  <section
    class="relative bg-cover bg-center py-24 md:py-32"
    style="background-image:url('/images/IMG_0552.JPEG');"
  >
    <div class="absolute inset-0 bg-black/55"></div>
    <div class="relative z-10 mx-auto max-w-6xl px-6 md:px-10">
      <div class="max-w-2xl">
        <p class="text-xs tracking-[0.32em] text-zinc-400">LIGHT FOREST</p>
        <p class="mt-4 text-3xl font-semibold leading-snug text-white md:text-4xl">
          おいらが家族と暮らす森に、お越しください。
        </p>
        <h2 class="mt-3 text-base font-medium text-zinc-200 md:text-lg">
          家族で住む管理人がそばにいる、女性ソロも歓迎の林間オートサイト
        </h2>
        <p class="mt-5 text-sm leading-loose text-zinc-300 md:text-base">
          おいらが家族と隣接地に住んでいる、管理人常駐のキャンプ場です。<br />
          女性一人でも安心してお越しいただけます。
        </p>
      </div>
    </div>
  </section>

  {/* 上の写真に重ねないリンク */}
  <section class="py-8 md:py-10 bg-white">
    <div class="mx-auto max-w-6xl px-6 md:px-10">
      <div class="flex flex-wrap items-center gap-x-8 gap-y-3">
        <a
          href="/sites/"
          class="inline-flex items-center gap-2 text-sm tracking-[0.14em] text-zinc-700 underline underline-offset-4 transition hover:text-[color:var(--light-accent)]"
          data-cta="top-to-sites"
        >
          自分に合うサイトを選ぶ
          <span aria-hidden="true">→</span>
        </a>
        <a
          href="/stay-light/"
          class="inline-flex items-center gap-2 text-sm tracking-[0.14em] text-zinc-700 underline underline-offset-4 transition hover:text-[color:var(--light-accent)]"
          data-cta="top-to-stay-light"
          data-cta-target="/stay-light/"
        >
          ライトの一泊を見る
          <span aria-hidden="true">→</span>
        </a>
        <a
          href="/light-guide/"
          class="inline-flex items-center gap-2 text-sm tracking-[0.14em] text-zinc-700 underline underline-offset-4 transition hover:text-zinc-900"
        >
          利用案内を見る
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  {/* ライトの一泊。ディープの一泊は /deep/ 側で扱う（別商品として分離）。 */}
  <section class="py-20 md:py-28 bg-[#eef1ec]">
    <div class="mx-auto max-w-6xl px-6 md:px-10">
      <p class="text-xs tracking-[0.32em] text-zinc-400">A NIGHT IN THE LIGHT FOREST</p>
      <p class="mt-4 text-2xl font-semibold leading-snug text-zinc-800 md:text-3xl">
        ライトフォレストで過ごす一泊
      </p>
      <h2 class="mt-3 text-base font-medium text-zinc-700 md:text-lg">
        受付、炊事場、水洗トイレのあるフィールド。到着から翌朝まで、時間の流れで紹介します
      </h2>
      <p class="mt-6 max-w-2xl text-sm leading-loose text-zinc-600 md:text-base">
        チェックインして設営し、森の夜を過ごし、朝に片付けて帰るまで。
        はじめての方でも、一泊の流れが先に分かれば準備がしやすくなります。
      </p>
      <p class="mt-8">
        <a
          href="/stay-light/"
