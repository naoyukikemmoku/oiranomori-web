---
import { Picture } from "astro:assets";
import slAft1 from "../../assets/images/sl_aft_1.jpg";
import slAft2 from "../../assets/images/sl_aft_2.jpg";
import slAft3 from "../../assets/images/sl_aft_3.jpg";
import slAft4 from "../../assets/images/sl_aft_4.jpg";
import slAft5 from "../../assets/images/sl_aft_5.jpg";
import slCheckin from "../../assets/images/sl_checkin.jpg";
import slCheckout from "../../assets/images/sl_checkout.jpg";
import slEve1 from "../../assets/images/sl_eve_1.jpg";
import slEve2 from "../../assets/images/sl_eve_2.jpg";
import slEve3 from "../../assets/images/sl_eve_3.jpg";
import slEve4 from "../../assets/images/sl_eve_4.jpg";
import slEve5 from "../../assets/images/sl_eve_5.jpg";
import slMorning from "../../assets/images/sl_morning.jpg";
import slNight from "../../assets/images/sl_night.jpg";
import slPitch from "../../assets/images/sl_pitch.jpg";
import slStarry from "../../assets/images/sl_starry.jpg";
import { PROX_SEARCH_URL } from "../../config/nav";
import PageLayout from "../../layouts/PageLayout.astro";

const TITLE = "ライトフォレストで過ごす一泊｜里山パークおいらの森";
const DESC =
	"受付や水洗トイレのあるライトフォレストで、チェックイン、設営、森の夜、翌朝の片付けまで。おいらの森で過ごす一泊を時間の流れに沿って紹介します。";
const URL = "https://oiranomori.jp/stay-light/";

// 時間軸セクション。時刻表記の正本は /light-guide/（タイムライン）。
// ここは体験の文脈に必要な範囲だけを示し、設備一覧は複製しない。
//   body: 段落（配列＝複数段落）
//   link: 節末の補助導線（任意）
//   photo: 写真枠の役割メモ（写真は別途選定）
//   img/alt: 単枠の写真
//   slides: [{src, alt}...] スライダー（午後・夕方＝5枚）
const chapters = [
	{
		id: "checkin",
		img: slCheckin,
		alt: "新緑の木立に囲まれた木造の受付・売店",
		time: "9:00〜17:00",
		heading: "受付をして、森へ入る",
		body: [
			"到着したら、まず受付へ。利用方法と当日の案内を確認してから、予約したサイトへ向かいます。ライトフォレストは、受付、炊事場、水洗トイレのあるフィールドです。",
			"受付は9:00に開きます。9:00〜12:00はアーリーチェックインの時間帯で、前日の利用状況など条件が合えば無料で入場できます。利用できるかどうかは、必ず来場前に確認してください。通常のチェックインは12:00からです。",
			"17:00がチェックインリミットです。安全管理上、これを過ぎると入場できません。遅れそうなときは必ずご連絡ください。",
		],
		photo:
			"受付から木立のサイトへ向かう流れが分かる写真。施設案内写真だけにしない。",
	},
	{
		id: "pitch",
		img: slPitch,
		alt: "木立の間の区画に設営したテントとタープ",
		time: "受付後",
		heading: "木立の中に、居場所をつくる",
		body: [
			"サイトに着いたら、車、テント、タープをどこへ置くかを決めます。木の位置や地面の形は、区画ごとに少しずつ違います。張り綱まで区画内に収め、歩くための余白を残して設営します。",
			"空いている日は、当日の状況を受付で確認のうえ、お好きなサイトを選んでいただけます。木立の間隔や地面の傾き、トイレまでの距離を実際に見てから決められます。",
		],
		link: {
			href: "/sites/",
			text: "自分に合うサイトを選ぶ",
			cta: "stay-light-to-sites",
		},
		photo: "木、地面、車、テントの位置関係が分かる全景。",
	},
	{
		id: "afternoon",
		time: "午後",
		heading: "何かをしても、何もしなくてもいい",
		body: [
			"設営が終わったら、過ごし方はそれぞれです。遅い昼食をとる。コーヒーを淹れる。本を読む。森の中を歩く。椅子に座ったまま、木漏れ日や風の変化を眺める。決められたプログラムはありません。",
			"子ども連れ、ソロ、ふたり、グループでは、必要な広さも過ごし方も変わります。同行者に合う選び方は、各案内ページで確認できます。",
		],
		link: {
			href: "/sites/",
			text: "人数・過ごし方からサイトを選ぶ",
			cta: "stay-light-to-sites-audience",
		},
		photo: "食事、読書、休憩など、作り込みすぎていない実際の過ごし方。",
		slides: [
			{ src: slAft1, alt: "木漏れ日の下、チェアを広げて過ごす午後のサイト" },
			{ src: slAft2, alt: "テーブルに道具を並べて過ごす林間サイトの午後" },
			{ src: slAft3, alt: "木立の間に張ったタープの下でくつろぐ時間" },
			{ src: slAft4, alt: "森の中でコーヒーを淹れる道具まわり" },
			{ src: slAft5, alt: "落ち葉の地面と、設営を終えたサイトの午後" },
		],
	},
	{
		id: "evening",
		time: "夕方",
		heading: "暗くなる前に、夜の準備をする",
		body: [
			"森は日が傾くと、思ったより早く暗くなります。明るいうちに食事の支度を進め、ライトや寝具を使える状態にしておきます。焚き火をするなら、周囲との距離や風を確かめ、火から離れないようにします。",
			"夕食は、炭火で焼くか、焚き火で煮込むか、持ち込んだものを温めるだけでも構いません。薪や炭、飲み物は売店で購入できます。売店と薪販売は17:30に終わるので、必要なものは明るいうちに揃えておくと安心です。",
			"場内全体を照らす照明はありません。移動用のライトは、手に取りやすい場所へ置いてください。",
		],
		photo:
			"日没前後の光と、夕食または焚き火。大人数の宴会に見える写真は使わない。",
		slides: [
			{ src: slEve1, alt: "日が傾き、焚き火の準備を始めるサイト" },
			{ src: slEve2, alt: "夕暮れのタープとランタンの灯り" },
			{ src: slEve3, alt: "薪ストーブに火を入れた夕方のサイト" },
			{ src: slEve4, alt: "焚き火を囲んで食事の支度をする夕方" },
			{ src: slEve5, alt: "暗くなりはじめた林間と、灯りのともるテント" },
		],
	},
	{
		id: "starry",
		img: slStarry,
		alt: "夜、ランタンの灯りだけが残る静かなサイト",
		time: "21:00",
		heading: "森の夜を、みんなで静かにつくる",
		body: [
			"21時からは星空タイムです。明かりを落とし、話し声を抑える時間。大きな音が消えると、風や木々、夜の生き物の気配が近くなります。自分のサイトだけでなく、周りの人も同じ森に泊まっていることを忘れずに過ごします。",
			"23時が消灯時間です。そこから先は、明かりも話し声も落として、森が眠る夜へ。",
			"夜間の移動にはライトを携行し、足元を確認してください。",
		],
		photo:
			"明るすぎないサイトと控えめな灯り。長時間露光で実際より明るく見せすぎない。",
	},
	{
		id: "night",
		img: slNight,
		alt: "タープの下に吊ったハンモックと夜の灯り",
		time: "就寝",
		heading: "森の暗さと音の中で眠る",
		body: [
			"テントの布一枚を隔てた向こうは、夜の森です。風の音、落ち葉の音、鳥や動物の声が聞こえることもあります。ホテルのように音を遮る場所ではありません。それも含めて、森に泊まる一夜です。",
		],
		photo: "消灯後の外観または夜明け前のサイト。人物の寝姿は不要。",
	},
	{
		id: "morning",
		img: slMorning,
		alt: "朝日が木々の間から差し込む森",
		time: "翌朝",
		heading: "鳥の声と、朝の光",
		body: [
			"朝は、夜とは違う森の明るさから始まります。湯を沸かし、朝食をとり、濡れた道具があれば乾かしながら片付けます。ごみは持ち帰り、落とし物がないか、使った場所に忘れ物がないかを確認します。",
		],
		photo: "朝の光、湯気、朝食、撤収前の静かなサイト。",
	},
	{
		id: "checkout",
		img: slCheckout,
		alt: "撤収を終えた区画と、朝の光の残る林間",
		time: "翌12:00",
		heading: "来たときの森へ戻して、帰る",
		body: [
			"チェックアウトは翌12:00です。テントや車を動かした後に、ペグ、ごみ、炭などが残っていないかをもう一度確認してください。チェックアウトの連絡方法は、利用案内に従います。",
		],
		photo: "撤収後の区画、または帰り際の森。",
	},
];
---

{/* ライトフォレストの一泊を時間順に伝える体験理解ページ。
    サイト選択は /sites/、設備・利用時間・ルールの正本は /light-guide/。
    本ページで設備一覧を複製しないこと（AGENTS.md §0 情報は1層だけ）。
    時刻表記（12:00 チェックアウト／21:00 星空タイム／23:00 消灯）は
    /light-guide/ のタイムラインを正とする。変更時は両方を同時に直す。 */}
<PageLayout title={TITLE} description={DESC} ogType="article">
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": TITLE,
      "description": DESC,
      "url": URL,
      "isPartOf": {
        "@type": "WebSite",
        "name": "里山パークおいらの森",
        "url": "https://oiranomori.jp"
      }
    })} />
  </Fragment>

  {/* ファーストビュー */}
  <div class="mb-12 border-b border-zinc-200 pb-8">
    <p class="text-xs tracking-[0.26em] text-zinc-400 uppercase">A Night in the Light Forest</p>
    <h1 class="mt-3 text-3xl font-semibold text-zinc-800 md:text-4xl">ライトフォレストで過ごす一泊</h1>
    <p class="mt-4 max-w-2xl text-sm leading-loose text-zinc-500">
      森に着き、木立の中に自分たちの居場所をつくる。食べて、火を眺め、静かな夜を過ごし、鳥の声で朝を迎える。
      ライトフォレストの一泊を、到着から順に紹介します。
    </p>
    <p class="mt-6 text-sm leading-loose text-zinc-600">
      アーリーチェックイン 9:00〜12:00（無料・要確認）／通常チェックイン 12:00〜／チェックインリミット 17:00／チェックアウト 翌12:00
    </p>
  </div>

  {/* 時間軸本編。スマホで上から自然に読めるよう、1カラムの縦の流れを崩さない。
      md 以上でのみ時刻を左カラムへ寄せる。白いカードは使わない（禁忌事項）。 */}
  <div class="mb-14 divide-y divide-zinc-200 border-b border-zinc-200">
    {chapters.map((c) => (
      <section id={c.id} class="py-9 md:grid md:grid-cols-[9rem_1fr] md:gap-10">
        <p class="text-sm tracking-[0.16em] text-zinc-400 md:pt-1">{c.time}</p>
        <div class="mt-2 md:mt-0">
          <h2 class="text-xl font-semibold text-zinc-800">{c.heading}</h2>

          {c.slides ? (
            <div class="mt-5">
              <ul
                class="flex snap-x snap-mandatory gap-3 overflow-x-auto pb-2"
                aria-label={`${c.heading}の写真`}
              >
                {c.slides.map((sl) => (
                  <li class="w-[78%] shrink-0 snap-start sm:w-[46%]">
                    <Picture
                      src={sl.src}
                      formats={["avif", "webp"]}
                      alt={sl.alt}
                      loading="lazy"
                      sizes="(max-width: 640px) 78vw, 22rem"
                      class="aspect-[4/3] w-full object-cover"
                    />
                  </li>
                ))}
              </ul>
              <p class="mt-1 text-xs text-zinc-400">横にスワイプすると続きの写真を見られます。</p>
            </div>
          ) : (
            c.img ? (
              <Picture
                src={c.img}
                formats={["avif", "webp"]}
                alt={c.alt}
                loading="lazy"
                sizes="(max-width: 768px) 100vw, 44rem"
                class="mt-5 aspect-[16/9] w-full object-cover"
              />
            ) : (
              <span class="mt-5 flex aspect-[16/9] w-full items-center justify-center border border-dashed border-zinc-300 bg-zinc-50">
                <span class="text-xs tracking-[0.16em] text-zinc-400">写真 準備中</span>
              </span>
            )
          )}

          {c.body.map((p) => (
            <p class="mt-4 text-sm leading-loose text-zinc-600">{p}</p>
          ))}
          {c.link && (
            <p class="mt-4 text-sm">
              <a
                href={c.link.href}
                class="underline underline-offset-2 text-[color:var(--light-accent)] transition hover:opacity-80"
                data-cta={c.link.cta}
                data-cta-target={c.link.href}
              >
                {c.link.text} →
              </a>
            </p>
          )}
        </div>
      </section>
    ))}
  </div>

  {/* 予約前に確認する */}
  <section class="mb-14">
    <h2 class="mb-2 text-xl font-semibold text-zinc-800">予約前に確認する</h2>
    <p class="mb-6 max-w-2xl text-sm leading-loose text-zinc-500">
      一泊の様子が想像できたら、次はサイトと利用条件を確認してください。
      サイトの広さや場所はそれぞれ違い、料金は利用日と人数によって決まります。
    </p>
    <div class="flex flex-wrap items-center gap-x-8 gap-y-4">
      <a
        href={PROX_SEARCH_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center rounded-full bg-[color:var(--forest-600)] px-7 py-3 text-sm text-white shadow-sm transition hover:bg-[color:var(--forest-700)]"
        data-cta="reserve"
        data-cta-field="light"
      >
        空き状況と料金を確認する ↗
      </a>
      <a
        href="/sites/"
        class="text-sm underline underline-offset-2 text-[color:var(--light-accent)] transition hover:opacity-80"
        data-cta="stay-light-to-sites"
        data-cta-target="/sites/"
      >
        自分に合うサイトを選ぶ →
      </a>
      <a
        href="/light-guide/"
        class="text-sm text-zinc-600 underline underline-offset-2 transition hover:text-zinc-800"
      >
        設備・利用時間・ルールを見る →
      </a>
    </div>
  </section>
</PageLayout>
