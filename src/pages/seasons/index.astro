		],
		cards: [
			{
				slot: "seasons-autumn-koyo",
				title: "紅葉の見頃",
				img: autumnKoyo,
				alt: "黄色く色づいた木々と、落ち葉の積もった林に差す秋の日差し",
				body: [
					"紅葉の時期は、年によって10日ほど違います。イチョウも黄色くなります。",
				],
				rows: [
					{ term: "色づき始め", when: "10月中旬〜下旬" },
					{
						term: "見頃",
						when: "11月上旬〜下旬",
						note: "2022年は11月8〜9日、2023年は11月20〜24日でした。",
					},
					{ term: "終わり", when: "11月末〜12月初め" },
				],
			},
			{
				slot: "seasons-autumn-leaffall",
				title: "落葉のあとの明るい森",
				img: autumnLeaffall,
				alt: "葉を落とした木々と、落ち葉に覆われた林床",
				body: ["葉が落ちると、日差しの入る明るく静かな森になります。"],
			},
			{
				slot: "seasons-autumn-cold",
				title: "秋キャンプの服装と、朝晩の冷え込み",
				img: autumnCold,
				alt: "色づいた木々の間から、田んぼの広がる谷を見下ろす人と犬",
				body: [
					"9月下旬になると、夏用のシュラフでは寒くなります。3シーズン用のシュラフと、長袖や上着があると安心です。10月に入ると、蚊が減ります。",
					"霜が降りるのは11月中旬〜下旬です（2023年は森の下の谷の田んぼで11月21日）。10月の終わりは、16時45分ごろに日が沈みます。",
				],
			},
			{
				slot: "seasons-autumn-holidays",
				title: "秋の連休",
				img: autumnHolidays,
				alt: "色づいた木々に囲まれた、日差しの入る広い地面",
				body: [
					"秋の連休は混み合います。2024年10月の三連休は、GW並みのにぎわいでした。",
				],
			},
			{
				slot: "seasons-autumn-fire",
				title: "焚き火が気持ちいい季節",
				img: slEve4,
				alt: "日暮れどき、焚き火台の火のまわりに並べたチェア",
				body: [
					"朝晩が冷え込むようになると、朝夕の焚き火が気持ちよくなります。",
				],
