---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import aboutHero from "../../assets/images/about_hero.jpg";
import firewoodFelling from "../../assets/images/firewood_felling.jpg";
import kuwagata from "../../assets/images/lightguide_kuwagata.jpg";
import lightguideNight from "../../assets/images/lightguide_night.jpg";
import rentalWinter from "../../assets/images/rental_winter.jpg";
import autumnHero from "../../assets/images/seasons_autumn.jpg";
import autumnCold from "../../assets/images/seasons_autumn_cold.jpg";
import autumnHolidays from "../../assets/images/seasons_autumn_holidays.jpg";
import autumnKoyo from "../../assets/images/seasons_autumn_koyo.jpg";
import autumnLeaffall from "../../assets/images/seasons_autumn_leaffall.jpg";
import springHero from "../../assets/images/seasons_spring.jpg";
import springBirds from "../../assets/images/seasons_spring_birds.jpg";
import springEvents from "../../assets/images/seasons_spring_events.jpg";
import springFlowers from "../../assets/images/seasons_spring_flowers.jpg";
import springShinryoku from "../../assets/images/seasons_spring_shinryoku.jpg";
import summerHero from "../../assets/images/seasons_summer.jpg";
import summerFirefly from "../../assets/images/seasons_summer_firefly.jpg";
import winterHero from "../../assets/images/seasons_winter.jpg";
import winterCold from "../../assets/images/seasons_winter_cold.jpg";
import winterNewyear from "../../assets/images/seasons_winter_newyear.jpg";
import winterSnow from "../../assets/images/seasons_winter_snow.jpg";
import sitesFamilySpace from "../../assets/images/sites_family_space.jpg";
import sitesGroupSize from "../../assets/images/sites_group_size.jpg";
import slAft4 from "../../assets/images/sl_aft_4.jpg";
import slEve3 from "../../assets/images/sl_eve_3.jpg";
import slEve4 from "../../assets/images/sl_eve_4.jpg";
import { PROX_SEARCH_URL } from "../../config/nav";
import PageLayout from "../../layouts/PageLayout.astro";

const TITLE =
	"おいらの森の四季｜那須烏山の林間キャンプ場で過ごす春夏秋冬｜里山パークおいらの森";
const DESC =
	"春はヤマザクラと新緑、夏は木陰とホタル、カブトムシ・クワガタ、秋は紅葉と焚き火、冬は薪ストーブと年越しキャンプ。栃木県那須烏山市の林間キャンプ場、里山パークおいらの森の春夏秋冬と、花や虫の時期を紹介します。";
const URL = "https://oiranomori.jp/seasons/";
const OG_IMAGE = new globalThis.URL(springHero.src, Astro.site).href;

// ライトフォレストの春夏秋冬。虫・生き物の時期の正本（spec §14.4）。
// 選ぶページのため、禁止事項・例外・細かい価格は書かない（spec §14.3）。決まりは利用案内へリンクする。
// 行事は「毎年やっている」と書かず、記録と「開く年はお知らせで案内する」を組みにして /news/ へ。
// 写真はすべて仮。差し替えは docs/photo-workflow-handoff.md の手順（CSV が正本）で、
// slot（差し替え用の識別名）ごとに img と alt を入れ替える。alt に「直火」の語を入れない（CLAUDE.md §2）。
type Row = { term: string; when: string; note?: string };
type Card = {
	slot: string;
	title: string;
	img: ImageMetadata;
	alt: string;
	body: string[];
	rows?: Row[];
	/** 表のあとに置く文 */
	after?: string[];
	links?: { href: string; text: string }[];
};
type Season = {
	id: string;
	en: string;
	heading: string;
	slot: string;
	img: ImageMetadata;
	alt: string;
	/** 横長に切り抜くとき（PC）に見せる位置。写真を差し替えたら見直す */
	pos?: string;
	lead: string[];
	cards: Card[];
	note?: { text: string; href: string; linkText: string };
};

const seasons: Season[] = [
	{
		id: "spring",
		en: "SPRING",
		heading: "春の森",
		slot: "seasons-spring-hero",
		img: springHero,
		alt: "新緑の広葉樹林と、木立の奥に張られたテント",
		lead: [
			"2月の終わりにウメが咲き、コブシ、ヤマザクラと花が続きます。4月に新緑が始まり、5月には森の緑が濃くなります。",
		],
		cards: [
			{
				slot: "seasons-spring-flowers",
				title: "春の花とヤマザクラの見頃",
				img: springFlowers,
				alt: "青空に白い花を広げるヤマザクラの大木",
				body: ["花は、ウメ、コブシ、ヤマザクラの順に咲きます。"],
				rows: [
					{
						term: "ウメ",
						when: "2月中旬〜3月上旬",
						note: "開花は2021年が2月22日、2022年が3月7日、2023年が2月20日、2025年が2月27日でした。年によって幅があります。",
					},
					{
						term: "コブシ",
						when: "3月中旬〜下旬",
						note: "2021年は3月14日、2024年は3月18日に咲き始めました。2023年は3月15日に2分咲き、3月20日に満開間近でした。",
					},
					{
						term: "ヤマザクラ",
						when: "4月初め〜中旬",
						note: "2023年は4月1〜2日にほぼ満開になりました。2024年は前の年より10日ほど遅く、4月10日ごろが見頃でした。",
					},
				],
				after: [
					"早春の足元には、オオイヌノフグリ、カントウタンポポ、スミレが咲きます。2021年は、タンポポが3月9日、スミレが3月中旬に見頃でした。",
					"5月の初めごろには、森の中でキンランが咲きます（2024年は5月上旬）。",
				],
			},
			{
				slot: "seasons-spring-shinryoku",
				title: "新緑の見頃",
				img: springShinryoku,
				alt: "木々の間から光の筋が差し込む新緑の森",
				body: [
					"新緑が始まるのは4月です。2023年は4月2日、2024年は4月16日ごろに始まりました。",
					"5月になると緑が濃くなり、日差しが強くなっても、森の中はひんやりしています。",
				],
			},
			{
				slot: "seasons-spring-birds",
				title: "春の野鳥とカエルの声",
