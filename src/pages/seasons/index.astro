		alt: "緑の濃い夏の広葉樹林と、木陰の中の道",
		lead: [
			"夏は、木陰のサイトで過ごす季節です。6月にはホタルが飛び、カブトムシやクワガタが採れる時期が続きます。",
		],
		cards: [
			{
				slot: "seasons-summer-shade",
				title: "木陰で過ごす夏",
				img: sitesFamilySpace,
				alt: "木漏れ日が差す林間サイトと、木陰に張られたテント",
				body: [
					"直射日光が入るのはオートXLだけで、ほかのサイトはすべて木陰です。高原ほどではありませんが、下界より涼しく過ごせます。日中は30℃を超える日もあります。",
				],
			},
			{
				slot: "seasons-summer-firefly",
				title: "ホタルが見られる時期",
				img: summerFirefly,
				alt: "夜の畑と木立のまわりに、黄緑色の光の筋を描いて飛ぶホタル",
				body: [
					"キャンプサイトから歩いて5分ほどの谷で、ゲンジボタルが見られます。月明かりがなく、風のない蒸し暑い夜によく飛びます。",
					"谷の水路は、冬のあいだに落ち葉をかいて手入れをしています。2023年は、例年より多く飛びました。",
				],
				rows: [
					{ term: "出始め", when: "6月上旬" },
					{
						term: "最盛期",
						when: "6月中旬〜下旬",
						note: "2023年は6月18〜19日、2024年は6月21日ごろでした。",
					},
					{ term: "終わり", when: "6月末" },
					{ term: "見頃の時間", when: "19時半〜21時ごろ" },
				],
			},
			{
				slot: "seasons-summer-kuwagata",
				title: "クワガタが採れる時期",
				img: kuwagata,
				alt: "落ち葉の上を歩くノコギリクワガタ",
				body: ["ミヤマクワガタに出会えるのは、まれです。"],
				rows: [
					{
						term: "出始め",
						when: "5月下旬",
						note: "2023年は、コクワガタが5月28日、ノコギリクワガタが5月31日でした。",
					},
					{ term: "たくさん採れる", when: "6月下旬〜7月中旬" },
					{ term: "もう一度", when: "9月下旬" },
				],
			},
			{
				slot: "seasons-summer-kabuto",
