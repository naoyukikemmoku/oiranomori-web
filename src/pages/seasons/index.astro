const linkClass =
	"inline-flex items-center gap-1.5 text-sm text-[color:var(--light-accent)] underline underline-offset-4 transition hover:opacity-80";
---

{/* ライトフォレストの春夏秋冬から、泊まりたい季節を選ぶページ（spec §4・§14）。
    ディープフォレストの内容は書かない。白いカードUI・枠線・影は使わない（禁忌事項）。
    写真と文章は地の上に並べ、区切りは余白と字組みでつくる。 */}
<PageLayout title={TITLE} description={DESC} ogImage={OG_IMAGE} lastUpdated="2026年11月">
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": TITLE,
      "description": DESC,
      "url": URL,
      "isPartOf": {
        "@type": "WebSite",
        "name": "里山パークおいらの森",
        "url": "https://oiranomori.jp"
      }
    })} />
  </Fragment>

  {/* ページ見出し */}
  <div class="mb-10 border-b border-zinc-200 pb-8">
    <p class="text-xs tracking-[0.26em] text-zinc-500 uppercase">Four Seasons</p>
    <h1 class="mt-3 text-3xl font-semibold leading-snug text-zinc-800 md:text-4xl">おいらの森の四季</h1>
    <p class="mt-4 max-w-2xl text-sm leading-loose text-zinc-600">
      おいらの森は、一年を通して営業している林間キャンプ場です。春は花と新緑、夏は木陰と虫、秋は紅葉と焚き火、冬は薪ストーブと、季節ごとに森の過ごし方が変わります。
    </p>
    <p class="mt-4 max-w-2xl text-sm leading-loose text-zinc-600">
      このページでは、ライトフォレストの春夏秋冬を紹介します。花や虫の時期は年によって前後するので、日付はこれまでの記録として添えています。
    </p>

    {/* 季節へのページ内リンク */}
    <nav class="mt-7" aria-label="季節を選ぶ">
      <ul class="flex flex-wrap gap-x-7 gap-y-3 text-sm">
        {seasons.map((s) => (
          <li>
            <a href={`#${s.id}`} class="inline-flex items-center gap-1.5 text-zinc-700 underline decoration-zinc-300 underline-offset-4 transition hover:text-[color:var(--light-accent)] hover:decoration-current">
              {s.heading}
              <span aria-hidden="true">↓</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  {seasons.map((s, si) => (
    <section id={s.id} class="mb-20 scroll-mt-24 md:mb-28" aria-labelledby={`${s.id}-heading`}>
      {/* 季節の最初の写真（全幅）。見出しは写真の左下に重ねる */}
      <div class="full-bleed relative" data-photo-slot={s.slot}>
        <Picture
          src={s.img}
          formats={["avif", "webp"]}
          alt={s.alt}
          loading={si === 0 ? "eager" : "lazy"}
          fetchpriority={si === 0 ? "high" : undefined}
          widths={[768, 1280, 1920]}
          sizes="100vw"
          class={`block aspect-[4/3] w-full object-cover sm:aspect-[16/9] lg:aspect-[12/5] ${s.pos ?? ""}`}
        />
        <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/65 via-black/15 to-transparent" aria-hidden="true"></div>
        <div class="absolute inset-x-0 bottom-0">
          <div class="mx-auto max-w-6xl pb-6 pl-[1.625rem] pr-4 sm:pl-4 md:pb-10">
            <p class="text-xs tracking-[0.32em] text-zinc-200 [text-shadow:0_1px_8px_rgba(0,0,0,0.7)]">{s.en}</p>
            <h2 id={`${s.id}-heading`} class="mt-2 text-3xl font-semibold leading-snug text-white [text-shadow:0_1px_10px_rgba(0,0,0,0.75)] md:text-4xl">{s.heading}</h2>
          </div>
        </div>
      </div>

      <div class="mt-8 max-w-2xl">
        {s.lead.map((p) => (
          <p class="text-base leading-loose text-zinc-700">{p}</p>
        ))}
      </div>

      {/* 季節の見どころ。写真と短い文章を並べる（枚数は季節ごとに違う） */}
      <div class="mt-10 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
        {s.cards.map((c) => (
          <div data-photo-slot={c.slot}>
            <Picture
              src={c.img}
              formats={["avif", "webp"]}
              alt={c.alt}
              loading="lazy"
              widths={[480, 800, 1200]}
              sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 23rem"
              class="aspect-[4/3] w-full object-cover"
            />
            <h3 class="mt-4 text-base font-semibold leading-snug text-zinc-800">{c.title}</h3>
            {c.body.map((p) => (
              <p class="mt-2 text-sm leading-loose text-zinc-600">{p}</p>
            ))}
            {c.rows && (
              <dl class="mt-3 divide-y divide-zinc-100 border-y border-zinc-200 text-sm">
                {c.rows.map((r) => (
                  <div class="grid grid-cols-[6.5rem_1fr] gap-3 py-2.5">
                    <dt class="text-zinc-500">{r.term}</dt>
                    <dd class="text-zinc-800">
                      {r.when}
                      {r.note && <span class="mt-1 block text-xs leading-relaxed text-zinc-500">{r.note}</span>}
                    </dd>
                  </div>
                ))}
              </dl>
            )}
            {c.after?.map((p) => (
              <p class="mt-3 text-sm leading-loose text-zinc-600">{p}</p>
            ))}
            {c.links && (
              <p class="mt-3 flex flex-wrap gap-x-5 gap-y-1">
                {c.links.map((l) => (
                  <a href={l.href} class={linkClass}>
                    {l.text}
                    <span aria-hidden="true">→</span>
                  </a>
                ))}
              </p>
            )}
          </div>
        ))}
      </div>

      {s.note && (
        <p class="mt-10 max-w-2xl text-sm leading-loose text-zinc-600">
          {s.note.text}
          <a href={s.note.href} class={`ml-1 ${linkClass}`}>
            {s.note.linkText}
            <span aria-hidden="true">→</span>
          </a>
        </p>
      )}
    </section>
  ))}

  {/* 泊まる季節を決めたあと。条件・料金はそれぞれの正本ページへ */}
  <section class="mb-14 border-t border-zinc-200 pt-10">
    <h2 class="mb-2 text-xl font-semibold text-zinc-800">泊まる季節が決まったら</h2>
    <p class="mb-6 max-w-2xl text-sm leading-loose text-zinc-600">
      サイトの広さや設備、利用の決まりは、それぞれのページにまとめています。
    </p>
    <div class="flex flex-wrap items-center gap-x-8 gap-y-4">
      <a
        href={PROX_SEARCH_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center rounded-full bg-[color:var(--forest-600)] px-7 py-3 text-sm text-white shadow-sm transition hover:bg-[color:var(--forest-700)]"
        data-cta="reserve"
        data-cta-field="light"
      >
        空き状況と料金を確認する ↗
      </a>
      <a
        href="/sites/"
        class="text-sm underline underline-offset-2 text-[color:var(--light-accent)] transition hover:opacity-80"
        data-cta="seasons-to-sites"
        data-cta-target="/sites/"
      >
        自分に合うサイトを選ぶ →
      </a>
      <a href="/stay-light/" class="text-sm text-zinc-600 underline underline-offset-2 transition hover:text-zinc-800">
        ライトフォレストで過ごす一泊 →
      </a>
      <a href="/light-guide/" class="text-sm text-zinc-600 underline underline-offset-2 transition hover:text-zinc-800">
        設備・利用時間・ルールを見る →
      </a>
    </div>
  </section>
</PageLayout>
