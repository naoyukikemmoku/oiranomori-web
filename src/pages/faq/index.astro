<style is:global>
  /* JS が動いているときだけ、選んだカテゴリ以外を隠す（静的 HTML には全 Q を出したまま） */
  [data-faq-root][data-faq-tabs] .faq-panel:not(.is-active) {
    display: none;
  }
  /* JS が無いときはバーを出さない（全 Q を順に読める） */
  [data-faq-root]:not([data-faq-tabs]) .faq-bar {
    display: none;
  }
  .faq-bar {
    transition: top 0.3s;
  }
  .faq-bar .faq-tab.is-active {
    border-left-color: var(--light-accent);
    color: #27272a;
  }
  .faq-bar-caret {
    display: inline-block;
    transition: transform 0.2s;
  }
  .faq-bar [aria-expanded="true"] .faq-bar-caret {
    transform: rotate(180deg);
  }
  #faq-bar-list {
    max-height: calc(100vh - 8rem);
    overflow-y: auto;
  }
</style>

<script is:inline>
  (function () {
    var root = document.querySelector("[data-faq-root]");
    if (!root) return;
    var aliases = JSON.parse(root.getAttribute("data-aliases") || "{}");
    var panels = Array.prototype.slice.call(root.querySelectorAll("[data-faq-panel]"));
    var tabs = Array.prototype.slice.call(root.querySelectorAll("[data-faq-tab]"));
    var bar = root.querySelector("[data-faq-bar]");
    var toggle = bar && bar.querySelector("[data-faq-bar-toggle]");
    var list = bar && bar.querySelector("[data-faq-bar-list]");
    var label = bar && bar.querySelector("[data-faq-bar-label]");

    function show(catId) {
      panels.forEach(function (p) { p.classList.toggle("is-active", p.getAttribute("data-faq-panel") === catId); });
      tabs.forEach(function (t) {
        var on = t.getAttribute("data-faq-tab") === catId;
        t.classList.toggle("is-active", on);
        if (on) {
          t.setAttribute("aria-current", "true");
          if (label) label.textContent = t.textContent.trim();
        }
        else t.removeAttribute("aria-current");
      });
    }

    // #〜 から、開くカテゴリと移る先を決める（カテゴリの id・旧カテゴリの id・Q の id）
    function resolve(hash) {
      var id = decodeURIComponent((hash || "").replace(/^#/, ""));
      if (!id) return null;
      if (aliases[id]) id = aliases[id];
      var el = document.getElementById(id);
      if (!el || !root.contains(el)) return null;
      var panel = el.closest("[data-faq-panel]");
      if (!panel) return null;
      return { cat: panel.getAttribute("data-faq-panel"), target: panel === el ? null : el };
    }

    // 固定のヘッダーは、下へスクロールすると隠れ、上へ戻すと出る（Header.astro）。
    // 出ている間はバーをヘッダーの下に付ける（重なってバーが隠れないように）。
    var header = document.getElementById("site-header");
    function headerShown() { return !!header && !header.classList.contains("is-hidden"); }
    function syncTop() { if (bar) bar.style.top = headerShown() ? header.offsetHeight + "px" : "0px"; }
    if (header && bar) {
      syncTop();
      new MutationObserver(syncTop).observe(header, { attributes: true, attributeFilter: ["class"] });
      // ヘッダーは画面幅で1段／2段に変わる（高さが変わる）
      window.addEventListener("resize", syncTop);
    }

    function setOpen(open) {
      if (!toggle || !list) return;
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
      list.hidden = !open;
    }

    // バーの高さ（開いた一覧は含めない）
    function barH() { return bar ? bar.offsetHeight : 0; }

    // FAQ の範囲を過ぎて（バーが上へ流れて）いったら、開いた一覧を閉じる
    var ticking = false;
    window.addEventListener("scroll", function () {
      if (ticking || !toggle || toggle.getAttribute("aria-expanded") !== "true") return;
      ticking = true;
      requestAnimationFrame(function () {
        ticking = false;
        var top = parseFloat(bar.style.top) || 0;
        if (root.getBoundingClientRect().bottom <= top + barH() + 40) setOpen(false);
      });
    }, { passive: true });

    // el の上端を、バー（とヘッダーが出るならヘッダー）の下に合わせる。
    // カテゴリ自体なら、バーを上端に（バーと見出しが続けて見える）。
    function scrollToEl(el, isPanel) {
      var top = el.getBoundingClientRect().top + window.scrollY;
      var y = isPanel ? top : top - barH() - 8;
      // 上へ戻るとき・上の方（160px 以内）ではヘッダーが出る
      var headerH = header && (y < window.scrollY || y <= 160) ? header.offsetHeight : 0;
      window.scrollTo({ top: Math.max(0, y - headerH) });
    }

    function apply(hash, fromLoad) {
      var r = resolve(hash);
      if (!r) { if (fromLoad) show(panels[0].getAttribute("data-faq-panel")); return; }
      show(r.cat);
      // 開いた直後に移る（隠れていた要素は表示後でないと位置が取れない）
      requestAnimationFrame(function () { scrollToEl(r.target || root, !r.target); });
    }

    root.setAttribute("data-faq-tabs", "");
    apply(location.hash, true);

    tabs.forEach(function (t) {
      t.addEventListener("click", function (e) {
        e.preventDefault();
        var catId = t.getAttribute("data-faq-tab");
        show(catId);
        history.replaceState(null, "", "#" + catId);
        setOpen(false);
        if (toggle) toggle.focus({ preventScroll: true });
        // バーが上に貼り付いているとき（下へ読み進めた後）だけ、バーと新しいカテゴリの頭へ戻す
        if (!bar || bar.getBoundingClientRect().top > (parseFloat(bar.style.top) || 0) + 1) return;
        scrollToEl(root, true);
      });
    });

    if (toggle) {
      toggle.addEventListener("click", function () {
        setOpen(toggle.getAttribute("aria-expanded") !== "true");
      });
    }
    // 一覧の外をタップ・Esc で閉じる
    document.addEventListener("click", function (e) {
      if (bar && !bar.contains(e.target)) setOpen(false);
    });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && toggle && toggle.getAttribute("aria-expanded") === "true") {
        setOpen(false);
        toggle.focus();
      }
    });
    window.addEventListener("hashchange", function () { apply(location.hash, false); });
  })();
</script>
</PageLayout>
