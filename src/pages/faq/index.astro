---
import PageLayout from "../../layouts/PageLayout.astro";

type FaqItem = {
	id: string;
	q: string;
	/** 構造化データの name。Q の文だけでは何のことか分からないとき（「設備は？」など）に。 */
	ldName?: string;
	/** 構造化データの text。箇条書き・改行で区切った連絡先など、本文から作ると読みにくいときだけ。 */
	ldText?: string;
	/** 答えの HTML（静的に出力する。リンクだけの段落 class="mt-2 text-sm" は構造化データに入れない）。 */
	body: string;
};
type FaqCategory = { id: string; label: string; heading: string; note?: string; items: FaqItem[] };

// カテゴリと Q の並びは「お客さんが先に知りたい順」。全 Q は静的 HTML に出し、
// タブの切り替えは CSS（JS が data-faq-tabs を付けたときだけ他のカテゴリを隠す）。
const categories: FaqCategory[] = [
	{
		id: "reservation",
		label: "予約・キャンセル",
		heading: "予約・キャンセル・支払い",
		items: [
			{
				id: "book",
				q: "予約はどこからできますか？",
				body: `<p class="mt-3 text-sm leading-loose text-zinc-600">
  当HPの予約ボタン、または楽天トラベルキャンプからご予約いただけます。会員登録（無料）をすると、次回以降の入力省略・複数プラン同時予約・ポイント付与などの特典があります。
</p>
<p class="mt-2 text-sm">
  <a href="/reservation-guide/" class="underline underline-offset-2 text-zinc-600 transition hover:text-zinc-900">詳しくは予約ガイドへ →</a>
</p>`,
			},
			{
				id: "payment",
				q: "支払い方法は？ キャッシュレス決済は使えますか？",
				body: `<p class="mt-3 text-sm leading-loose text-zinc-600">
  お支払いは現地のみです（事前のオンライン決済はありません）。クレジットカード、電子マネー（交通系IC・iD・QUICPay）、QRコード決済（PayPay・楽天ペイ・au PAY・d払い・メルペイ 等）、現金に対応しています。
</p>
<p class="mt-2 text-sm">
  <a href="/policy/" class="underline underline-offset-2 text-zinc-600 transition hover:text-zinc-900">対応ブランドの詳細（特定商取引法表記）→</a>
</p>`,
			},
			{
				id: "same-day",
				q: "当日予約はできますか？",
				body: `<p class="mt-3 text-sm leading-loose text-zinc-600">
  サイトに空きがあれば、お電話のみで当日受付いたします。ただし料金は当日料金となり、HP表示の料金とは異なります。事前のご予約をおすすめします。
</p>
<p class="mt-2 text-sm text-zinc-600">
  TEL: <a href="tel:05036471047" class="underline underline-offset-2 transition hover:text-zinc-900">050-3647-1047</a>
</p>`,
			},
			{
				id: "cancel",
				q: "キャンセルしたい。",
				body: `<p class="mt-3 text-sm leading-loose text-zinc-600">
  ご自身のオンライン手続きで完結します。入口は2つあり、<strong class="text-zinc-800">予約完了メールに記載のリンク</strong>から、または会員の方は<strong class="text-zinc-800">マイページ</strong>から手続きできます。お電話をいただく必要はありません。
</p>
<p class="mt-3 text-sm leading-loose text-zinc-600">
  キャンセル料は<strong class="text-zinc-800">当日のキャンセルも無料</strong>です。連絡なく来場されない無断キャンセルのみ、ご予約料金の100%を申し受けます。楽天トラベルキャンプで予約した場合は、楽天側の画面で手続きしてください。
</p>
<p class="mt-2 text-sm">
  <a href="/reservation-guide/#change" class="underline underline-offset-2 text-zinc-600 transition hover:text-zinc-900">キャンセルのやり方を見る →</a>
</p>`,
			},
			{
				id: "change",
				q: "予約の内容を変更したい。",
				body: `<p class="mt-3 text-sm leading-loose text-zinc-600">
