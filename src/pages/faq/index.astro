// 旧カテゴリのアンカー（他ページ・外部からの /faq/#〜）を新しいカテゴリへ
const aliases: Record<string, string> = { "facility-rules": "facilities", shop: "facilities" };

// 構造化データの text：本文からタグを外す（リンクだけの段落は除く）
const toText = (html: string) =>
	html
		.replace(/<p class="mt-2 text-sm">[\s\S]*?<\/p>/g, "")
		.replace(/<br\s*\/?>/g, "")
		.replace(/<[^>]+>/g, "")
		.replace(/\s*\n\s*/g, "")
		.replace(/&amp;/g, "&")
		.trim();

// 「直火」を構造化データに入れない（CLAUDE.md §2 直火の扱い・SEO 構造タグの絶対ライン）
const ldItems = categories
	.flatMap((c) => c.items)
	.filter((it) => !/直火/.test(it.q + it.body))
	.map((it) => ({
		"@type": "Question",
		name: it.ldName ?? it.q,
		acceptedAnswer: { "@type": "Answer", text: it.ldText ?? toText(it.body) },
	}));
---

<PageLayout
  title="よくある質問（FAQ） | 里山パークおいらの森"
  description="予約・キャンセル・チェックイン・設備・フィールド別ルール・アクセスなど、よくある質問をまとめました。初めてご利用の方はこちらから確認ください。"
  lastUpdated="2026年10月"
>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": ldItems,
  })} />

  {/* ページヘッダー */}
  <div class="mb-10 border-b border-zinc-200 pb-8">
    <p class="text-xs tracking-[0.26em] text-zinc-400 uppercase">FAQ</p>
    <h1 class="mt-3 text-3xl font-semibold text-zinc-800 md:text-4xl">よくある質問（FAQ）</h1>
    <p class="mt-4 max-w-2xl text-base leading-loose text-zinc-600">
      ご利用前に寄せられることの多いご質問をまとめました。
      より詳しい内容は各ページへのリンクをご確認ください。
    </p>
  </div>

  <div class="faq-root" data-faq-root data-aliases={JSON.stringify(aliases)}>
    {/* カテゴリのバー（見出しの下に出て、スクロールしても上に残る。JS が動くときだけ使う）。
        右の余白はスマホの縦タブ（FloatingNav）の逃げ（PageLayout の main と同じ） */}
    <nav class="faq-bar sticky top-0 z-40 -ml-4 -mr-9 mb-8 border-b border-zinc-200 bg-white/95 pl-4 pr-9 backdrop-blur sm:mx-0 sm:px-0" aria-label="カテゴリ" data-faq-bar>
      <button
        type="button"
        class="flex w-full items-center gap-2 py-2.5 text-left text-sm text-zinc-800"
        aria-expanded="false"
        aria-controls="faq-bar-list"
        data-faq-bar-toggle
      >
        <span class="text-xs tracking-[0.2em] text-zinc-400">FAQ</span>
        <span data-faq-bar-label>{categories[0].label}</span>
        <span class="faq-bar-caret text-xs text-zinc-500" aria-hidden="true">▼</span>
        <span class="sr-only">カテゴリを選ぶ</span>
      </button>
      <ul id="faq-bar-list" class="absolute inset-x-0 top-full border-b border-zinc-200 bg-white/95 pb-3 pl-4 pr-9 backdrop-blur sm:px-0" hidden data-faq-bar-list>
        {categories.map((cat) => (
          <li>
            <a
              href={`#${cat.id}`}
              class="faq-tab block border-l-2 border-transparent py-2 pl-3 text-sm text-zinc-500 transition hover:text-zinc-800"
              data-faq-tab={cat.id}
            >
              {cat.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    {categories.map((cat) => (
      <section id={cat.id} class="faq-panel mb-14 scroll-mt-16" data-faq-panel={cat.id}>
        <h2 class="mb-5 text-xl font-semibold text-zinc-800">{cat.heading}</h2>
        {cat.note && <Fragment set:html={cat.note} />}
        <div class="divide-y divide-zinc-100 border-y border-zinc-200">
          {cat.items.map((it) => (
            <div id={it.id} class="scroll-mt-16 py-6">
              <p class="font-semibold text-zinc-800">Q. {it.q}</p>
              <Fragment set:html={it.body} />
            </div>
          ))}
        </div>
      </section>
    ))}
  </div>

