---
import { PROX_SEARCH_URL, siteNav } from "../config/nav";

const { lastUpdated } = Astro.props;
// フッターは siteNav の全項目を描画（menu フラグは無視）。
const footerGroups = siteNav;

// スマホの2列で、長い項目名が言葉の途中で切れないようにする。
// リンクの字は空白と、ここに書いた区切り（|）の位置でだけ折り返す（break-keep と <wbr>）。
// 文言は siteNav のまま。ここに書くのは区切りの位置だけ。
// 「〜フォレスト|で」は、320px で「ディープフォレストで」が1行に入らないとき、
// 名前を切らずに「で」から次の行へ送るため（入るときは「で」の後で折り返す）。
const LABEL_BREAKS = [
	"ライトの|サイト・|区画を|選ぶ",
	"ライトフォレスト|で|過ごす|一泊",
	"ディープフォレスト|で|過ごす|一泊",
	"滞在中の|方の|ポータル",
	"キャンセル|ポリシー",
	"場内マップ|（ライト）",
	"年間パスポート・|回数券",
	"よくある質問|（FAQ）",
	"運営会社・|関連組織",
	"プライバシー|ポリシー",
];
const labelBreaks = new Map(LABEL_BREAKS.map((b) => [b.replaceAll("|", ""), b.split("|")]));
// 項目名を変えたのに区切りを直し忘れたら、ビルドを止めて知らせる
const navLabels = new Set(siteNav.flatMap((group) => group.items.map((item) => item.label)));
for (const label of labelBreaks.keys()) {
	if (!navLabels.has(label)) throw new Error(`Footer: LABEL_BREAKS の「${label}」が siteNav にありません`);
}
const phrases = (label: string) => labelBreaks.get(label) ?? [label];
---

<footer class="lp-footer">
  {/* 768px 以上で右の端がタブにかかる幅だけ、右の余白を縦タブの幅のぶん広げる（floating-tab-gutter・global.css） */}
  <div class="mx-auto max-w-6xl px-4 py-14 md:floating-tab-gutter">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-6 border-b border-zinc-800 pb-8">
      <div>
        <img src="/images/logo/logo-w512.png" onerror="this.src='/logo.svg'" alt="おいらの森" width="506" height="159" loading="lazy" decoding="async" class="h-12 w-auto" style="filter: brightness(0) invert(1)" />
        <p class="mt-3 max-w-lg text-sm text-zinc-400">栃木県那須烏山の里山で、100年先の森を育てるキャンプ場</p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <a href="https://note.com/oiranomori" target="_blank" rel="noopener noreferrer" class="footer-sns">note</a>
        <a href="https://instagram.com/oiranomori" target="_blank" rel="noopener noreferrer" class="footer-sns">Instagram</a>
        <a href="https://facebook.com/oiranomori" target="_blank" rel="noopener noreferrer" class="footer-sns">Facebook</a>
        <a href="https://x.com/oiranomori" target="_blank" rel="noopener noreferrer" class="footer-sns">X</a>
        <a href="https://www.youtube.com/@Oiranomori" target="_blank" rel="noopener noreferrer" class="footer-sns">YouTube</a>
        <a href="https://line.me/R/ti/p/@oiranomori" target="_blank" rel="noopener noreferrer" class="footer-sns">LINE</a>
      </div>
    </div>

    {/* スマホは2列。PC はまとまり（5つ）を1行に並べ、列の幅は中身の長さに合わせる（項目名を折り返さないため） */}
    <div class="grid grid-cols-2 gap-6 lg:flex lg:justify-between">
      {footerGroups.map((group) => (
        <div>
          <h3 class="mb-3 text-sm font-semibold tracking-[0.16em] text-zinc-400">{group.title}</h3>
          <ul class="space-y-1.5 text-sm leading-snug">
            {group.items.map((item) => (
              <li>
                {item.active !== false ? (
                  <a href={item.href} class="footer-link break-keep wrap-break-word" target={item.external ? "_blank" : undefined} rel={item.external ? "noopener noreferrer" : undefined} data-cta={item.href === PROX_SEARCH_URL ? "reserve" : undefined} data-cta-place={item.href === PROX_SEARCH_URL ? "footer" : undefined}>
                    {phrases(item.label).map((p, i) => (<Fragment>{i > 0 && <wbr />}{p}</Fragment>))}
                  </a>
                ) : (
                  <span class="footer-link break-keep wrap-break-word pointer-events-none opacity-40">{phrases(item.label).map((p, i) => (<Fragment>{i > 0 && <wbr />}{p}</Fragment>))}</span>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-10 border-t border-zinc-800 pt-6 text-center text-xs tracking-[0.14em] text-zinc-400">
      {lastUpdated && <p class="mb-1">最終更新：{lastUpdated}</p>}
      <p>© {new Date().getFullYear()} 里山パークおいらの森 / Satoyama Park Oira no Mori. All rights reserved.</p>
    </div>
  </div>
</footer>
