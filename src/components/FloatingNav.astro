---
// 末尾スラッシュを正規化（"/" は "/" のまま、それ以外は末尾 "/" を落とす）
const normalize = (p: string) => {
  if (p === "/") return "/";
  return p.replace(/\/+$/, "");
};

const current = normalize(Astro.url.pathname);

const tabs = [
  { label: "ライト", href: "/" },
  { label: "L利用案内", href: "/light-guide/" },
  { label: "ディープ", href: "/deep/" },
  { label: "D利用案内", href: "/deep-guide/" },
  { label: "天気", href: "/now/" },
];
---

{/* 768px 以上：画面の右端の上下の真ん中に、いつも出す。
    767px 以下：ヘッダーの下に置き、スクロールに合わせて出し入れする（置き方と滑らせ方は global.css の .floating-nav、
    出し入れは src/lib/floatingReveal.ts）。本文の右の余白は広げないので、出ている間は本文に重なる。 */}
<aside class="floating-nav fixed right-0 z-50 md:top-1/2 md:block md:-translate-y-1/2" data-float-reveal>
  <div class="flex flex-col items-end gap-2">
    {tabs.map((tab) => {
      const isActive = current === normalize(tab.href);
      return (
        <a
          href={tab.href}
          class:list={[
            "floating-tab backdrop-blur transition hover:shadow-xl",
            isActive && "floating-tab--active",
          ]}
          aria-label={tab.label}
          aria-current={isActive ? "page" : undefined}
        >
          <span class="floating-tab__text">{tab.label}</span>
        </a>
      );
    })}
  </div>
</aside>

<script>
  import { initFloatingReveal } from "../lib/floatingReveal";

  initFloatingReveal();
</script>
