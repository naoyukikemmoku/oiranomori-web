---
/**
 * スクロールに合わせて写真をふわっと立ち上げるフルブリード写真枠。
 * 写真未選定の間は破線の「写真 準備中」枠を同じ寸法で出す（レイアウトを先に確定させる）。
 *
 * Props
 *   src    : 画像（未指定なら準備中枠）
 *   alt    : 代替テキスト。装飾扱いなら空文字
 *   label  : 準備中枠に添える内容メモ（例「灰捨て場」）
 *   caption: 写真下に置く短い添え書き（任意）
 *   ratio  : アスペクト比。既定 21/9
 *   tone   : "dark" | "light" 準備中枠の配色をページ地に合わせる
 */
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
	src?: ImageMetadata;
	alt?: string;
	label?: string;
	caption?: string;
	ratio?: string;
	tone?: "dark" | "light";
	class?: string;
}

const {
	src,
	alt = "",
	label,
	caption,
	ratio = "21/9",
	tone = "dark",
	class: className = "",
} = Astro.props;
---

<figure class:list={["sp-frame", className]} data-scroll-photo style={`--sp-ratio:${ratio};`}>
  {src ? (
    <Picture
      src={src}
      formats={["avif", "webp"]}
      alt={alt}
      loading="lazy"
      decoding="async"
      widths={[768, 1280, 1920]}
      sizes="100vw"
      class="sp-img"
    />
  ) : (
    <span class:list={["sp-pending", tone === "light" ? "sp-pending--light" : "sp-pending--dark"]}>
      <span class="sp-pending__text">写真 準備中{label ? `（${label}）` : ""}</span>
    </span>
  )}
  {caption && <figcaption class:list={["sp-caption", tone === "light" && "sp-caption--light"]}>{caption}</figcaption>}
</figure>

<style>
  .sp-frame {
    margin: 0;
    opacity: 0;
    transform: translateY(2.5rem);
    transition:
      opacity 1s cubic-bezier(0.22, 1, 0.36, 1),
      transform 1s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: opacity, transform;
  }

  .sp-frame.is-visible {
    opacity: 1;
    transform: none;
  }

  .sp-img {
    display: block;
    width: 100%;
    aspect-ratio: var(--sp-ratio);
    object-fit: cover;
  }

  .sp-pending {
    display: flex;
    width: 100%;
    aspect-ratio: var(--sp-ratio);
    align-items: center;
    justify-content: center;
    border: 1px dashed;
  }

  .sp-pending--dark {
    border-color: #3f463d;
    background: rgba(255, 255, 255, 0.02);
  }

  .sp-pending--light {
    border-color: #d4d4d8;
    background: #fafafa;
  }

  .sp-pending__text {
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    color: #71717a;
  }

  .sp-caption {
    margin-top: 0.75rem;
    font-size: 0.75rem;
    line-height: 1.9;
    letter-spacing: 0.04em;
    color: #a1a1aa;
  }

  .sp-caption--light {
    color: #71717a;
  }

  /* 動きを減らす設定の環境では、立ち上げ演出を行わず最初から表示する */
  @media (prefers-reduced-motion: reduce) {
    .sp-frame {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  // 同一ページ内の全 ScrollPhoto をひとつの observer で監視する。
  // 一度出したら監視を外す（戻りスクロールで再度消えないように）。
  function initScrollPhotos() {
    const frames = document.querySelectorAll<HTMLElement>("[data-scroll-photo]:not([data-sp-ready])");
    if (frames.length === 0) return;

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (reduce || !("IntersectionObserver" in window)) {
      for (const el of frames) {
        el.dataset.spReady = "1";
        el.classList.add("is-visible");
      }
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      },
      { rootMargin: "0px 0px -12% 0px", threshold: 0.12 },
    );

    for (const el of frames) {
      el.dataset.spReady = "1";
      observer.observe(el);
    }
  }

  initScrollPhotos();
  document.addEventListener("astro:page-load", initScrollPhotos);
</script>
