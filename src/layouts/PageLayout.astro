---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import FloatingNav from "../components/FloatingNav.astro";
import ReserveCTA from "../components/ReserveCTA.astro";

const { title = "おいらの森", description, heading = "", noindex = false, ogImage, ogType, lastUpdated } = Astro.props;
---

<BaseLayout title={title} description={description} noindex={noindex} ogImage={ogImage} ogType={ogType} lastUpdated={lastUpdated}><Fragment slot="head"><slot name="head" /></Fragment>
  <Header />
  <FloatingNav />
  <ReserveCTA />

  {/* 右余白は縦タブ（FloatingNav）の逃げ。スマホで本文が隠れないようにする。 */}
  <main class="mx-auto max-w-6xl px-4 pr-9 pb-10 pt-[calc(var(--header-offset)+1.25rem)] sm:pr-4">
    {heading && <h1 class="mb-6">{heading}</h1>}
    <slot />
  </main>
</BaseLayout>
